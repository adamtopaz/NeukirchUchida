          (RingOfIntegers E) (f.coeff 0) := by
        rw [← hf]
        change Polynomial.aeval gO f = _
        calc
          Polynomial.aeval gO f =
              Polynomial.aeval gO
                (Polynomial.X * Polynomial.divX f + Polynomial.C (f.coeff 0)) :=
            congr_arg (fun Q => Polynomial.aeval gO Q)
              (Polynomial.X_mul_divX_add f).symm
          _ = _ := by
            rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
      have hgz : gO * z ∈ LocalMaximalIdeal E :=
        (LocalMaximalIdeal E).mul_mem_right z hgmax
      have hcmax : algebraMap (RingOfIntegers K) (RingOfIntegers E)
          (f.coeff 0) ∈ LocalMaximalIdeal E := by
        have heq : algebraMap (RingOfIntegers K) (RingOfIntegers E) (f.coeff 0) =
            y - gO * z := by rw [hydecomp]; ring
        rw [heq]
        exact (LocalMaximalIdeal E).sub_mem hy hgz
      have hcbase : f.coeff 0 ∈ LocalMaximalIdeal K :=
        (Valuation.HasExtension.algebraMap_mem_maximalIdeal_iff
          (ValuativeRel.valuation K) (ValuativeRel.valuation E)).mp hcmax
      have hpc : uniformizerInteger K π ∣ f.coeff 0 := by
        rw [← Ideal.mem_span_singleton, torsion_maximalIdeal_eq_span K π]
        exact hcbase
      have hgc : gO ∣ algebraMap (RingOfIntegers K)
          (RingOfIntegers E) (f.coeff 0) := by
        obtain ⟨c, hc⟩ := hpc
        rw [hc, map_mul]
        exact dvd_mul_of_dvd_left hp_dvd_g _
      rw [Ideal.mem_span_singleton]
      rw [hydecomp]
      exact dvd_add (dvd_mul_right gO z) hgc
  have hg0 : g ≠ 0 := by
    intro hg
    have hα0 : α = 0 := congr_arg Subtype.val hg
    have hprim := (hP.2.2 α).mp hα
    apply hprim.2
    rw [hα0, Polynomial.IsRoot.def, ← Polynomial.coeff_zero_eq_eval_zero,
      Polynomial.coeff_map, lubinTateIterate_coeff_zero K π (m - 1), map_zero]
  let gu : Units E := Units.mk0 g hg0
  have nval_invE (x : Units E) :
      normalizedValuation E x⁻¹ = -normalizedValuation E x := by
    simp [normalizedValuation]
  have ringUnitVal (u : Units (RingOfIntegers E)) :
      normalizedValuation E (Units.map (algebraMap (RingOfIntegers E) E) u) = 0 := by
    have hnonneg : 0 ≤ normalizedValuation E
        (Units.map (algebraMap (RingOfIntegers E) E) u) :=
      (exists_normalizedValuationHom E).choose_spec.2 _ |>.2 ⟨u, rfl⟩
    have hinvnonneg : 0 ≤ normalizedValuation E
        (Units.map (algebraMap (RingOfIntegers E) E) u)⁻¹ :=
      (exists_normalizedValuationHom E).choose_spec.2 _ |>.2
        ⟨(u⁻¹ : Units (RingOfIntegers E)), rfl⟩
    rw [nval_invE] at hinvnonneg
    omega
  have isUnit_nval_zero (a : RingOfIntegers E) (ha : (a : E) ≠ 0)
      (hval : normalizedValuation E (Units.mk0 (a : E) ha) = 0) : IsUnit a := by
    let x : Units E := Units.mk0 (a : E) ha
    have hxinv : normalizedValuation E x⁻¹ = 0 := by
      rw [nval_invE, hval, neg_zero]
    obtain ⟨b, hb⟩ := (exists_normalizedValuationHom E).choose_spec.2 x⁻¹ |>.1 hxinv.ge
    let u : Units (RingOfIntegers E) :=
      { val := a
        inv := b
        val_inv := by
          apply Subtype.ext
          change (a : E) * (b : E) = 1
          rw [hb]
          exact mul_inv_cancel₀ ha
        inv_val := by
          apply Subtype.ext
          change (b : E) * (a : E) = 1
          rw [hb]
          exact inv_mul_cancel₀ ha }
    exact ⟨u, rfl⟩
  have hb_nonneg : 0 ≤ normalizedValuation E (defaultUniformizer E).val := by
    rw [(defaultUniformizer E).valuation_eq_one]
    omega
  obtain ⟨bO, hbOval⟩ := (exists_normalizedValuationHom E).choose_spec.2
    (defaultUniformizer E).val |>.1 hb_nonneg
  have hbmax : bO ∈ LocalMaximalIdeal E := by
    rw [IsLocalRing.mem_maximalIdeal]
    intro hbunit
    obtain ⟨u, hu⟩ := hbunit
    have hv := ringUnitVal u
    have hueq : Units.map (algebraMap (RingOfIntegers E) E) u =
        (defaultUniformizer E).val := by
      apply Units.ext
      change ((u : RingOfIntegers E) : E) = ((defaultUniformizer E).val : E)
      rw [hu, hbOval]
    rw [hueq, (defaultUniformizer E).valuation_eq_one] at hv
    omega
  have hbspan : bO ∈ Ideal.span ({gO} : Set (RingOfIntegers E)) := by
    rw [hmax]
    exact hbmax
  obtain ⟨cO, hcO⟩ := Ideal.mem_span_singleton.mp hbspan
  have hb0 : (bO : E) ≠ 0 := by
    rw [hbOval]
    exact (defaultUniformizer E).val.ne_zero
  have hc0 : (cO : E) ≠ 0 := by
    intro hc
    apply hb0
    rw [hcO]
    simp [hc]
  let cu : Units E := Units.mk0 (cO : E) hc0
  have hbunits : (defaultUniformizer E).val = gu * cu := by
    apply Units.ext
    change ((defaultUniformizer E).val : E) = g * (cO : E)
    calc
      ((defaultUniformizer E).val : E) = (bO : E) := hbOval.symm
      _ = (gO : E) * (cO : E) := congr_arg (fun z : RingOfIntegers E => (z : E)) hcO
      _ = g * (cO : E) := by rw [hgOval]
  have hgv_nonneg : 0 ≤ normalizedValuation E gu :=
    (exists_normalizedValuationHom E).choose_spec.2 gu |>.2 ⟨gO, hgOval⟩
  have hcv_nonneg : 0 ≤ normalizedValuation E cu :=
    (exists_normalizedValuationHom E).choose_spec.2 cu |>.2 ⟨cO, rfl⟩
  have hgv_ne : normalizedValuation E gu ≠ 0 := by
    intro hz
    have hgu : Units.mk0 (gO : E) (by simpa [hgOval]) = gu := by
      apply Units.ext
      exact hgOval
    have hunit : IsUnit gO := isUnit_nval_zero gO (by simpa [hgOval]) (by rw [hgu]; exact hz)
    exact (IsLocalRing.mem_maximalIdeal gO).mp hgmax hunit
  have hgval : normalizedValuation E gu = 1 := by
    have hv := congr_arg (normalizedValuation E) hbunits
    rw [(defaultUniformizer E).valuation_eq_one, normalizedValuation_mul] at hv
    omega
  have integer_of_norm_le (x : E) (hx : ‖x‖ ≤ 1) :
      ∃ y : RingOfIntegers E, (y : E) = x := by
    have hxv : vE x ≤ vE 1 := by
      change ‖x‖₊ ≤ ‖(1 : E)‖₊
      exact NNReal.coe_le_coe.mp (by simpa using hx)
    have hxrel : x ≤ᵥ (1 : E) :=
      (Valuation.Compatible.vle_iff_le (v := vE) x 1).mpr hxv
    exact ⟨⟨x, (Valuation.Compatible.vle_iff_le
      (v := ValuativeRel.valuation E) x 1).mp hxrel⟩, rfl⟩
  have hgnormpow : ‖g‖ ^ P.natDegree =
      ‖((uniformizerInteger K π : RingOfIntegers K) : K)‖ := by
    rw [hgnorm_formula, one_div]
    exact Real.rpow_inv_natCast_pow (norm_nonneg _)
      (Nat.ne_of_gt hdpos)
  let pu : Units E := Units.map (algebraMap K E) π.val
  have hpunorm : ‖(pu : E)‖ =
      ‖((uniformizerInteger K π : RingOfIntegers K) : K)‖ := by
    change ‖algebraMap K E (π.val : K)‖ = _
    rw [show ‖algebraMap K E (π.val : K)‖ = ‖(π.val : K)‖ from
      spectralNorm_extends (K := K) (L := E) (π.val : K)]
    congr 1
    exact (uniformizer_integer_exists K π).choose_spec.symm
  let zu : Units E := gu ^ P.natDegree * pu⁻¹
  have hpunorm0 : ‖(pu : E)‖ ≠ 0 := norm_ne_zero_iff.mpr pu.ne_zero
  have hpbasenorm0 : ‖((uniformizerInteger K π : RingOfIntegers K) : K)‖ ≠ 0 := by
    rw [← hpunorm]
    exact hpunorm0
  have hznorm : ‖(zu : E)‖ = 1 := by
    rw [show (zu : E) = (gu : E) ^ P.natDegree * (pu : E)⁻¹ by simp [zu],
      norm_mul, norm_pow, norm_inv, hpunorm, show (gu : E) = g from rfl,
      hgnormpow, inv_eq_one_div]
    rw [one_div, mul_inv_cancel₀ hpbasenorm0]
  obtain ⟨zO, hzOval⟩ := integer_of_norm_le (zu : E) (by rw [hznorm])
  obtain ⟨zinvO, hzinvOval⟩ := integer_of_norm_le ((zu : E)⁻¹) (by
    rw [norm_inv, hznorm, inv_one])
  let zU : Units (RingOfIntegers E) :=
    { val := zO
      inv := zinvO
      val_inv := by
        apply Subtype.ext
        change (zO : E) * (zinvO : E) = 1
        rw [hzOval, hzinvOval]
        exact mul_inv_cancel₀ zu.ne_zero
      inv_val := by
        apply Subtype.ext
        change (zinvO : E) * (zO : E) = 1
        rw [hzOval, hzinvOval]
        exact inv_mul_cancel₀ zu.ne_zero }
  have hzU : Units.map (algebraMap (RingOfIntegers E) E) zU = zu := by
    apply Units.ext
    exact hzOval
  have hzval : normalizedValuation E zu = 0 := by
    rw [← hzU]
    exact ringUnitVal zU
  have hpval : normalizedValuation E pu = ramificationIndex K E := by
    change normalizedValuation E (Units.map (algebraMap K E) π.val) = _
    rw [normalizedValuation_algebraMap K E, π.valuation_eq_one, mul_one]
  have hram : ramificationIndex K E = Module.finrank K E := by
    have hzcalc : (P.natDegree : ℤ) * normalizedValuation E gu -
        normalizedValuation E pu = 0 := by
      simpa [zu, normalizedValuation, sub_eq_add_neg] using hzval
    rw [hgval, mul_one, hpval] at hzcalc
    have hPd : P.natDegree = Module.finrank K E := by
      rw [hdegree, hP.2.1]
    omega
  have hres : residueDegree K E = 1 := by
    have hfr := finrank_eq_ramificationIndex_mul_residueDegree K E
    rw [hram] at hfr
    have hpos : 0 < Module.finrank K E := Module.finrank_pos
    nlinarith
  obtain ⟨ev, hev⟩ : ∃ ev : PowerSeries (RingOfIntegers K) →+* E,
      ∀ f, ev f = ∑' n : ℕ,
        algebraMap (RingOfIntegers K) E (PowerSeries.coeff n f) * g ^ n := by
    letI : WithIdeal (RingOfIntegers K) := ⟨LocalMaximalIdeal K⟩
    letI : TopologicalSpace (RingOfIntegers K) := (LocalMaximalIdeal K).adicTopology
    letI : UniformSpace (RingOfIntegers K) := IsTopologicalAddGroup.rightUniformSpace _
    letI : IsUniformAddGroup (RingOfIntegers K) := isUniformAddGroup_of_addCommGroup
    letI : WithIdeal (RingOfIntegers E) := ⟨LocalMaximalIdeal E⟩
    letI : TopologicalSpace (RingOfIntegers E) := (LocalMaximalIdeal E).adicTopology
    letI : UniformSpace (RingOfIntegers E) := IsTopologicalAddGroup.rightUniformSpace _
    letI : IsUniformAddGroup (RingOfIntegers E) := isUniformAddGroup_of_addCommGroup
    letI : IsLinearTopology (RingOfIntegers E) (RingOfIntegers E) :=
      (LocalMaximalIdeal E).isLinearTopology
    have hadicE : IsAdic (LocalMaximalIdeal E) := rfl
    have hcomplete := hadicE.isAdicComplete_iff.mp
      (inferInstance : IsAdicComplete (LocalMaximalIdeal E) (RingOfIntegers E))
    letI : CompleteSpace (RingOfIntegers E) := hcomplete.1
    letI : T2Space (RingOfIntegers E) := hcomplete.2
    have hmapIdeal : Ideal.map intMap (LocalMaximalIdeal K) ≤ LocalMaximalIdeal E := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact (Valuation.HasExtension.algebraMap_mem_maximalIdeal_iff
        (ValuativeRel.valuation K) (ValuativeRel.valuation E)).mpr hx
    have hcmap : Continuous intMap :=
      (WithIdeal.uniformContinuous_of_map_le hmapIdeal).continuous
    have hgAdic : PowerSeries.HasEval gO :=
      WithIdeal.isTopologicallyNilpotent_of_mem hgmax
    let incl : RingOfIntegers E →+* E := algebraMap (RingOfIntegers E) E
    have hcincl : Continuous incl := by
      apply continuous_of_continuousAt_zero incl
      rw [ContinuousAt, map_zero]
      rw [(Ideal.hasBasis_nhds_zero_adic (LocalMaximalIdeal E)).tendsto_iff
        Metric.nhds_basis_ball]
      intro ε hε
      obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hε hgnorm
      refine ⟨n, trivial, ?_⟩
      intro x hx
      have hxspan : x ∈ Ideal.span ({gO ^ n} : Set (RingOfIntegers E)) := by
        rw [← Ideal.span_singleton_pow, hmax]
        exact hx
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hxspan
      have hcnorm : ‖(c : E)‖ ≤ 1 := by
        have hcrel : ((c : E) ≤ᵥ (1 : E)) :=
          (Valuation.Compatible.vle_iff_le
            (v := ValuativeRel.valuation E) (c : E) 1).mpr c.prop
        have hcv : vE (c : E) ≤ vE 1 :=
          (Valuation.Compatible.vle_iff_le (v := vE) (c : E) 1).mp hcrel
        have hcnn : ‖(c : E)‖₊ ≤ 1 := by simpa [vE] using hcv
        exact NNReal.coe_le_coe.mpr hcnn
      rw [Metric.mem_ball, dist_zero_right]
      change ‖(x : E)‖ < ε
      rw [hc]
      calc
        ‖((gO ^ n * c : RingOfIntegers E) : E)‖ = ‖g‖ ^ n * ‖(c : E)‖ := by
          change ‖(gO : E) ^ n * (c : E)‖ = _
          rw [norm_mul, norm_pow, hgOval]
        _ ≤ ‖g‖ ^ n := mul_le_of_le_one_right (pow_nonneg (norm_nonneg g) n) hcnorm
        _ < ε := hn
    let evO : PowerSeries (RingOfIntegers K) →+* RingOfIntegers E :=
      PowerSeries.eval₂Hom hcmap hgAdic
    let ev : PowerSeries (RingOfIntegers K) →+* E := incl.comp evO
    refine ⟨ev, fun f => ?_⟩
    have hs := PowerSeries.hasSum_eval₂ hcmap hgAdic f
    have hsE := hs.map incl hcincl
    have hsE' : HasSum (fun n : ℕ =>
        algebraMap (RingOfIntegers K) E (PowerSeries.coeff n f) * g ^ n) (ev f) := by
      change HasSum (fun n : ℕ =>
        algebraMap (RingOfIntegers K) E (PowerSeries.coeff n f) * g ^ n)
          (incl (evO f))
      rw [PowerSeries.coe_eval₂Hom]
      convert hsE using 1
      funext n
      change algebraMap (RingOfIntegers K) E (PowerSeries.coeff n f) * g ^ n =
        algebraMap (RingOfIntegers E) E
          (algebraMap (RingOfIntegers K) (RingOfIntegers E) (PowerSeries.coeff n f)) *
            (algebraMap (RingOfIntegers E) E gO) ^ n
      rw [IsScalarTower.algebraMap_apply (RingOfIntegers K) (RingOfIntegers E) E,
        show algebraMap (RingOfIntegers E) E gO = g from hgOval]
    exact hsE'.tsum_eq.symm
  let lfd : LubinTateLocalFieldData K Ksep E :=
    { valuativeRel := vrE
      topology := topE
      localField := hlocal
      valuativeExtension := hve
      continuousSMul := hcsmul }
  refine ⟨{
    field := E
    finiteDimensional := ‹FiniteDimensional K E›
    generator := g
    field_eq_adjoin := ?_
    isRoot := hα
    localFieldData := lfd
    generatorUnit := gu
    generatorUnit_val := rfl
    generator_valuation := hgval
    generator_hasEval := hgEval
    integralGenerator := gO
    integralGenerator_val := hgOval
    integerAlgebraMap := intMap
    integerAlgebraMap_apply := fun _ => rfl
    ringOfIntegers_eq_adjoin := hring
    integral_polynomial_coordinates := hcoords
    degree := hdegree
    totallyRamified := hram
    residueDegree_eq_one := hres
    evaluation := ev
    evaluation_apply := hev }, ?_⟩
  · rfl
  · rfl

private theorem torsion_residueCard_sub_one_ne_zero :
    ((residueCard K - 1 : ℕ) : RingOfIntegers K) ≠ 0 := by
  intro h
  letI := Fintype.ofFinite (LocalResidueField K)
  have hmap := congr_arg (IsLocalRing.residue (RingOfIntegers K)) h
  have hqpos : 0 < residueCard K := Nat.card_pos
  have hone : 1 ≤ residueCard K := hqpos
  have hmap' : ((residueCard K - 1 : ℕ) : LocalResidueField K) = 0 := by
    simpa using hmap
  rw [Nat.cast_sub hone] at hmap'
  have hcard : (residueCard K : LocalResidueField K) = 0 := by
    change (Nat.card (LocalResidueField K) : LocalResidueField K) = 0
    rw [Nat.card_eq_fintype_card]
    exact Nat.cast_card_eq_zero (LocalResidueField K)
  rw [hcard, zero_sub] at hmap'
  have : (-1 : LocalResidueField K) = 0 := by simpa using hmap'
  exact one_ne_zero (neg_eq_zero.mp this)

private theorem lubinTatePolynomial_derivative_eval_zero (π : Uniformizer K) :
    (lubinTatePolynomial K π).derivative.eval 0 = uniformizerInteger K π := by
  simp only [lubinTatePolynomial, Polynomial.derivative_add, Polynomial.derivative_mul,
    Polynomial.derivative_C, Polynomial.derivative_X, zero_mul, zero_add, mul_one]
  rw [Polynomial.derivative_X_pow, Polynomial.eval_add, Polynomial.eval_C,
    Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
    zero_pow (Nat.sub_ne_zero_of_lt (torsion_one_lt_residueCard K))]
  simp

private theorem lubinTateIterate_derivative_eval_zero (π : Uniformizer K) (n : ℕ) :
    (lubinTateIterate K π n).derivative.eval 0 =
      (uniformizerInteger K π) ^ n := by
  induction n with
  | zero => simp [lubinTateIterate]
  | succ n ih =>
      rw [lubinTateIterate, Polynomial.derivative_comp, Polynomial.eval_mul,
        Polynomial.eval_comp, lubinTateIterate_eval_zero K π n, ih,
        lubinTatePolynomial_derivative_eval_zero K π]
      exact (pow_succ _ _).symm

private theorem lubinTateIterate_derivative_ne_zero (π : Uniformizer K) (n : ℕ) :
    (lubinTateIterate K π n).derivative ≠ 0 := by
  intro h
  have := congr_arg (Polynomial.eval 0) h
  rw [lubinTateIterate_derivative_eval_zero K π n] at this
  simp only [Polynomial.eval_zero] at this
  exact pow_ne_zero n (by
    intro hp
    apply π.val.ne_zero
    rw [← (uniformizer_integer_exists K π).choose_spec]
    exact congr_arg (fun x : RingOfIntegers K => (x : K)) hp) this

private theorem primitiveDivisionPolynomial_derivative_ne_zero (π : Uniformizer K) (m : ℕ) :
    (primitiveDivisionPolynomial K π m).derivative ≠ 0 := by
  rw [primitiveDivisionPolynomial, Polynomial.derivative_add, Polynomial.derivative_C,
    zero_add, Polynomial.derivative_pow]
  exact mul_ne_zero
    (mul_ne_zero (Polynomial.C_ne_zero.mpr (torsion_residueCard_sub_one_ne_zero K))
      (pow_ne_zero _ (fun h => lubinTateIterate_derivative_ne_zero K π (m - 1)
        (congr_arg Polynomial.derivative h))))
    (lubinTateIterate_derivative_ne_zero K π (m - 1))

private theorem lubinTateIterate_comp_lubinTatePolynomial (π : Uniformizer K) (n : ℕ) :
    (lubinTateIterate K π n).comp (lubinTatePolynomial K π) =
      (lubinTatePolynomial K π).comp (lubinTateIterate K π n) := by
  induction n with
  | zero => simp [lubinTateIterate]
  | succ n ih =>
      simp only [lubinTateIterate]
      rw [Polynomial.comp_assoc, ih]

private theorem primitiveDivisionPolynomial_comp_lubinTatePolynomial (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    (primitiveDivisionPolynomial K π m).comp (lubinTatePolynomial K π) =
      primitiveDivisionPolynomial K π (m + 1) := by
  rw [primitiveDivisionPolynomial, Polynomial.add_comp, Polynomial.C_comp,
    Polynomial.pow_comp, lubinTateIterate_comp_lubinTatePolynomial K π (m - 1),
    ← lubinTateIterate]
  rw [primitiveDivisionPolynomial]
  congr 2
  exact congrArg (lubinTateIterate K π) (by omega)

private theorem primitiveDivisionPolynomial_separable (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    ((primitiveDivisionPolynomial K π m).map
      (algebraMap (RingOfIntegers K) Ksep)).Separable := by
  let P := primitiveDivisionPolynomial K π m
  have hPmonic : P.Monic :=
    (primitiveDivisionPolynomial_monic_natDegree K π m hm).1
  have hPirr : Irreducible P :=
    (primitiveDivisionPolynomial_eisenstein K Ksep π m hm).1.irreducible
      (IsLocalRing.maximalIdeal.isMaximal _).isPrime hPmonic.isPrimitive
      (by
        rw [(primitiveDivisionPolynomial_eisenstein K Ksep π m hm).2.1]
        exact mul_pos (Nat.sub_pos_of_lt (torsion_one_lt_residueCard K))
          (pow_pos (Nat.zero_lt_one.trans (torsion_one_lt_residueCard K)) _))
  let PK := P.map (algebraMap (RingOfIntegers K) K)
  have hPKirr : Irreducible PK :=
    hPmonic.irreducible_iff_irreducible_map_fraction_map.mp hPirr
  have hPKderiv : PK.derivative ≠ 0 := by
    dsimp only [PK, P]
    rw [Polynomial.derivative_map, ne_eq,
      Polynomial.map_eq_zero_iff (IsFractionRing.injective (RingOfIntegers K) K)]
    exact primitiveDivisionPolynomial_derivative_ne_zero K π m
  have hPKsep : PK.Separable :=
    (Polynomial.separable_iff_derivative_ne_zero hPKirr).mpr hPKderiv
  rw [show (primitiveDivisionPolynomial K π m).map
      (algebraMap (RingOfIntegers K) Ksep) =
      PK.map (algebraMap K Ksep) by
        dsimp only [PK, P]
        rw [Polynomial.map_map, IsScalarTower.algebraMap_eq
          (RingOfIntegers K) K Ksep]]
  exact hPKsep.map

private theorem exists_compatible_primitiveDivision_root (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (x : Ksep)
    (hx : ((primitiveDivisionPolynomial K π m).map
      (algebraMap (RingOfIntegers K) Ksep)).IsRoot x) :
    ∃ y : Ksep,
      ((primitiveDivisionPolynomial K π (m + 1)).map
        (algebraMap (RingOfIntegers K) Ksep)).IsRoot y ∧
      ((lubinTatePolynomial K π).map
        (algebraMap (RingOfIntegers K) Ksep)).eval y = x := by
  let φ := algebraMap (RingOfIntegers K) Ksep
  let Q := (primitiveDivisionPolynomial K π m).map φ
  let F := (lubinTatePolynomial K π).map φ
  have hxdiv : Polynomial.X - Polynomial.C x ∣ Q := by
    have h := Polynomial.X_sub_C_dvd_sub_C_eval (p := Q) (a := x)
    rw [Polynomial.IsRoot.def.mp hx, Polynomial.C_0, sub_zero] at h
    exact h
  obtain ⟨r, hr⟩ := hxdiv
  have hcomp : Q.comp F =
      (Polynomial.X - Polynomial.C x).comp F * r.comp F := by
    rw [hr, Polynomial.mul_comp]
  have hleft : Q.comp F =
      (primitiveDivisionPolynomial K π (m + 1)).map φ := by
    dsimp only [Q, F]
    rw [← Polynomial.map_comp, primitiveDivisionPolynomial_comp_lubinTatePolynomial K π m hm]
  have hright : (Polynomial.X - Polynomial.C x).comp F = F - Polynomial.C x := by
    simp
  have hdiv : F - Polynomial.C x ∣
      (primitiveDivisionPolynomial K π (m + 1)).map φ := by
    refine ⟨r.comp F, ?_⟩
    rw [← hleft, hcomp, hright]
  have hsep : (F - Polynomial.C x).Separable :=
    (primitiveDivisionPolynomial_separable K Ksep π (m + 1) (Nat.succ_pos m)).of_dvd hdiv
  have hFmonic : F.Monic := (lubinTatePolynomial_monic_natDegree K π).1.map φ
  have hFdegree : F.degree = (residueCard K : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hFmonic.ne_zero,
      Polynomial.Monic.natDegree_map (lubinTatePolynomial_monic_natDegree K π).1,
      (lubinTatePolynomial_monic_natDegree K π).2]
  have hdeglt : (Polynomial.C x).degree < F.degree := by
    rw [hFdegree]
    exact Polynomial.degree_C_le.trans_lt (WithBot.coe_lt_coe.mpr
      (Nat.zero_lt_one.trans (torsion_one_lt_residueCard K)))
  have hpdeg : (F - Polynomial.C x).degree ≠ 0 := by
    rw [Polynomial.degree_sub_eq_left_of_degree_lt hdeglt, hFdegree]
    exact_mod_cast (Nat.zero_lt_one.trans (torsion_one_lt_residueCard K)).ne'
  letI : IsSepClosed Ksep := IsSepClosure.sep_closed K
  obtain ⟨y, hy⟩ := IsSepClosed.exists_root (F - Polynomial.C x) hpdeg hsep
  refine ⟨y, hy.dvd hdiv, ?_⟩
  rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, sub_eq_zero] at hy
  exact hy

/--
**L02**, Lemma `lem:lt-eisenstein`: compatible primitive roots generate a tower of totally
ramified local fields, are uniformizers, and integrally generate every ring of integers.
-/
theorem lubinTateTower_exists (π : Uniformizer K) :
    Nonempty (LubinTateTower K Ksep π) := by
  let φ := algebraMap (RingOfIntegers K) Ksep
  let A : ℕ → Type v := fun n =>
    {x : Ksep // ((primitiveDivisionPolynomial K π (n + 1)).map φ).IsRoot x}
  letI : IsSepClosed Ksep := IsSepClosure.sep_closed K
  have hQ1monic : ((primitiveDivisionPolynomial K π 1).map φ).Monic :=
    (primitiveDivisionPolynomial_monic_natDegree K π 1 (by omega)).1.map φ
  have hQ1deg : ((primitiveDivisionPolynomial K π 1).map φ).degree ≠ 0 := by
    rw [Polynomial.degree_eq_natDegree hQ1monic.ne_zero,
      Polynomial.Monic.natDegree_map (primitiveDivisionPolynomial_monic_natDegree K π 1 (by omega)).1,
      (primitiveDivisionPolynomial_eisenstein K Ksep π 1 (by omega)).2.1]
    norm_num
    exact_mod_cast (Nat.sub_pos_of_lt (torsion_one_lt_residueCard K)).ne'
  obtain ⟨x0, hx0⟩ := IsSepClosed.exists_root
    ((primitiveDivisionPolynomial K π 1).map φ) hQ1deg
      (primitiveDivisionPolynomial_separable K Ksep π 1 (by omega))
  let a0 : A 0 := ⟨x0, hx0⟩
  let next : ∀ n : ℕ, A n → A (n + 1) := fun n x =>
    ⟨(exists_compatible_primitiveDivision_root K Ksep π (n + 1) (by omega) x x.prop).choose,
      (exists_compatible_primitiveDivision_root K Ksep π (n + 1) (by omega) x x.prop).choose_spec.1⟩
  have hnext (n : ℕ) (x : A n) :
      ((lubinTatePolynomial K π).map φ).eval (next n x : Ksep) = (x : Ksep) :=
    (exists_compatible_primitiveDivision_root K Ksep π (n + 1) (by omega) x x.prop).choose_spec.2
  let a : ∀ n : ℕ, A n := fun n => Nat.rec a0 (fun n x => next n x) n
  let b : ℕ → Ksep := fun n => (a n).1
  have hacompat (n : ℕ) :
      ((lubinTatePolynomial K π).map φ).eval (b (n + 1)) = b n := by
    change ((lubinTatePolynomial K π).map φ).eval (next n (a n)).1 = (a n).1
    exact hnext n (a n)
  have haroot (m : ℕ) (hm : 1 ≤ m) :
      ((primitiveDivisionPolynomial K π m).map φ).IsRoot (b (m - 1)) := by
    change ((primitiveDivisionPolynomial K π m).map φ).IsRoot (a (m - 1)).1
    simpa only [Nat.sub_add_cancel hm] using (a (m - 1)).prop
  let L : ∀ (m : ℕ), 1 ≤ m → LubinTateLevel K Ksep π m := fun m hm =>
    (lubinTateLevel_exists_of_root K Ksep π m hm (b (m - 1)) (haroot m hm)).choose
  have hLgen (m : ℕ) (hm : 1 ≤ m) :
      ((((L m hm).generator : (L m hm).field) : Ksep)) = b (m - 1) :=
    (lubinTateLevel_exists_of_root K Ksep π m hm (b (m - 1)) (haroot m hm)).choose_spec
  have hfield (m : ℕ) (hm : 1 ≤ m) :
      (L m hm).field ≤ (L (m + 1) (Nat.succ_pos m)).field := by
    rw [(L m hm).field_eq_adjoin, IntermediateField.adjoin_le_iff]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst z
    rw [hLgen m hm]
    rw [← hacompat (m - 1)]
    let S := (L (m + 1) (Nat.succ_pos m)).field
    let y : S := (L (m + 1) (Nat.succ_pos m)).generator
    let c : RingOfIntegers K →+* S :=
      (algebraMap K S).comp (algebraMap (RingOfIntegers K) K)
    let zS : S := Polynomial.eval₂ c y (lubinTatePolynomial K π)
    have hzS : (zS : Ksep) ∈ S := zS.prop
    suffices (zS : Ksep) =
        ((lubinTatePolynomial K π).map φ).eval (b m) by
      rw [Nat.sub_add_cancel hm]
      rwa [this] at hzS
    rw [show b m =
      (((L (m + 1) (Nat.succ_pos m)).generator :
        (L (m + 1) (Nat.succ_pos m)).field) : Ksep) by
          rw [hLgen (m + 1) (Nat.succ_pos m)]
          congr 2 <;> omega]
    change algebraMap S Ksep (Polynomial.eval₂ c y (lubinTatePolynomial K π)) = _
    rw [Polynomial.hom_eval₂, Polynomial.eval_map]
    congr 1
  refine ⟨{
    level := L
    field_le := hfield
    generator_compatible := ?_ }⟩
  intro m hm
  rw [hLgen (m + 1) (Nat.succ_pos m), hLgen m hm]
  cases m with
  | zero => omega
  | succ n =>
      simpa only [Nat.succ_eq_add_one,
        show n + 1 + 1 - 1 = n + 1 by omega,
        show n + 1 - 1 = n by omega] using hacompat n

/-- The chosen compatible Lubin--Tate tower. -/
noncomputable def lubinTateTower (π : Uniformizer K) : LubinTateTower K Ksep π :=
  (lubinTateTower_exists K Ksep π).some

/-- The chosen level, obtained from the one compatible tower rather than chosen independently. -/
noncomputable def lubinTateLevel (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    LubinTateLevel K Ksep π m :=
  (lubinTateTower K Ksep π).level m hm

/-- Reduction `(𝒪_K/𝔪^(m+1))ˣ → (𝒪_K/𝔪^m)ˣ`. -/
def lubinTateUnitReduction (m : ℕ) :
    Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ (m + 1)) →*
      Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) :=
  Units.map (Ideal.Quotient.factor
    (show LocalMaximalIdeal K ^ (m + 1) ≤ LocalMaximalIdeal K ^ m from
      Ideal.pow_le_pow_right (Nat.le_succ m))).toMonoidHom

/-- L03 data: actual Galois actions and their actual restriction maps on the L02 tower. -/
structure LubinTateGaloisData (π : Uniformizer K) (T : LubinTateTower K Ksep π) where
  /-- Every positive level is Galois over `K`. -/
  isGalois : ∀ (m : ℕ) (hm : 1 ≤ m), IsGalois K (T.level m hm).field
  /-- Its automorphism group is commutative. -/
  commutative : ∀ (m : ℕ) (hm : 1 ≤ m)
    (σ τ : ((T.level m hm).field ≃ₐ[K] (T.level m hm).field)), σ * τ = τ * σ
  /-- The residue-unit/Galois equivalence at every positive level. -/
  galoisEquiv : ∀ (m : ℕ) (hm : 1 ≤ m),
    Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) ≃*
      ((T.level m hm).field ≃ₐ[K] (T.level m hm).field)
  /-- Every residue unit has an integral-unit representative. -/
  unitReduction_surjective : ∀ (m : ℕ) (_hm : 1 ≤ m),
    Function.Surjective (integralUnitReduction K m)
  /-- The equivalence sends `u mod 𝔪^m` to `α_m ↦ [u](α_m)`. -/
  action_generator : ∀ (m : ℕ) (hm : 1 ≤ m) (u : Units (RingOfIntegers K)),
    (galoisEquiv m hm (integralUnitReduction K m u))
        (T.level m hm).generator =
      (T.level m hm).evaluation
        ((lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K))
  /-- The conjugates of `α_m` are exactly all primitive level-`m` division points. -/
  conjugates_eq_primitive : ∀ (m : ℕ) (hm : 1 ≤ m),
    Set.range (fun σ : ((T.level m hm).field ≃ₐ[K] (T.level m hm).field) =>
      (((σ (T.level m hm).generator : (T.level m hm).field)) : Ksep)) =
        {x : Ksep | IsPrimitiveLubinTateDivisionPoint K Ksep π m x}
  /-- Actual restriction of automorphisms along the displayed consecutive inclusion. -/
  restriction : ∀ (m : ℕ) (hm : 1 ≤ m),
    ((T.level (m + 1) (Nat.succ_pos m)).field ≃ₐ[K]
      (T.level (m + 1) (Nat.succ_pos m)).field) →*
        ((T.level m hm).field ≃ₐ[K] (T.level m hm).field)
  /-- Restriction is characterized pointwise by the inclusion into the next field. -/
  restriction_apply : ∀ (m : ℕ) (hm : 1 ≤ m)
      (σ : ((T.level (m + 1) (Nat.succ_pos m)).field ≃ₐ[K]
        (T.level (m + 1) (Nat.succ_pos m)).field)) (x : (T.level m hm).field),
    IntermediateField.inclusion (T.field_le m hm)
        ((restriction m hm σ) x) =
      σ (IntermediateField.inclusion (T.field_le m hm) x)
  /-- Under the chosen equivalences, actual restriction is reduction modulo `𝔪^m`. -/
  transition : ∀ (m : ℕ) (hm : 1 ≤ m)
      (u : Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ (m + 1))),
    restriction m hm (galoisEquiv (m + 1) (Nat.succ_pos m) u) =
      galoisEquiv m hm (lubinTateUnitReduction K m u)

private theorem lubinTateLevel_minpoly
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    minpoly K L.generator =
      (primitiveDivisionPolynomial K π m).map
        (algebraMap (RingOfIntegers K) K) := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  let P := primitiveDivisionPolynomial K π m
  let PK := P.map (algebraMap (RingOfIntegers K) K)
  have hPmonic : P.Monic :=
    (primitiveDivisionPolynomial_monic_natDegree K π m hm).1
  have hPirr : Irreducible P :=
    (primitiveDivisionPolynomial_eisenstein K Ksep π m hm).1.irreducible
      (IsLocalRing.maximalIdeal.isMaximal _).isPrime hPmonic.isPrimitive
      (by
        rw [(primitiveDivisionPolynomial_eisenstein K Ksep π m hm).2.1]
        exact mul_pos (Nat.sub_pos_of_lt (torsion_one_lt_residueCard K))
          (pow_pos (Nat.zero_lt_one.trans (torsion_one_lt_residueCard K)) _))
  have hPKmonic : PK.Monic := hPmonic.map _
  have hPKirr : Irreducible PK :=
    hPmonic.irreducible_iff_irreducible_map_fraction_map.mp hPirr
  have hroot_sep : (PK.map (algebraMap K Ksep)).IsRoot
      ((L.generator : L.field) : Ksep) := by
    dsimp only [PK, P]
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq
      (RingOfIntegers K) K Ksep]
    exact L.isRoot
  have hroot : Polynomial.aeval L.generator PK = 0 := by
    apply (algebraMap L.field Ksep).injective
    rw [map_zero, Polynomial.aeval_def, Polynomial.hom_eval₂,
      ← IsScalarTower.algebraMap_eq K L.field Ksep]
    simpa [Polynomial.eval_map] using hroot_sep
  exact (minpoly.eq_of_irreducible_of_monic hPKirr hroot hPKmonic).symm

private noncomputable def lubinTateLevelPowerBasis
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) : PowerBasis K L.field := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  have hint : IsIntegral K L.generator := IsIntegral.of_finite K L.generator
  have hfield : IntermediateField.adjoin K {L.generator} = ⊤ := by
    apply IntermediateField.lift_injective L.field
    rw [IntermediateField.lift_adjoin_simple, IntermediateField.lift_top]
    exact L.field_eq_adjoin.symm
  exact PowerBasis.ofAdjoinEqTop hint
    ((IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic hint.isAlgebraic).mp hfield)

private theorem formalGroup_sub_X_dvd
    {R : Type*} [CommRing R] (F : FormalGroup R) :
    (MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) R) ∣
      F.toPowerSeries - MvPowerSeries.X 0 := by
  rw [MvPowerSeries.X_dvd_iff]
  intro d hd
  let n := d 0
  have deq : d = Finsupp.single 0 n := by
    ext i
    fin_cases i
    · simp [n]
    · simpa [n] using hd
  rw [deq]
  have h := congrArg (PowerSeries.coeff n)
    (FormalGroup.add_zero F
      (PowerSeries.HasSubst.X' : PowerSeries.HasSubst (PowerSeries.X : PowerSeries R)))
  rw [map_sub]
  change MvPowerSeries.coeff (Finsupp.single () n)
      (F.toPowerSeries.subst ![PowerSeries.X, 0]) =
    PowerSeries.coeff n PowerSeries.X at h
  rw [MvPowerSeries.coeff_subst] at h
  · simp only [PowerSeries.coeff, Finsupp.prod_pow, smul_eq_mul] at h
    rw [finsum_eq_single _ (Finsupp.single 0 n)] at h
    · simp at h
      rw [sub_eq_zero, h]
      by_cases hn : n = 1
      · simp [PowerSeries.coeff_X, MvPowerSeries.coeff_X, hn]
      · have hs : Finsupp.single (0 : Fin 2) n ≠ Finsupp.single 0 1 := by
          intro hs
          apply hn
          simpa using congrArg (fun e : Fin 2 →₀ ℕ => e 0) hs
        simp [PowerSeries.coeff_X, MvPowerSeries.coeff_X, hn, hs]
    · intro e he
      by_cases he1 : e 1 = 0
      · by_cases he0 : e 0 = n
        · exfalso
          apply he
          ext i
          fin_cases i
          · simpa using he0
          · simpa using he1
        · simp [he1]
          intro hn
          exact (he0 hn.symm).elim
      · simp [he1]
  · exact MvPowerSeries.HasSubst.X_zero

private theorem formalGroup_sub_X_factor
    {R : Type*} [CommRing R] (F : FormalGroup R) :
    ∃ Q : MvPowerSeries (Fin 2) R,
      F.toPowerSeries - MvPowerSeries.X 0 = MvPowerSeries.X 1 * Q ∧
      MvPowerSeries.constantCoeff Q = 1 := by
  obtain ⟨Q, hQ⟩ := formalGroup_sub_X_dvd F
  refine ⟨Q, hQ, ?_⟩
  let e := Finsupp.single (1 : Fin 2) 1
  have hneq : e ≠ Finsupp.single 0 1 := by
    intro h
    have := congrArg (fun d : Fin 2 →₀ ℕ => d 0) h
    simpa [e] using this
  have hleft : MvPowerSeries.coeff e
      (F.toPowerSeries - MvPowerSeries.X 0) = 1 := by
    rw [map_sub, F.lin_coeff_Y, MvPowerSeries.coeff_X, if_neg hneq, sub_zero]
  have hright : MvPowerSeries.coeff e (MvPowerSeries.X 1 * Q) =
      MvPowerSeries.constantCoeff Q := by
    rw [MvPowerSeries.coeff_mul, Finset.sum_eq_single (e, 0)]
    · simp [e, MvPowerSeries.coeff_X]
    · rintro ⟨i, j⟩ hij hne
      have hij' : i + j = e :=
        Finset.HasAntidiagonal.mem_antidiagonal.mp hij
      rw [MvPowerSeries.coeff_X]
      split_ifs with hi
      · change i = Finsupp.single 1 1 at hi
        subst i
        exfalso
        apply hne
        apply Prod.ext
        · rfl
        · apply add_left_cancel (a := e)
          simpa [e] using hij'
      · exact zero_mul _
    · simp [e]
  calc
    MvPowerSeries.constantCoeff Q =
        MvPowerSeries.coeff e (MvPowerSeries.X 1 * Q) := hright.symm
    _ = MvPowerSeries.coeff e (F.toPowerSeries - MvPowerSeries.X 0) :=
      congrArg (MvPowerSeries.coeff e) hQ.symm
    _ = 1 := hleft

private theorem mvPowerSeries_constantCoeff_subst_of_zero
    {R : Type*} [CommRing R] (Q : MvPowerSeries (Fin 2) R)
    (a : Fin 2 → PowerSeries R)
    (ha : ∀ i, PowerSeries.constantCoeff (a i) = 0) :
    MvPowerSeries.constantCoeff (Q.subst a) = MvPowerSeries.constantCoeff Q := by
  have hs : MvPowerSeries.HasSubst a :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero ha
  rw [MvPowerSeries.constantCoeff_subst hs]
  rw [finsum_eq_single _ 0]
  · simp [MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
  · intro d hd
    obtain ⟨i, hi⟩ : d.support.Nonempty := d.support_nonempty_iff.mpr hd
    have hai : MvPowerSeries.constantCoeff (a i) = 0 := ha i
    rw [Finsupp.prod, map_prod, ← Finset.prod_erase_mul _ _ hi,
      map_pow (MvPowerSeries.constantCoeff : PowerSeries R →+* R), hai]
    simp [d.mem_support_iff.mp hi]

private theorem lubinTateEndomorphism_add_sub_factor
    (π : Uniformizer K) (a b : RingOfIntegers K) :
    ∃ U : PowerSeries (RingOfIntegers K),
      (lubinTateFormalModule K π).endomorphism (a + b) -
          (lubinTateFormalModule K π).endomorphism a =
        (lubinTateFormalModule K π).endomorphism b * U ∧ IsUnit U := by
  let G := lubinTateFormalModule K π
  obtain ⟨Q, hQ, hQ0⟩ := formalGroup_sub_X_factor G.formalGroup
  let v : Fin 2 → PowerSeries (RingOfIntegers K) :=
    ![G.endomorphism a, G.endomorphism b]
  have hv0 : ∀ i, PowerSeries.constantCoeff (v i) = 0 := by
    intro i
    fin_cases i <;> simp [v, G.constantCoeff]
  have hv : MvPowerSeries.HasSubst v :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero hv0
  let U : PowerSeries (RingOfIntegers K) := Q.subst v
  refine ⟨U, ?_, ?_⟩
  · rw [G.map_add]
    calc
      G.formalGroup.toPowerSeries.subst v - G.endomorphism a =
          (G.formalGroup.toPowerSeries - MvPowerSeries.X 0).subst v := by
            rw [MvPowerSeries.subst_sub hv, MvPowerSeries.subst_X hv]
            rfl
      _ = (MvPowerSeries.X 1 * Q).subst v := congrArg (MvPowerSeries.subst v) hQ
      _ = G.endomorphism b * U := by
        rw [MvPowerSeries.subst_mul hv, MvPowerSeries.subst_X hv]
        rfl
  · rw [PowerSeries.isUnit_iff_constantCoeff]
    change IsUnit (MvPowerSeries.constantCoeff (Q.subst v))
    rw [mvPowerSeries_constantCoeff_subst_of_zero Q v hv0, hQ0]
    exact isUnit_one

private theorem lubinTateLevel_evaluation_add_eq_iff
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (a b : RingOfIntegers K) :
    L.evaluation ((lubinTateFormalModule K π).endomorphism (a + b)) =
        L.evaluation ((lubinTateFormalModule K π).endomorphism a) ↔
      L.evaluation ((lubinTateFormalModule K π).endomorphism b) = 0 := by
  obtain ⟨U, hU, hUunit⟩ := lubinTateEndomorphism_add_sub_factor K π a b
  have hEvalU : IsUnit (L.evaluation U) := hUunit.map L.evaluation
  constructor
  · intro h
    have hz : L.evaluation
        ((lubinTateFormalModule K π).endomorphism (a + b) -
          (lubinTateFormalModule K π).endomorphism a) = 0 := by
      rw [map_sub, h, sub_self]
    rw [hU, map_mul] at hz
    exact (mul_eq_zero.mp hz).resolve_right hEvalU.ne_zero
  · intro h
    rw [← sub_eq_zero, ← map_sub, hU, map_mul, h, zero_mul]

private theorem ringHom_subst_eq_zero
    {R E : Type*} [CommRing R] [Field E]
    (ε : PowerSeries R →+* E) (f g : PowerSeries R)
    (hf : PowerSeries.constantCoeff f = 0)
    (hg : PowerSeries.constantCoeff g = 0) (heval : ε g = 0) :
    ε (PowerSeries.subst g f) = 0 := by
  obtain ⟨q, hq⟩ := PowerSeries.X_dvd_iff.mpr hf
  have hgsub : PowerSeries.HasSubst g :=
    PowerSeries.HasSubst.of_constantCoeff_zero hg
  rw [hq, PowerSeries.subst_mul hgsub, PowerSeries.subst_X hgsub, map_mul, heval,
    zero_mul]

private theorem powerSeries_coe_comp
    {R : Type*} [CommRing R] (p s : Polynomial R) (hs0 : s.eval 0 = 0) :
    ((p.comp s : Polynomial R) : PowerSeries R) =
      PowerSeries.subst (s : PowerSeries R) (p : PowerSeries R) := by
  have hs : PowerSeries.HasSubst (s : PowerSeries R) := by
    apply PowerSeries.HasSubst.of_constantCoeff_zero
    change s.coeff 0 = 0
    rwa [Polynomial.coeff_zero_eq_eval_zero]
  rw [PowerSeries.subst_coe hs]
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
      rw [Polynomial.add_comp]
      change Polynomial.coeToPowerSeries.ringHom (p.comp s) = _ at hp
      change Polynomial.coeToPowerSeries.ringHom (q.comp s) = _ at hq
      change Polynomial.coeToPowerSeries.ringHom (p.comp s + q.comp s) = _
      rw [map_add, hp, hq, map_add]
  | monomial n a =>
      rw [Polynomial.monomial_comp]
      change Polynomial.coeToPowerSeries.ringHom (Polynomial.C a * s ^ n) = _
      rw [map_mul, map_pow]
      simp [Polynomial.aeval_def]

private theorem lubinTateIterate_toPowerSeries_succ
    (π : Uniformizer K) (n : ℕ) :
    ((lubinTateIterate K π (n + 1) : Polynomial (RingOfIntegers K)) :
      PowerSeries (RingOfIntegers K)) =
      PowerSeries.subst
        ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
          PowerSeries (RingOfIntegers K)) (lubinTateSeries K π) := by
  rw [lubinTateIterate, lubinTateSeries]
  exact powerSeries_coe_comp _ _ (lubinTateIterate_eval_zero K π n)

private theorem lubinTateEndomorphism_uniformizer_pow
    (π : Uniformizer K) (n : ℕ) :
    (lubinTateFormalModule K π).endomorphism ((uniformizerInteger K π) ^ n) =
      ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
        PowerSeries (RingOfIntegers K)) := by
  induction n with
  | zero =>
      rw [pow_zero, (lubinTateFormalModule K π).one_action]
      simp [lubinTateIterate]
  | succ n ih =>
      rw [pow_succ', (lubinTateFormalModule K π).map_mul,
        (lubinTateFormalModule K π).uniformizer_action, ih,
        ← lubinTateIterate_toPowerSeries_succ K π n]

private theorem lubinTateEndomorphism_commutes_iterate
    (π : Uniformizer K) (a : RingOfIntegers K) (n : ℕ) :
    PowerSeries.subst ((lubinTateFormalModule K π).endomorphism a)
        ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
          PowerSeries (RingOfIntegers K)) =
      PowerSeries.subst
        ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
          PowerSeries (RingOfIntegers K))
        ((lubinTateFormalModule K π).endomorphism a) := by
  let G := lubinTateFormalModule K π
  let e := G.endomorphism a
  have he0 : PowerSeries.constantCoeff e = 0 := G.constantCoeff a
  have he : PowerSeries.HasSubst e := PowerSeries.HasSubst.of_constantCoeff_zero he0
  have hf0 : PowerSeries.constantCoeff (lubinTateSeries K π) = 0 := by
    change (lubinTatePolynomial K π).coeff 0 = 0
    have hq : 0 ≠ residueCard K := Nat.card_pos.ne'.symm
    simp [lubinTatePolynomial, hq]
  have hf : PowerSeries.HasSubst (lubinTateSeries K π) :=
    PowerSeries.HasSubst.of_constantCoeff_zero hf0
  induction n with
  | zero =>
      rw [lubinTateIterate, Polynomial.coe_X]
      change PowerSeries.subst e
          (PowerSeries.X : PowerSeries (RingOfIntegers K)) =
        PowerSeries.subst (PowerSeries.X : PowerSeries (RingOfIntegers K)) e
      rw [PowerSeries.subst_X he, PowerSeries.X_subst]
  | succ n ih =>
      let t : PowerSeries (RingOfIntegers K) :=
        ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) : PowerSeries _)
      have ht0 : PowerSeries.constantCoeff t = 0 := by
        change (lubinTateIterate K π n).coeff 0 = 0
        rw [Polynomial.coeff_zero_eq_eval_zero]
        exact lubinTateIterate_eval_zero K π n
      have ht : PowerSeries.HasSubst t := PowerSeries.HasSubst.of_constantCoeff_zero ht0
      rw [lubinTateIterate_toPowerSeries_succ K π n]
      calc
        PowerSeries.subst e (PowerSeries.subst t (lubinTateSeries K π)) =
            PowerSeries.subst (PowerSeries.subst e t) (lubinTateSeries K π) :=
          PowerSeries.subst_comp_subst_apply ht he _
        _ = PowerSeries.subst (PowerSeries.subst t e) (lubinTateSeries K π) := by
          rw [ih]
        _ = PowerSeries.subst t (PowerSeries.subst e (lubinTateSeries K π)) := by
          rw [PowerSeries.subst_comp_subst_apply he ht]
        _ = PowerSeries.subst t (PowerSeries.subst (lubinTateSeries K π) e) := by
          rw [G.functional a]
        _ = PowerSeries.subst (PowerSeries.subst t (lubinTateSeries K π)) e := by
          rw [PowerSeries.subst_comp_subst_apply hf ht]

private theorem lubinTateLevel_evaluation_C
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (r : RingOfIntegers K) :
    L.evaluation (PowerSeries.C r) = algebraMap (RingOfIntegers K) L.field r := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  letI : ValuativeRel L.field := L.localFieldData.valuativeRel
  letI : TopologicalSpace L.field := L.localFieldData.topology
  rw [L.evaluation_apply, tsum_eq_single 0]
  · simp [PowerSeries.coeff_C]
  · intro n hn
    simp [PowerSeries.coeff_C, hn]

private theorem lubinTateLevel_evaluation_subst_polynomial
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (p : Polynomial (RingOfIntegers K))
    (g : PowerSeries (RingOfIntegers K)) (hg : PowerSeries.constantCoeff g = 0) :
    L.evaluation (PowerSeries.subst g (p : PowerSeries (RingOfIntegers K))) =
      p.eval₂ (algebraMap (RingOfIntegers K) L.field) (L.evaluation g) := by
  have hcomp : L.evaluation.comp
      (algebraMap (RingOfIntegers K) (PowerSeries (RingOfIntegers K))) =
      algebraMap (RingOfIntegers K) L.field := by
    apply RingHom.ext
    intro r
    exact lubinTateLevel_evaluation_C K Ksep π m hm L r
  have hsub : PowerSeries.HasSubst g := PowerSeries.HasSubst.of_constantCoeff_zero hg
  rw [PowerSeries.subst_coe hsub, Polynomial.aeval_def, Polynomial.hom_eval₂, hcomp]

private theorem lubinTateLevel_evaluation_X
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    L.evaluation PowerSeries.X = L.generator := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  letI : ValuativeRel L.field := L.localFieldData.valuativeRel
  letI : TopologicalSpace L.field := L.localFieldData.topology
  rw [L.evaluation_apply, tsum_eq_single 1]
  · simp [PowerSeries.coeff_X]
  · intro n hn
    simp [PowerSeries.coeff_X, hn]

private theorem lubinTateLevel_evaluation_polynomial
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (p : Polynomial (RingOfIntegers K)) :
    L.evaluation (p : PowerSeries (RingOfIntegers K)) =
      p.eval₂ (algebraMap (RingOfIntegers K) L.field) L.generator := by
  have h := lubinTateLevel_evaluation_subst_polynomial K Ksep π m hm L p
    PowerSeries.X (by simp)
  rw [PowerSeries.X_subst, lubinTateLevel_evaluation_X K Ksep π m hm L] at h
  exact h

private theorem lubinTateIterate_toPowerSeries_constantCoeff
    (π : Uniformizer K) (n : ℕ) :
    PowerSeries.constantCoeff
      ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
        PowerSeries (RingOfIntegers K)) = 0 := by
  change (lubinTateIterate K π n).coeff 0 = 0
  rw [Polynomial.coeff_zero_eq_eval_zero]
  exact lubinTateIterate_eval_zero K π n

private theorem lubinTateLevel_generator_iterate_values
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    L.evaluation
        ((lubinTateIterate K π m : Polynomial (RingOfIntegers K)) :
          PowerSeries (RingOfIntegers K)) = 0 ∧
      L.evaluation
        ((lubinTateIterate K π (m - 1) : Polynomial (RingOfIntegers K)) :
          PowerSeries (RingOfIntegers K)) ≠ 0 := by
  have hprim := (primitiveDivisionPolynomial_isRoot_iff K Ksep π m hm
    (((L.generator : L.field) : Ksep))).mp L.isRoot
  have ambient_eval (n : ℕ) :
      algebraMap L.field Ksep
          (L.evaluation
            ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
              PowerSeries (RingOfIntegers K))) =
        ((lubinTateIterate K π n).map
          (algebraMap (RingOfIntegers K) Ksep)).eval
            (((L.generator : L.field) : Ksep)) := by
    rw [lubinTateLevel_evaluation_polynomial K Ksep π m hm L,
      Polynomial.hom_eval₂]
    simp only [Polynomial.eval_map]
    congr 2
  constructor
  · apply (algebraMap L.field Ksep).injective
    rw [map_zero, ambient_eval]
    exact hprim.1
  · intro h
    apply hprim.2
    rw [Polynomial.IsRoot.def, ← ambient_eval, h, map_zero]

set_option maxHeartbeats 1000000 in
private theorem lubinTateUnitEndomorphism_preserves_primitive
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K)) :
    IsPrimitiveLubinTateDivisionPoint K Ksep π m
      (((L.evaluation
        ((lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K)) :
          L.field)) : Ksep) := by
  let G := lubinTateFormalModule K π
  let eu := G.endomorphism (u : RingOfIntegers K)
  let ei := G.endomorphism ((u⁻¹ : Units (RingOfIntegers K)) : RingOfIntegers K)
  have heu0 : PowerSeries.constantCoeff eu = 0 := G.constantCoeff u
  have hei0 : PowerSeries.constantCoeff ei = 0 := G.constantCoeff (u⁻¹ : Units _)
  have hbase := lubinTateLevel_generator_iterate_values K Ksep π m hm L
  have action_iterate (n : ℕ) :
      (lubinTateIterate K π n).eval₂
          (algebraMap (RingOfIntegers K) L.field) (L.evaluation eu) =
        L.evaluation (PowerSeries.subst eu
          ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
            PowerSeries (RingOfIntegers K))) := by
    exact (lubinTateLevel_evaluation_subst_polynomial K Ksep π m hm L
      (lubinTateIterate K π n) eu heu0).symm
  have hyzero : (lubinTateIterate K π m).eval₂
      (algebraMap (RingOfIntegers K) L.field) (L.evaluation eu) = 0 := by
    let Hm : PowerSeries (RingOfIntegers K) :=
      ((lubinTateIterate K π m : Polynomial (RingOfIntegers K)) : PowerSeries _)
    rw [action_iterate, lubinTateEndomorphism_commutes_iterate K π u m]
    exact ringHom_subst_eq_zero (ε := L.evaluation) (f := eu) (g := Hm)
      heu0 (lubinTateIterate_toPowerSeries_constantCoeff K π m) hbase.1
  have hynotzero : (lubinTateIterate K π (m - 1)).eval₂
      (algebraMap (RingOfIntegers K) L.field) (L.evaluation eu) ≠ 0 := by
    intro hy
    let H : PowerSeries (RingOfIntegers K) :=
      ((lubinTateIterate K π (m - 1) : Polynomial (RingOfIntegers K)) : PowerSeries _)
    let z : PowerSeries (RingOfIntegers K) := PowerSeries.subst H eu
    have hH0 : PowerSeries.constantCoeff H = 0 :=
      lubinTateIterate_toPowerSeries_constantCoeff K π (m - 1)
    have hz0 : L.evaluation z = 0 := by
      change L.evaluation (PowerSeries.subst H eu) = 0
      rw [show PowerSeries.subst H eu = PowerSeries.subst eu H by
        exact (lubinTateEndomorphism_commutes_iterate K π u (m - 1)).symm,
        ← action_iterate]
      exact hy
    have hzconst : PowerSeries.constantCoeff z = 0 := by
      exact PowerSeries.constantCoeff_subst_eq_zero hH0 eu heu0
    have hcancel : PowerSeries.subst z ei = H := by
      have heu : PowerSeries.HasSubst eu :=
        PowerSeries.HasSubst.of_constantCoeff_zero heu0
      have hH : PowerSeries.HasSubst H :=
        PowerSeries.HasSubst.of_constantCoeff_zero hH0
      calc
        PowerSeries.subst z ei = PowerSeries.subst H (PowerSeries.subst eu ei) := by
          exact (PowerSeries.subst_comp_subst_apply heu hH ei).symm
        _ = PowerSeries.subst H (G.endomorphism
            (((u⁻¹ : Units (RingOfIntegers K)) : RingOfIntegers K) * u)) := by
          rw [G.map_mul]
        _ = PowerSeries.subst H PowerSeries.X := by
          rw [show ((u⁻¹ : Units (RingOfIntegers K)) : RingOfIntegers K) * u = 1 by simp,
            G.one_action]
        _ = H := PowerSeries.subst_X hH
    have hzcancel := ringHom_subst_eq_zero L.evaluation ei z hei0 hzconst hz0
    rw [hcancel] at hzcancel
    exact hbase.2 hzcancel
  refine ⟨?_, ?_⟩
  · rw [Polynomial.IsRoot.def]
    have h := congrArg (algebraMap L.field Ksep) hyzero
    rw [map_zero, Polynomial.hom_eval₂] at h
    simpa [Polynomial.eval_map, IsScalarTower.algebraMap_eq
      (RingOfIntegers K) L.field Ksep] using h
  · intro hroot
    apply hynotzero
    apply (algebraMap L.field Ksep).injective
    rw [map_zero, Polynomial.hom_eval₂]
    simpa [Polynomial.IsRoot.def, Polynomial.eval_map,
      IsScalarTower.algebraMap_eq (RingOfIntegers K) L.field Ksep] using hroot

private theorem lubinTateLevel_iterate_zero_mono
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) {r n : ℕ} (hrn : r ≤ n)
    (hr : L.evaluation
      ((lubinTateIterate K π r : Polynomial (RingOfIntegers K)) :
        PowerSeries (RingOfIntegers K)) = 0) :
    L.evaluation
      ((lubinTateIterate K π n : Polynomial (RingOfIntegers K)) :
        PowerSeries (RingOfIntegers K)) = 0 := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hrn
  induction d with
  | zero => simpa
  | succ d ih =>
      rw [show r + (d + 1) = (r + d) + 1 by omega,
        lubinTateIterate_toPowerSeries_succ K π (r + d)]
      have hf0 : PowerSeries.constantCoeff (lubinTateSeries K π) = 0 := by
        change (lubinTatePolynomial K π).coeff 0 = 0
        have hq : 0 ≠ residueCard K := Nat.card_pos.ne'.symm
        simp [lubinTatePolynomial, hq]
      exact ringHom_subst_eq_zero L.evaluation (lubinTateSeries K π)
        (((lubinTateIterate K π (r + d) : Polynomial (RingOfIntegers K)) :
          PowerSeries (RingOfIntegers K))) hf0
        (lubinTateIterate_toPowerSeries_constantCoeff K π (r + d))
        (ih (Nat.le_add_right r d))

set_option maxHeartbeats 600000 in
private theorem lubinTateLevel_endomorphism_eq_zero_iff
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (a : RingOfIntegers K) :
    L.evaluation ((lubinTateFormalModule K π).endomorphism a) = 0 ↔
      a ∈ LocalMaximalIdeal K ^ m := by
  let G := lubinTateFormalModule K π
  let p := uniformizerInteger K π
  have hbase := lubinTateLevel_generator_iterate_values K Ksep π m hm L
  constructor
  · intro haeval
    by_cases ha0 : a = 0
    · rw [ha0]
      exact (LocalMaximalIdeal K ^ m).zero_mem
    obtain ⟨r, u, ha⟩ :=
      IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0
        (torsion_uniformizerInteger_irreducible K π)
    let ei := G.endomorphism ((u⁻¹ : Units (RingOfIntegers K)) : RingOfIntegers K)
    have hei0 : PowerSeries.constantCoeff ei = 0 := G.constantCoeff (u⁻¹ : Units _)
    have heao : PowerSeries.constantCoeff (G.endomorphism a) = 0 := G.constantCoeff a
    have hcancel := ringHom_subst_eq_zero L.evaluation ei (G.endomorphism a)
      hei0 heao haeval
    rw [← G.map_mul] at hcancel
    have hpowzero : L.evaluation (G.endomorphism (p ^ r)) = 0 := by
      simpa [ha, p] using hcancel
    rw [lubinTateEndomorphism_uniformizer_pow K π r] at hpowzero
    have hmr : m ≤ r := by
      by_contra h
      have hrle : r ≤ m - 1 := by omega
      have hzprev := lubinTateLevel_iterate_zero_mono K Ksep π m hm L hrle hpowzero
      exact hbase.2 hzprev
    rw [← torsion_maximalIdeal_eq_span K π, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton]
    refine ⟨(u : RingOfIntegers K) * p ^ (r - m), ?_⟩
    rw [ha]
    dsimp [p]
    have hpoweq : uniformizerInteger K π ^ r =
        uniformizerInteger K π ^ m * uniformizerInteger K π ^ (r - m) := by
      rw [← pow_add, Nat.add_sub_of_le hmr]
    rw [hpoweq]
    ring
  · intro ha
    rw [← torsion_maximalIdeal_eq_span K π, Ideal.span_singleton_pow,
      Ideal.mem_span_singleton] at ha
    obtain ⟨c, hc⟩ := ha
    have hpzero : L.evaluation (G.endomorphism (p ^ m)) = 0 := by
      rw [lubinTateEndomorphism_uniformizer_pow K π m]
      exact hbase.1
    have hc0 : PowerSeries.constantCoeff (G.endomorphism c) = 0 := G.constantCoeff c
    have hp0 : PowerSeries.constantCoeff (G.endomorphism (p ^ m)) = 0 :=
      G.constantCoeff _
    have hz := ringHom_subst_eq_zero L.evaluation (G.endomorphism c)
      (G.endomorphism (p ^ m)) hc0 hp0 hpzero
    rw [← G.map_mul] at hz
    simpa [hc, mul_comm, p] using hz

private theorem lubinTateLevel_evaluation_primitivePolynomial
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    L.evaluation (primitiveDivisionPolynomial K π m :
      PowerSeries (RingOfIntegers K)) = 0 := by
  rw [lubinTateLevel_evaluation_polynomial K Ksep π m hm L]
  apply (algebraMap L.field Ksep).injective
  rw [map_zero, Polynomial.hom_eval₂]
  simpa [Polynomial.IsRoot.def, Polynomial.eval_map,
    IsScalarTower.algebraMap_eq (RingOfIntegers K) L.field Ksep] using L.isRoot

set_option maxHeartbeats 600000 in
private theorem lubinTateLevel_evaluation_ker
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (h : PowerSeries (RingOfIntegers K)) :
    L.evaluation h = 0 ↔
      (primitiveDivisionPolynomial K π m : PowerSeries (RingOfIntegers K)) ∣ h := by
  let R := RingOfIntegers K
  let I := LocalMaximalIdeal K
  let P := primitiveDivisionPolynomial K π m
  have hmonic : P.Monic := (primitiveDivisionPolynomial_monic_natDegree K π m hm).1
  have hdist : P.IsDistinguishedAt I :=
    { toIsWeaklyEisensteinAt :=
        (primitiveDivisionPolynomial_eisenstein K Ksep π m hm).1.isWeaklyEisensteinAt
      monic := hmonic }
  letI : UniformSpace K := IsTopologicalAddGroup.rightUniformSpace K
  letI : IsUniformAddGroup K := isUniformAddGroup_of_addCommGroup
  letI : IsAdicComplete I R := by
    dsimp [I, R]
    infer_instance
  let H := hdist.isWeierstrassDivisorAt'
  have horder : ((P : PowerSeries R).map (Ideal.Quotient.mk I)).order.toNat =
      P.natDegree := by
    have h' := hdist.coe_natDegree_eq_order_map
      (P : PowerSeries R) (1 : PowerSeries R)
      (by
        rw [PowerSeries.constantCoeff_one]
        exact (Ideal.ne_top_iff_one I).mp
          (IsLocalRing.maximalIdeal.isMaximal (R := R)).ne_top)
      (by simp)
    simpa using congrArg ENat.toNat h'.symm
  have hPzero := lubinTateLevel_evaluation_primitivePolynomial K Ksep π m hm L
  constructor
  · intro hh
    let D := H.isWeierstrassDivisionAt_div_mod h
    have hrzero : L.evaluation (H.mod h : PowerSeries R) = 0 := by
      have heq := congrArg L.evaluation D.eq_mul_add
      rw [map_add, map_mul, hPzero, zero_mul, zero_add, hh] at heq
      exact heq.symm
    let r := H.mod h
    let rK := r.map (algebraMap R K)
    have hrroot : Polynomial.aeval L.generator rK = 0 := by
      rw [Polynomial.aeval_def]
      have hev := lubinTateLevel_evaluation_polynomial K Ksep π m hm L r
      rw [hrzero] at hev
      dsimp only [rK]
      rw [Polynomial.eval₂_map,
        ← IsScalarTower.algebraMap_eq R K L.field]
      exact hev.symm
    have hdvd : minpoly K L.generator ∣ rK := minpoly.dvd K L.generator hrroot
    have hrzeroPoly : r = 0 := by
      by_contra hr0
      have hrK0 : rK ≠ 0 := by
        intro hk
        apply hr0
        exact (Polynomial.map_eq_zero_iff
          (FaithfulSMul.algebraMap_injective R K)).mp hk
      have hd : r.degree < (P.natDegree : WithBot ℕ) := by
        have hd' := D.degree_lt
        rw [horder] at hd'
        exact hd'
      have hlt : r.natDegree < P.natDegree :=
        (Polynomial.natDegree_lt_iff_degree_lt hr0).mpr hd
      have hle := Polynomial.natDegree_le_of_dvd hdvd hrK0
      rw [lubinTateLevel_minpoly K Ksep π m hm L,
        Polynomial.Monic.natDegree_map hmonic] at hle
      change P.natDegree ≤ (r.map (algebraMap R K)).natDegree at hle
      rw [Polynomial.natDegree_map_eq_of_injective
        (FaithfulSMul.algebraMap_injective R K) r] at hle
      exact (not_lt_of_ge hle) hlt
    refine ⟨H.div h, ?_⟩
    have heq := D.eq_mul_add
    rw [show H.mod h = 0 from hrzeroPoly] at heq
    simpa using heq
  · rintro ⟨q, rfl⟩
    rw [map_mul, hPzero, zero_mul]

private theorem lubinTateLevel_kernel_stable_unit
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K))
    (h : PowerSeries (RingOfIntegers K)) (hh : L.evaluation h = 0) :
    L.evaluation (PowerSeries.subst
      ((lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K)) h) = 0 := by
  let P := primitiveDivisionPolynomial K π m
  let eu := (lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K)
  have heu0 : PowerSeries.constantCoeff eu = 0 :=
    (lubinTateFormalModule K π).constantCoeff u
  have hPsubzero : L.evaluation (PowerSeries.subst eu
      (P : PowerSeries (RingOfIntegers K))) = 0 := by
    rw [lubinTateLevel_evaluation_subst_polynomial K Ksep π m hm L P eu heu0]
    have hprim := lubinTateUnitEndomorphism_preserves_primitive K Ksep π m hm L u
    have hroot := (primitiveDivisionPolynomial_isRoot_iff K Ksep π m hm
      (((L.evaluation eu : L.field)) : Ksep)).mpr hprim
    apply (algebraMap L.field Ksep).injective
    rw [map_zero, Polynomial.hom_eval₂]
    simpa [Polynomial.IsRoot.def, Polynomial.eval_map,
      IsScalarTower.algebraMap_eq (RingOfIntegers K) L.field Ksep] using hroot
  have hPsubdvd := (lubinTateLevel_evaluation_ker K Ksep π m hm L _).mp hPsubzero
  obtain ⟨q, hq⟩ := (lubinTateLevel_evaluation_ker K Ksep π m hm L h).mp hh
  have heu : PowerSeries.HasSubst eu := PowerSeries.HasSubst.of_constantCoeff_zero heu0
  apply (lubinTateLevel_evaluation_ker K Ksep π m hm L _).mpr
  rw [hq, PowerSeries.subst_mul heu]
  exact dvd_mul_of_dvd_left hPsubdvd _

private theorem lubinTateUnitEndomorphism_isRoot_level
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K)) :
    (primitiveDivisionPolynomial K π m).eval₂
        (algebraMap (RingOfIntegers K) L.field)
        (L.evaluation ((lubinTateFormalModule K π).endomorphism
          (u : RingOfIntegers K))) = 0 := by
  let eu := (lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K)
  have hprim := lubinTateUnitEndomorphism_preserves_primitive K Ksep π m hm L u
  have hroot := (primitiveDivisionPolynomial_isRoot_iff K Ksep π m hm
    (((L.evaluation eu : L.field)) : Ksep)).mpr hprim
  apply (algebraMap L.field Ksep).injective
  rw [map_zero, Polynomial.hom_eval₂]
  simpa [Polynomial.IsRoot.def, Polynomial.eval_map,
    IsScalarTower.algebraMap_eq (RingOfIntegers K) L.field Ksep] using hroot

private theorem lubinTateLevelPowerBasis_gen
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    (lubinTateLevelPowerBasis K Ksep π m hm L).gen = L.generator := by
  simp [lubinTateLevelPowerBasis]

private noncomputable def lubinTateRootAlgEquiv
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (y : L.field)
    (hy : (primitiveDivisionPolynomial K π m).eval₂
      (algebraMap (RingOfIntegers K) L.field) y = 0) :
    L.field ≃ₐ[K] L.field := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  let pb := lubinTateLevelPowerBasis K Ksep π m hm L
  have hymin : Polynomial.aeval y (minpoly K pb.gen) = 0 := by
    rw [show pb.gen = L.generator from
        lubinTateLevelPowerBasis_gen K Ksep π m hm L,
      lubinTateLevel_minpoly K Ksep π m hm L, Polynomial.aeval_def,
      Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq
        (RingOfIntegers K) K L.field]
    exact hy
  let f : L.field →ₐ[K] L.field := pb.lift y hymin
  exact AlgEquiv.ofBijective f f.bijective

private theorem lubinTateRootAlgEquiv_generator
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (y : L.field)
    (hy : (primitiveDivisionPolynomial K π m).eval₂
      (algebraMap (RingOfIntegers K) L.field) y = 0) :
    lubinTateRootAlgEquiv K Ksep π m hm L y hy L.generator = y := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  rw [← lubinTateLevelPowerBasis_gen K Ksep π m hm L]
  simp [lubinTateRootAlgEquiv]

private theorem lubinTateRootAlgEquiv_polynomial
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (y : L.field)
    (hy : (primitiveDivisionPolynomial K π m).eval₂
      (algebraMap (RingOfIntegers K) L.field) y = 0)
    (p : Polynomial (RingOfIntegers K)) :
    lubinTateRootAlgEquiv K Ksep π m hm L y hy
        (p.eval₂ (algebraMap (RingOfIntegers K) L.field) L.generator) =
      p.eval₂ (algebraMap (RingOfIntegers K) L.field) y := by
  let σ := lubinTateRootAlgEquiv K Ksep π m hm L y hy
  calc
    σ (p.eval₂ (algebraMap (RingOfIntegers K) L.field) L.generator) =
        p.eval₂ (σ.toRingHom.comp (algebraMap (RingOfIntegers K) L.field))
          (σ L.generator) :=
      Polynomial.hom_eval₂ p (algebraMap (RingOfIntegers K) L.field)
        σ.toRingHom L.generator
    _ = p.eval₂ (algebraMap (RingOfIntegers K) L.field) y := by
      have hcoeff : σ.toRingHom.comp
          (algebraMap (RingOfIntegers K) L.field) =
          algebraMap (RingOfIntegers K) L.field := by
        ext x
        rw [IsScalarTower.algebraMap_apply (RingOfIntegers K) K L.field]
        exact congrArg (fun z : L.field => (z : Ksep))
          (σ.commutes (algebraMap (RingOfIntegers K) K x))
      rw [hcoeff, lubinTateRootAlgEquiv_generator K Ksep π m hm L y hy]

private noncomputable def lubinTateIntegralUnitAlgEquiv
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K)) :
    L.field ≃ₐ[K] L.field :=
  lubinTateRootAlgEquiv K Ksep π m hm L
    (L.evaluation ((lubinTateFormalModule K π).endomorphism
      (u : RingOfIntegers K)))
    (lubinTateUnitEndomorphism_isRoot_level K Ksep π m hm L u)

private theorem lubinTateIntegralUnitAlgEquiv_generator
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K)) :
    lubinTateIntegralUnitAlgEquiv K Ksep π m hm L u L.generator =
      L.evaluation ((lubinTateFormalModule K π).endomorphism
        (u : RingOfIntegers K)) :=
  lubinTateRootAlgEquiv_generator K Ksep π m hm L _ _

private theorem exists_lubinTateUnit_action_polynomial
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K)) :
    ∃ p : Polynomial (RingOfIntegers K),
      p.eval₂ (algebraMap (RingOfIntegers K) L.field) L.generator =
        L.evaluation ((lubinTateFormalModule K π).endomorphism
          (u : RingOfIntegers K)) := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  letI : ValuativeRel L.field := L.localFieldData.valuativeRel
  letI : TopologicalSpace L.field := L.localFieldData.topology
  letI : IsNonarchimedeanLocalField L.field := L.localFieldData.localField
  letI : ValuativeExtension K L.field := L.localFieldData.valuativeExtension
  let intMap := L.integerAlgebraMap
  letI : Algebra (RingOfIntegers K) (RingOfIntegers L.field) := intMap.toAlgebra
  letI : IsScalarTower (RingOfIntegers K) (RingOfIntegers L.field) L.field :=
    IsScalarTower.of_algebraMap_eq fun x => (L.integerAlgebraMap_apply x).symm
  let y := L.evaluation ((lubinTateFormalModule K π).endomorphism
    (u : RingOfIntegers K))
  have hyint : IsIntegral (RingOfIntegers K) y := by
    refine ⟨primitiveDivisionPolynomial K π m,
      (primitiveDivisionPolynomial_monic_natDegree K π m hm).1, ?_⟩
    exact lubinTateUnitEndomorphism_isRoot_level K Ksep π m hm L u
  have hyint' : IsIntegral (RingOfIntegers L.field) y := hyint.tower_top
  let yint : RingOfIntegers L.field := ⟨y,
    (Valuation.integer.integers (ValuativeRel.valuation L.field)).mem_of_integral hyint'⟩
  obtain ⟨p, hp⟩ := L.integral_polynomial_coordinates yint
  exact ⟨p, hp⟩

set_option maxHeartbeats 800000 in
private theorem lubinTateIntegralUnitAlgEquiv_evaluation
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m)
    (u v : Units (RingOfIntegers K)) :
    lubinTateIntegralUnitAlgEquiv K Ksep π m hm L u
        (L.evaluation ((lubinTateFormalModule K π).endomorphism
          (v : RingOfIntegers K))) =
      L.evaluation ((lubinTateFormalModule K π).endomorphism
        ((u * v : Units (RingOfIntegers K)) : RingOfIntegers K)) := by
  let G := lubinTateFormalModule K π
  let eu := G.endomorphism (u : RingOfIntegers K)
  let ev := G.endomorphism (v : RingOfIntegers K)
  let σ := lubinTateIntegralUnitAlgEquiv K Ksep π m hm L u
  have heu0 : PowerSeries.constantCoeff eu = 0 := G.constantCoeff u
  obtain ⟨p, hp⟩ := exists_lubinTateUnit_action_polynomial K Ksep π m hm L v
  have hevp : L.evaluation ev =
      L.evaluation (p : PowerSeries (RingOfIntegers K)) := by
    rw [lubinTateLevel_evaluation_polynomial K Ksep π m hm L]
    exact hp.symm
  have hdiff : L.evaluation
      (ev - (p : PowerSeries (RingOfIntegers K))) = 0 := by
    rw [map_sub, hevp, sub_self]
  have hstable := lubinTateLevel_kernel_stable_unit K Ksep π m hm L u _ hdiff
  have heu : PowerSeries.HasSubst eu := PowerSeries.HasSubst.of_constantCoeff_zero heu0
  rw [PowerSeries.subst_sub heu, map_sub, sub_eq_zero] at hstable
  calc
    σ (L.evaluation ev) = σ (p.eval₂
        (algebraMap (RingOfIntegers K) L.field) L.generator) := by rw [hp]
    _ = p.eval₂ (algebraMap (RingOfIntegers K) L.field) (L.evaluation eu) :=
      lubinTateRootAlgEquiv_polynomial K Ksep π m hm L _ _ p
    _ = L.evaluation (PowerSeries.subst eu
        (p : PowerSeries (RingOfIntegers K))) :=
      (lubinTateLevel_evaluation_subst_polynomial K Ksep π m hm L p eu heu0).symm
    _ = L.evaluation (PowerSeries.subst eu ev) := hstable.symm
    _ = L.evaluation (G.endomorphism
        ((v : RingOfIntegers K) * (u : RingOfIntegers K))) := by
      rw [G.map_mul]
    _ = L.evaluation (G.endomorphism
        ((u * v : Units (RingOfIntegers K)) : RingOfIntegers K)) := by
      rw [mul_comm]
      rfl

private noncomputable def lubinTateIntegralUnitActionHom
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Units (RingOfIntegers K) →* (L.field ≃ₐ[K] L.field) where
  toFun := lubinTateIntegralUnitAlgEquiv K Ksep π m hm L
  map_one' := by
    apply AlgEquiv.coe_algHom_injective
    let pb := lubinTateLevelPowerBasis K Ksep π m hm L
    apply pb.algHom_ext
    rw [lubinTateLevelPowerBasis_gen K Ksep π m hm L]
    change lubinTateIntegralUnitAlgEquiv K Ksep π m hm L 1 L.generator =
      L.generator
    rw [lubinTateIntegralUnitAlgEquiv_generator]
    change L.evaluation ((lubinTateFormalModule K π).endomorphism 1) = L.generator
    rw [(lubinTateFormalModule K π).one_action,
      lubinTateLevel_evaluation_X K Ksep π m hm L]
  map_mul' := by
    intro u v
    apply AlgEquiv.coe_algHom_injective
    let pb := lubinTateLevelPowerBasis K Ksep π m hm L
    apply pb.algHom_ext
    rw [lubinTateLevelPowerBasis_gen K Ksep π m hm L]
    change lubinTateIntegralUnitAlgEquiv K Ksep π m hm L (u * v) L.generator =
      lubinTateIntegralUnitAlgEquiv K Ksep π m hm L u
        (lubinTateIntegralUnitAlgEquiv K Ksep π m hm L v L.generator)
    rw [lubinTateIntegralUnitAlgEquiv_generator,
      lubinTateIntegralUnitAlgEquiv_generator,
      lubinTateIntegralUnitAlgEquiv_evaluation K Ksep π m hm L u v]

private theorem torsion_integralUnitReduction_surjective
    (m : ℕ) (hm : 1 ≤ m) :
    Function.Surjective (integralUnitReduction K m) := by
  let I := LocalMaximalIdeal K ^ m
  have hI : I ≠ ⊤ := by
    intro htop
    apply (IsLocalRing.maximalIdeal.isMaximal (R := RingOfIntegers K)).ne_top
    apply top_unique
    rw [← htop]
    exact Ideal.pow_le_self (by omega)
  letI : Nontrivial (RingOfIntegers K ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr hI
  apply IsLocalRing.surjective_units_map_of_local_ringHom
    (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  exact Ideal.Quotient.mk_surjective.isLocalHom (Ideal.Quotient.mk I)

private theorem lubinTateIntegralUnitAction_ker
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    (integralUnitReduction K m).ker ≤
      (lubinTateIntegralUnitActionHom K Ksep π m hm L).ker := by
  intro u hu
  rw [MonoidHom.mem_ker] at hu ⊢
  have hq : Ideal.Quotient.mk (LocalMaximalIdeal K ^ m)
      (u : RingOfIntegers K) =
      Ideal.Quotient.mk (LocalMaximalIdeal K ^ m) 1 :=
    congrArg Units.val hu
  have hmem : (u : RingOfIntegers K) - 1 ∈ LocalMaximalIdeal K ^ m :=
    Ideal.Quotient.eq.mp hq
  have hz := (lubinTateLevel_endomorphism_eq_zero_iff K Ksep π m hm L
    ((u : RingOfIntegers K) - 1)).mpr hmem
  have heval : L.evaluation ((lubinTateFormalModule K π).endomorphism
        (u : RingOfIntegers K)) =
      L.evaluation ((lubinTateFormalModule K π).endomorphism 1) := by
    have h := (lubinTateLevel_evaluation_add_eq_iff K Ksep π m hm L
      1 ((u : RingOfIntegers K) - 1)).mpr hz
    simpa using h
  apply AlgEquiv.coe_toAlgHom_injective
  let pb := lubinTateLevelPowerBasis K Ksep π m hm L
  apply pb.algHom_ext
  rw [lubinTateLevelPowerBasis_gen K Ksep π m hm L]
  change lubinTateIntegralUnitAlgEquiv K Ksep π m hm L u L.generator =
    L.generator
  rw [lubinTateIntegralUnitAlgEquiv_generator]
  calc
    L.evaluation ((lubinTateFormalModule K π).endomorphism
        (u : RingOfIntegers K)) =
        L.evaluation ((lubinTateFormalModule K π).endomorphism 1) := heval
    _ = L.generator := by
      rw [(lubinTateFormalModule K π).one_action,
        lubinTateLevel_evaluation_X K Ksep π m hm L]

private noncomputable def lubinTateQuotientUnitActionHom
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) →*
      (L.field ≃ₐ[K] L.field) :=
  MonoidHom.liftOfSurjective (integralUnitReduction K m)
    (torsion_integralUnitReduction_surjective K m hm)
    ⟨lubinTateIntegralUnitActionHom K Ksep π m hm L,
      lubinTateIntegralUnitAction_ker K Ksep π m hm L⟩

private theorem lubinTateQuotientUnitActionHom_reduction
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) (u : Units (RingOfIntegers K)) :
    lubinTateQuotientUnitActionHom K Ksep π m hm L
        (integralUnitReduction K m u) =
      lubinTateIntegralUnitActionHom K Ksep π m hm L u := by
  simp [lubinTateQuotientUnitActionHom]

private theorem lubinTateQuotientUnitActionHom_injective
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Function.Injective (lubinTateQuotientUnitActionHom K Ksep π m hm L) := by
  rw [← MonoidHom.ker_eq_bot_iff]
  ext q
  simp only [MonoidHom.mem_ker, Subgroup.mem_bot]
  constructor
  · intro hq
    obtain ⟨u, rfl⟩ := torsion_integralUnitReduction_surjective K m hm q
    rw [lubinTateQuotientUnitActionHom_reduction] at hq
    have hgen := congrArg (fun σ : L.field ≃ₐ[K] L.field => σ L.generator) hq
    have heval : L.evaluation ((lubinTateFormalModule K π).endomorphism
          (u : RingOfIntegers K)) =
        L.evaluation ((lubinTateFormalModule K π).endomorphism 1) := by
      rw [show L.evaluation ((lubinTateFormalModule K π).endomorphism
          (u : RingOfIntegers K)) = L.generator by
            simpa [lubinTateIntegralUnitActionHom,
              lubinTateIntegralUnitAlgEquiv_generator] using hgen]
      rw [(lubinTateFormalModule K π).one_action,
        lubinTateLevel_evaluation_X K Ksep π m hm L]
    have hz : L.evaluation ((lubinTateFormalModule K π).endomorphism
        ((u : RingOfIntegers K) - 1)) = 0 := by
      apply (lubinTateLevel_evaluation_add_eq_iff K Ksep π m hm L
        1 ((u : RingOfIntegers K) - 1)).mp
      simpa using heval
    have hmem := (lubinTateLevel_endomorphism_eq_zero_iff K Ksep π m hm L
      ((u : RingOfIntegers K) - 1)).mp hz
    apply Units.ext
    change Ideal.Quotient.mk (LocalMaximalIdeal K ^ m)
        (u : RingOfIntegers K) =
      Ideal.Quotient.mk (LocalMaximalIdeal K ^ m) 1
    exact Ideal.Quotient.eq.mpr hmem
  · intro h
    rw [h, map_one]

private theorem lubinTateLevel_finrank
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Module.finrank K L.field =
      (residueCard K - 1) * residueCard K ^ (m - 1) := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  let pb := lubinTateLevelPowerBasis K Ksep π m hm L
  let P := primitiveDivisionPolynomial K π m
  have hmonic : P.Monic := (primitiveDivisionPolynomial_monic_natDegree K π m hm).1
  calc
    Module.finrank K L.field = pb.dim := pb.finrank
    _ = P.natDegree := by
      have hdeg := pb.degree_minpoly
      rw [show pb.gen = L.generator from
          lubinTateLevelPowerBasis_gen K Ksep π m hm L,
        lubinTateLevel_minpoly K Ksep π m hm L,
        Polynomial.degree_eq_natDegree (hmonic.map _).ne_zero,
        hmonic.natDegree_map] at hdeg
      exact_mod_cast hdeg.symm
    _ = (residueCard K - 1) * residueCard K ^ (m - 1) :=
      (primitiveDivisionPolynomial_monic_natDegree K π m hm).2

private theorem torsion_quotient_finite (m : ℕ) :
    Finite (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) := by
  letI : Finite (RingOfIntegers K ⧸ LocalMaximalIdeal K) := by
    change Finite (LocalResidueField K)
    infer_instance
  exact Ideal.finite_quotient_pow
    (IsNoetherian.noetherian (LocalMaximalIdeal K)) m

private theorem torsion_card_quotient (m : ℕ) :
    Nat.card (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) =
      residueCard K ^ m := by
  rw [← Submodule.cardQuot_apply, cardQuot_pow_of_prime
    (IsDiscreteValuationRing.not_a_field (RingOfIntegers K)),
    Submodule.cardQuot_apply]
  rfl

private noncomputable def torsionUnitsEquivNonmaximal
    (A : Type*) [CommRing A] [IsLocalRing A] :
    Units A ≃ {x : A // x ∉ IsLocalRing.maximalIdeal A} where
  toFun u := ⟨u, by
    intro hu
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hu)) u.isUnit⟩
  invFun x := (by
    apply Classical.not_not.mp
    intro hx
    apply x.prop
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact hx : IsUnit (x : A)).unit
  left_inv u := Units.ext (by simp)
  right_inv x := Subtype.ext (by simp)

private theorem torsion_card_quotient_units (m : ℕ) (hm : 1 ≤ m) :
    Nat.card (Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m)) =
      (residueCard K - 1) * residueCard K ^ (m - 1) := by
  let R := RingOfIntegers K
  let I := LocalMaximalIdeal K
  let A := R ⧸ I ^ m
  let q := residueCard K
  have hpow_le : I ^ m ≤ I := Ideal.pow_le_self (by omega)
  have hpow_ne_top : I ^ m ≠ ⊤ := by
    intro h
    apply (IsLocalRing.maximalIdeal.isMaximal (R := R)).ne_top
    rw [eq_top_iff]
    simpa [h] using hpow_le
  letI : Nontrivial A := Ideal.Quotient.nontrivial_iff.mpr hpow_ne_top
  letI : IsLocalRing A :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (I ^ m)) Ideal.Quotient.mk_surjective
  letI : Finite A := torsion_quotient_finite K m
  letI : Fintype A := Fintype.ofFinite A
  letI : Fintype Aˣ := Fintype.ofFinite Aˣ
  let J : Ideal A := I.map (Ideal.Quotient.mk (I ^ m))
  have hJ : J = IsLocalRing.maximalIdeal A := by
    exact IsLocalRing.map_maximalIdeal_of_surjective
      (Ideal.Quotient.mk (I ^ m)) Ideal.Quotient.mk_surjective
  have hqpos : 0 < q := Nat.zero_lt_one.trans (torsion_one_lt_residueCard K)
  have hcardA : Nat.card A = q ^ m := torsion_card_quotient K m
  have hcardJ : Nat.card J = q ^ (m - 1) := by
    let M : Submodule R A := Submodule.map (I ^ m).mkQ I
    have hMJ (x : A) : x ∈ M ↔ x ∈ J := by
      change (∃ y ∈ I, (I ^ m).mkQ y = x) ↔ x ∈ J
      rw [Ideal.mem_map_iff_of_surjective
        (Ideal.Quotient.mk (I ^ m)) Ideal.Quotient.mk_surjective]
      rfl
    let e : M ≃ J :=
      { toFun := fun x => ⟨x.1, (hMJ x).mp x.2⟩
        invFun := fun x => ⟨x.1, (hMJ x).mpr x.2⟩
        left_inv := fun x => Subtype.ext rfl
        right_inv := fun x => Subtype.ext rfl }
    have hmul := Submodule.card_quotient_mul_card_quotient I (I ^ m) hpow_le
    change Nat.card M * Nat.card (R ⧸ I) = Nat.card A at hmul
    rw [Nat.card_congr e] at hmul
    have hcardI : Nat.card (R ⧸ I) = q := by
      simpa [R, I, q] using torsion_card_quotient K 1
    rw [hcardI, hcardA] at hmul
    have hpow : q ^ m = q ^ (m - 1) * q := by
      calc
        q ^ m = q ^ ((m - 1) + 1) := by congr 1; omega
        _ = q ^ (m - 1) * q := pow_succ _ _
    rw [hpow] at hmul
    exact Nat.eq_of_mul_eq_mul_right hqpos hmul
  classical
  calc
    Nat.card Aˣ = Fintype.card Aˣ := Nat.card_eq_fintype_card
    _ = Fintype.card {x : A // x ∉ IsLocalRing.maximalIdeal A} :=
      Fintype.card_congr (torsionUnitsEquivNonmaximal A)
    _ = Fintype.card A - Fintype.card {x : A // x ∈ IsLocalRing.maximalIdeal A} :=
      Fintype.card_subtype_compl (fun x : A => x ∈ IsLocalRing.maximalIdeal A)
    _ = Nat.card A - Nat.card J := by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hJ]
    _ = q ^ m - q ^ (m - 1) := by rw [hcardA, hcardJ]
    _ = (q - 1) * q ^ (m - 1) := by
      have hpow : q ^ m = q * q ^ (m - 1) := by
        calc
          q ^ m = q ^ ((m - 1) + 1) := by congr 1; omega
          _ = q ^ (m - 1) * q := pow_succ _ _
          _ = q * q ^ (m - 1) := mul_comm _ _
      rw [hpow]
      simpa only [one_mul] using
        (Nat.mul_sub_right_distrib q 1 (q ^ (m - 1))).symm

private theorem lubinTateQuotientUnitActionHom_bijective
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Function.Bijective (lubinTateQuotientUnitActionHom K Ksep π m hm L) := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  let A := RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m
  let U := Units A
  letI : Finite A := torsion_quotient_finite K m
  letI : Finite U := inferInstance
  letI : Fintype U := Fintype.ofFinite U
  letI : Fintype (L.field ≃ₐ[K] L.field) := AlgEquiv.fintype K L.field
  let f := lubinTateQuotientUnitActionHom K Ksep π m hm L
  have hinj : Function.Injective f :=
    lubinTateQuotientUnitActionHom_injective K Ksep π m hm L
  have hcardU : Fintype.card U = Module.finrank K L.field := by
    rw [← Nat.card_eq_fintype_card, torsion_card_quotient_units K m hm,
      lubinTateLevel_finrank K Ksep π m hm L]
  have hle₁ : Fintype.card U ≤ Fintype.card (L.field ≃ₐ[K] L.field) :=
    Fintype.card_le_of_injective f hinj
  have hle₂ : Fintype.card (L.field ≃ₐ[K] L.field) ≤ Fintype.card U := by
    rw [hcardU]
    exact AlgEquiv.card_le
  exact (Fintype.bijective_iff_injective_and_card f).mpr
    ⟨hinj, Nat.le_antisymm hle₁ hle₂⟩

private noncomputable def lubinTateLevelGaloisEquiv
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) ≃*
      (L.field ≃ₐ[K] L.field) :=
  MulEquiv.ofBijective (lubinTateQuotientUnitActionHom K Ksep π m hm L)
    (lubinTateQuotientUnitActionHom_bijective K Ksep π m hm L)

private theorem lubinTateLevel_isGalois
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) : IsGalois K L.field := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  apply IsGalois.of_card_aut_eq_finrank K L.field
  calc
    Nat.card (L.field ≃ₐ[K] L.field) =
        Nat.card (Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m)) :=
      Nat.card_congr (lubinTateLevelGaloisEquiv K Ksep π m hm L).symm.toEquiv
    _ = (residueCard K - 1) * residueCard K ^ (m - 1) :=
      torsion_card_quotient_units K m hm
    _ = Module.finrank K L.field :=
      (lubinTateLevel_finrank K Ksep π m hm L).symm

set_option maxHeartbeats 800000 in
private theorem lubinTate_conjugates_eq_primitive
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (L : LubinTateLevel K Ksep π m) :
    Set.range (fun σ : (L.field ≃ₐ[K] L.field) =>
      (((σ L.generator : L.field)) : Ksep)) =
        {x : Ksep | IsPrimitiveLubinTateDivisionPoint K Ksep π m x} := by
  letI : FiniteDimensional K L.field := L.finiteDimensional
  letI : IsGalois K L.field := lubinTateLevel_isGalois K Ksep π m hm L
  ext x
  constructor
  · rintro ⟨σ, rfl⟩
    obtain ⟨q, hq⟩ :=
      (lubinTateLevelGaloisEquiv K Ksep π m hm L).surjective σ
    obtain ⟨u, hu⟩ := torsion_integralUnitReduction_surjective K m hm q
    have heq : σ L.generator =
        L.evaluation ((lubinTateFormalModule K π).endomorphism
          (u : RingOfIntegers K)) := by
      rw [← hq, ← hu]
      change lubinTateQuotientUnitActionHom K Ksep π m hm L
          (integralUnitReduction K m u) L.generator = _
      rw [lubinTateQuotientUnitActionHom_reduction]
      exact lubinTateIntegralUnitAlgEquiv_generator K Ksep π m hm L u
    change IsPrimitiveLubinTateDivisionPoint K Ksep π m
      (((σ L.generator : L.field)) : Ksep)
    rw [heq]
    exact lubinTateUnitEndomorphism_preserves_primitive K Ksep π m hm L u
  · intro hx
    have hxP := (primitiveDivisionPolynomial_isRoot_iff K Ksep π m hm x).mpr hx
    have hxmin' : ((minpoly K L.generator).map
        (algebraMap K Ksep)).IsRoot x := by
      rw [lubinTateLevel_minpoly K Ksep π m hm L, Polynomial.map_map,
        ← IsScalarTower.algebraMap_eq (RingOfIntegers K) K Ksep]
      exact hxP
    have hxmin : (((minpoly K L.generator).map
        (algebraMap K L.field)).map (algebraMap L.field Ksep)).IsRoot x := by
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq K L.field Ksep]
      exact hxmin'
    have hxzero : Polynomial.aeval x (minpoly K L.generator) = 0 := by
      rw [Polynomial.aeval_def]
      simpa only [Polynomial.IsRoot.def, Polynomial.eval_map] using hxmin'
    have hsplits : ((minpoly K L.generator).map
        (algebraMap K L.field)).Splits :=
      Normal.splits (inferInstance : Normal K L.field) L.generator
    have hne : (minpoly K L.generator).map (algebraMap K L.field) ≠ 0 :=
      (minpoly.monic (IsIntegral.of_finite K L.generator)).map _ |>.ne_zero
    obtain ⟨y, hy⟩ := hsplits.mem_range_of_isRoot hne hxmin
    have hyroot : Polynomial.aeval y (minpoly K L.generator) = 0 := by
      apply (algebraMap L.field Ksep).injective
      rw [map_zero, Polynomial.aeval_def, Polynomial.hom_eval₂,
        ← IsScalarTower.algebraMap_eq K L.field Ksep, hy,
        ← Polynomial.aeval_def]
      exact hxzero
    have hconj : IsConjRoot K L.generator y :=
      (isConjRoot_iff_aeval_eq_zero (IsIntegral.of_finite K L.generator)).mpr hyroot
    obtain ⟨σ, hσ⟩ := hconj.symm.exists_algEquiv
    refine ⟨σ, ?_⟩
    change (((σ L.generator : L.field)) : Ksep) = x
    rw [hσ]
    exact hy

private noncomputable def lubinTateTowerRestriction
    (π : Uniformizer K) (T : LubinTateTower K Ksep π)
    (m : ℕ) (hm : 1 ≤ m) :
    ((T.level (m + 1) (Nat.succ_pos m)).field ≃ₐ[K]
      (T.level (m + 1) (Nat.succ_pos m)).field) →*
        ((T.level m hm).field ≃ₐ[K] (T.level m hm).field) := by
  let E := (T.level m hm).field
  let M := (T.level (m + 1) (Nat.succ_pos m)).field
  let i := IntermediateField.inclusion (T.field_le m hm)
  letI : FiniteDimensional K E := (T.level m hm).finiteDimensional
  letI : IsGalois K E :=
    lubinTateLevel_isGalois K Ksep π m hm (T.level m hm)
  letI : Algebra E M := i.toAlgebra
  letI : IsScalarTower K E M :=
    IsScalarTower.of_algebraMap_eq fun x => (i.commutes x).symm
  exact AlgEquiv.restrictNormalHom E

private theorem lubinTateTowerRestriction_apply
    (π : Uniformizer K) (T : LubinTateTower K Ksep π)
    (m : ℕ) (hm : 1 ≤ m)
    (σ : ((T.level (m + 1) (Nat.succ_pos m)).field ≃ₐ[K]
      (T.level (m + 1) (Nat.succ_pos m)).field))
    (x : (T.level m hm).field) :
    IntermediateField.inclusion (T.field_le m hm)
        (lubinTateTowerRestriction K Ksep π T m hm σ x) =
      σ (IntermediateField.inclusion (T.field_le m hm) x) := by
  let E := (T.level m hm).field
  let M := (T.level (m + 1) (Nat.succ_pos m)).field
  let i := IntermediateField.inclusion (T.field_le m hm)
  letI : FiniteDimensional K E := (T.level m hm).finiteDimensional
  letI : IsGalois K E :=
    lubinTateLevel_isGalois K Ksep π m hm (T.level m hm)
  letI : Algebra E M := i.toAlgebra
  letI : IsScalarTower K E M :=
    IsScalarTower.of_algebraMap_eq fun z => (i.commutes z).symm
  exact AlgEquiv.restrictNormal_commutes σ E x

private theorem lubinTateTower_generator_compatible_evaluation
    (π : Uniformizer K) (T : LubinTateTower K Ksep π)
    (m : ℕ) (hm : 1 ≤ m) :
    IntermediateField.inclusion (T.field_le m hm) (T.level m hm).generator =
      (T.level (m + 1) (Nat.succ_pos m)).evaluation (lubinTateSeries K π) := by
  let L := T.level m hm
  let M := T.level (m + 1) (Nat.succ_pos m)
  rw [show lubinTateSeries K π =
      ((lubinTatePolynomial K π : Polynomial (RingOfIntegers K)) :
        PowerSeries (RingOfIntegers K)) from rfl,
    lubinTateLevel_evaluation_polynomial K Ksep π (m + 1)
      (Nat.succ_pos m) M]
  apply (algebraMap M.field Ksep).injective
  rw [Polynomial.hom_eval₂]
  simpa [Polynomial.eval_map,
    IsScalarTower.algebraMap_eq (RingOfIntegers K) M.field Ksep] using
      (T.generator_compatible m hm).symm

set_option maxHeartbeats 1000000 in
private theorem lubinTateTower_unit_evaluation_compatible
    (π : Uniformizer K) (T : LubinTateTower K Ksep π)
    (m : ℕ) (hm : 1 ≤ m) (u : Units (RingOfIntegers K)) :
    IntermediateField.inclusion (T.field_le m hm)
        ((T.level m hm).evaluation
          ((lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K))) =
      (T.level (m + 1) (Nat.succ_pos m)).evaluation
        (PowerSeries.subst (lubinTateSeries K π)
          ((lubinTateFormalModule K π).endomorphism
            (u : RingOfIntegers K))) := by
  let L := T.level m hm
  let M := T.level (m + 1) (Nat.succ_pos m)
  let i := IntermediateField.inclusion (T.field_le m hm)
  let G := lubinTateFormalModule K π
  let eu := G.endomorphism (u : RingOfIntegers K)
  let f := lubinTateSeries K π
  let P := primitiveDivisionPolynomial K π m
  have hf0 : PowerSeries.constantCoeff f = 0 := by
    change PowerSeries.constantCoeff (lubinTateSeries K π) = 0
    rw [← (lubinTateFormalModule K π).uniformizer_action]
    exact (lubinTateFormalModule K π).constantCoeff _
  have hf : PowerSeries.HasSubst f := PowerSeries.HasSubst.of_constantCoeff_zero hf0
  obtain ⟨p, hp⟩ := exists_lubinTateUnit_action_polynomial K Ksep π m hm L u
  have hevp : L.evaluation (p : PowerSeries (RingOfIntegers K)) =
      L.evaluation eu := by
    rw [lubinTateLevel_evaluation_polynomial K Ksep π m hm L]
    exact hp
  have hdiff : L.evaluation
      (eu - (p : PowerSeries (RingOfIntegers K))) = 0 := by
    rw [map_sub, hevp, sub_self]
  obtain ⟨q, hq⟩ :=
    (lubinTateLevel_evaluation_ker K Ksep π m hm L _).mp hdiff
  have hcoeffi : i.toRingHom.comp
      (algebraMap (RingOfIntegers K) L.field) =
      algebraMap (RingOfIntegers K) M.field := by
    ext x
    exact congrArg (fun z : M.field => (z : Ksep)) (by
      change i (algebraMap (RingOfIntegers K) L.field x) =
        algebraMap (RingOfIntegers K) M.field x
      rw [IsScalarTower.algebraMap_apply (RingOfIntegers K) K L.field,
        IsScalarTower.algebraMap_apply (RingOfIntegers K) K M.field]
      exact i.commutes (algebraMap (RingOfIntegers K) K x))
  have hPsubst : M.evaluation
      (PowerSeries.subst f (P : PowerSeries (RingOfIntegers K))) = 0 := by
    rw [lubinTateLevel_evaluation_subst_polynomial K Ksep π (m + 1)
      (Nat.succ_pos m) M P f hf0]
    rw [← lubinTateTower_generator_compatible_evaluation K Ksep π T m hm,
      ← hcoeffi]
    have hPzero := lubinTateLevel_evaluation_primitivePolynomial K Ksep π m hm L
    rw [lubinTateLevel_evaluation_polynomial K Ksep π m hm L] at hPzero
    calc
      P.eval₂ (i.toRingHom.comp
          (algebraMap (RingOfIntegers K) L.field)) (i L.generator) =
          i (P.eval₂ (algebraMap (RingOfIntegers K) L.field) L.generator) :=
        (Polynomial.hom_eval₂ P (algebraMap (RingOfIntegers K) L.field)
          i.toRingHom L.generator).symm
      _ = i 0 := congrArg i hPzero
      _ = 0 := map_zero i
  have hsubzero : M.evaluation
      (PowerSeries.subst f (eu - (p : PowerSeries (RingOfIntegers K)))) = 0 := by
    rw [hq, PowerSeries.subst_mul hf, map_mul, hPsubst, zero_mul]
  have hsubeq : M.evaluation (PowerSeries.subst f eu) =
      M.evaluation (PowerSeries.subst f
        (p : PowerSeries (RingOfIntegers K))) := by
    rw [PowerSeries.subst_sub hf, map_sub, sub_eq_zero] at hsubzero
    exact hsubzero
  calc
    i (L.evaluation eu) =
        i (p.eval₂ (algebraMap (RingOfIntegers K) L.field) L.generator) := by
      rw [hp]
    _ = p.eval₂ (algebraMap (RingOfIntegers K) M.field) (i L.generator) := by
      rw [← hcoeffi]
      exact Polynomial.hom_eval₂ p (algebraMap (RingOfIntegers K) L.field)
        i.toRingHom L.generator
    _ = p.eval₂ (algebraMap (RingOfIntegers K) M.field) (M.evaluation f) := by
      rw [← lubinTateTower_generator_compatible_evaluation K Ksep π T m hm]
    _ = M.evaluation (PowerSeries.subst f
        (p : PowerSeries (RingOfIntegers K))) :=
      (lubinTateLevel_evaluation_subst_polynomial K Ksep π (m + 1)
        (Nat.succ_pos m) M p f hf0).symm
    _ = M.evaluation (PowerSeries.subst f eu) := hsubeq.symm

set_option maxHeartbeats 800000 in
private theorem lubinTateTowerRestriction_integralUnit
    (π : Uniformizer K) (T : LubinTateTower K Ksep π)
    (m : ℕ) (hm : 1 ≤ m) (u : Units (RingOfIntegers K)) :
    lubinTateTowerRestriction K Ksep π T m hm
        (lubinTateIntegralUnitAlgEquiv K Ksep π (m + 1)
          (Nat.succ_pos m) (T.level (m + 1) (Nat.succ_pos m)) u) =
      lubinTateIntegralUnitAlgEquiv K Ksep π m hm (T.level m hm) u := by
  let L := T.level m hm
  let M := T.level (m + 1) (Nat.succ_pos m)
  let i := IntermediateField.inclusion (T.field_le m hm)
  let G := lubinTateFormalModule K π
  let eu := G.endomorphism (u : RingOfIntegers K)
  let f := lubinTateSeries K π
  apply AlgEquiv.coe_toAlgHom_injective
  let pb := lubinTateLevelPowerBasis K Ksep π m hm L
  apply pb.algHom_ext
  rw [lubinTateLevelPowerBasis_gen K Ksep π m hm L]
  apply i.injective
  have heu0 : PowerSeries.constantCoeff eu = 0 := G.constantCoeff u
  calc
    i ((lubinTateTowerRestriction K Ksep π T m hm
        (lubinTateIntegralUnitAlgEquiv K Ksep π (m + 1)
          (Nat.succ_pos m) M u)) L.generator) =
        lubinTateIntegralUnitAlgEquiv K Ksep π (m + 1)
          (Nat.succ_pos m) M u (i L.generator) :=
      lubinTateTowerRestriction_apply K Ksep π T m hm _ L.generator
    _ =
        lubinTateIntegralUnitAlgEquiv K Ksep π (m + 1) (Nat.succ_pos m) M u
          (M.evaluation f) := by
      rw [← lubinTateTower_generator_compatible_evaluation K Ksep π T m hm]
    _ = lubinTateIntegralUnitAlgEquiv K Ksep π (m + 1) (Nat.succ_pos m) M u
          ((lubinTatePolynomial K π).eval₂
            (algebraMap (RingOfIntegers K) M.field) M.generator) := by
      rw [← lubinTateLevel_evaluation_polynomial K Ksep π (m + 1)
        (Nat.succ_pos m) M]
      rfl
    _ = (lubinTatePolynomial K π).eval₂
          (algebraMap (RingOfIntegers K) M.field) (M.evaluation eu) :=
      lubinTateRootAlgEquiv_polynomial K Ksep π (m + 1) (Nat.succ_pos m)
        M _ _ (lubinTatePolynomial K π)
    _ = M.evaluation (PowerSeries.subst eu f) := by
      rw [show f = ((lubinTatePolynomial K π : Polynomial (RingOfIntegers K)) :
        PowerSeries (RingOfIntegers K)) from rfl]
      exact (lubinTateLevel_evaluation_subst_polynomial K Ksep π (m + 1)
        (Nat.succ_pos m) M (lubinTatePolynomial K π) eu heu0).symm
    _ = M.evaluation (PowerSeries.subst f eu) := by
      rw [G.functional]
    _ = i (L.evaluation eu) :=
      (lubinTateTower_unit_evaluation_compatible K Ksep π T m hm u).symm
    _ = i (lubinTateIntegralUnitAlgEquiv K Ksep π m hm L u L.generator) :=
      congrArg i (lubinTateIntegralUnitAlgEquiv_generator
        K Ksep π m hm L u).symm

private theorem lubinTateUnitReduction_integralUnitReduction
    (m : ℕ) (u : Units (RingOfIntegers K)) :
    lubinTateUnitReduction K m (integralUnitReduction K (m + 1) u) =
      integralUnitReduction K m u := by
  apply Units.ext
  rfl

private theorem lubinTateTowerRestriction_quotientUnit
    (π : Uniformizer K) (T : LubinTateTower K Ksep π)
    (m : ℕ) (hm : 1 ≤ m)
    (q : Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ (m + 1))) :
    lubinTateTowerRestriction K Ksep π T m hm
        (lubinTateLevelGaloisEquiv K Ksep π (m + 1) (Nat.succ_pos m)
          (T.level (m + 1) (Nat.succ_pos m)) q) =
      lubinTateLevelGaloisEquiv K Ksep π m hm (T.level m hm)
        (lubinTateUnitReduction K m q) := by
  obtain ⟨u, rfl⟩ := torsion_integralUnitReduction_surjective K (m + 1)
    (Nat.succ_pos m) q
  change lubinTateTowerRestriction K Ksep π T m hm
      (lubinTateQuotientUnitActionHom K Ksep π (m + 1) (Nat.succ_pos m)
        (T.level (m + 1) (Nat.succ_pos m))
        (integralUnitReduction K (m + 1) u)) = _
  rw [lubinTateQuotientUnitActionHom_reduction,
    lubinTateUnitReduction_integralUnitReduction K m u]
  change lubinTateTowerRestriction K Ksep π T m hm
      (lubinTateIntegralUnitAlgEquiv K Ksep π (m + 1) (Nat.succ_pos m)
        (T.level (m + 1) (Nat.succ_pos m)) u) =
    lubinTateQuotientUnitActionHom K Ksep π m hm (T.level m hm)
      (integralUnitReduction K m u)
  rw [lubinTateQuotientUnitActionHom_reduction,
    lubinTateTowerRestriction_integralUnit K Ksep π T m hm u]
  rfl

/--
**L03**, Proposition `prop:lt-galois`: the faithful residue-unit action has the full degree and
therefore supplies the pinned Galois equivalences and compatible restriction maps.
-/
theorem lubinTateGaloisData_exists (π : Uniformizer K) :
    Nonempty (LubinTateGaloisData K Ksep π (lubinTateTower K Ksep π)) := by
  let T := lubinTateTower K Ksep π
  refine ⟨{
    isGalois := fun m hm =>
      lubinTateLevel_isGalois K Ksep π m hm (T.level m hm)
    commutative := ?_
    galoisEquiv := fun m hm =>
      lubinTateLevelGaloisEquiv K Ksep π m hm (T.level m hm)
    unitReduction_surjective := fun m hm =>
      torsion_integralUnitReduction_surjective K m hm
    action_generator := ?_
    conjugates_eq_primitive := fun m hm =>
      lubinTate_conjugates_eq_primitive K Ksep π m hm (T.level m hm)
    restriction := fun m hm =>
      lubinTateTowerRestriction K Ksep π T m hm
    restriction_apply := fun m hm σ x =>
      lubinTateTowerRestriction_apply K Ksep π T m hm σ x
    transition := fun m hm q =>
      lubinTateTowerRestriction_quotientUnit K Ksep π T m hm q }⟩
  · intro m hm σ τ
    let e := lubinTateLevelGaloisEquiv K Ksep π m hm (T.level m hm)
    obtain ⟨u, rfl⟩ := e.surjective σ
    obtain ⟨v, rfl⟩ := e.surjective τ
    calc
      e u * e v = e (u * v) := (map_mul e u v).symm
      _ = e (v * u) := congrArg e (mul_comm u v)
      _ = e v * e u := map_mul e v u
  · intro m hm u
    change lubinTateQuotientUnitActionHom K Ksep π m hm (T.level m hm)
        (integralUnitReduction K m u) (T.level m hm).generator = _
    rw [lubinTateQuotientUnitActionHom_reduction]
    exact lubinTateIntegralUnitAlgEquiv_generator K Ksep π m hm (T.level m hm) u

/-- The chosen L03 Galois data on the chosen L02 tower. -/
noncomputable def lubinTateGaloisData (π : Uniformizer K) :
    LubinTateGaloisData K Ksep π (lubinTateTower K Ksep π) :=
  (lubinTateGaloisData_exists K Ksep π).some

/-- The actual chosen residue-unit/Galois equivalence. -/
noncomputable def lubinTateGaloisEquiv
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    Units (RingOfIntegers K ⧸ LocalMaximalIdeal K ^ m) ≃*
      ((lubinTateLevel K Ksep π m hm).field ≃ₐ[K]
        (lubinTateLevel K Ksep π m hm).field) :=
  (lubinTateGaloisData K Ksep π).galoisEquiv m hm

/--
**L03**, Proposition `prop:lt-galois`: the selected equivalence is pinned both by its action on
`α_m` and by the assertion that those conjugates exhaust primitive torsion.
-/
theorem lubinTateLevel_galoisEquiv
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    Function.Surjective (integralUnitReduction K m) ∧
      (∀ u : Units (RingOfIntegers K),
        lubinTateGaloisEquiv K Ksep π m hm (integralUnitReduction K m u)
              (lubinTateLevel K Ksep π m hm).generator =
          (lubinTateLevel K Ksep π m hm).evaluation
            ((lubinTateFormalModule K π).endomorphism (u : RingOfIntegers K))) ∧
      Set.range (fun σ :
        ((lubinTateLevel K Ksep π m hm).field ≃ₐ[K]
          (lubinTateLevel K Ksep π m hm).field) =>
          (((σ (lubinTateLevel K Ksep π m hm).generator :
            (lubinTateLevel K Ksep π m hm).field)) : Ksep)) =
        {x : Ksep | IsPrimitiveLubinTateDivisionPoint K Ksep π m x} := by
  exact ⟨(lubinTateGaloisData K Ksep π).unitReduction_surjective m hm,
    (lubinTateGaloisData K Ksep π).action_generator m hm,
    (lubinTateGaloisData K Ksep π).conjugates_eq_primitive m hm⟩

/--
**L03**, Proposition `prop:lt-galois`: the displayed map is actual restriction and, under the
same chosen Galois equivalences, is exactly reduction modulo `𝔪_K^m`.
-/
theorem lubinTateLevel_transition
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    ∃ restriction :
        ((lubinTateLevel K Ksep π (m + 1) (Nat.succ_pos m)).field ≃ₐ[K]
          (lubinTateLevel K Ksep π (m + 1) (Nat.succ_pos m)).field) →*
        ((lubinTateLevel K Ksep π m hm).field ≃ₐ[K]
          (lubinTateLevel K Ksep π m hm).field),
      (∀ σ x,
        IntermediateField.inclusion
            ((lubinTateTower K Ksep π).field_le m hm) ((restriction σ) x) =
          σ (IntermediateField.inclusion
            ((lubinTateTower K Ksep π).field_le m hm) x)) ∧
      (∀ u, restriction (lubinTateGaloisEquiv K Ksep π (m + 1) (Nat.succ_pos m) u) =
        lubinTateGaloisEquiv K Ksep π m hm (lubinTateUnitReduction K m u)) := by
  refine ⟨(lubinTateGaloisData K Ksep π).restriction m hm, ?_, ?_⟩
  · exact (lubinTateGaloisData K Ksep π).restriction_apply m hm
  · exact (lubinTateGaloisData K Ksep π).transition m hm

end

