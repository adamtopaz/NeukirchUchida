      exact (Algebra.discr_not_zero_of_basis K B.basis) hd0
    obtain ⟨n, u, hfac⟩ :=
      IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hr0 (torsion_uniformizerInteger_irreducible K π)
    let A : Subalgebra (RingOfIntegers K) E :=
      Algebra.adjoin (RingOfIntegers K) {B.gen}
    have hpnmem : uniformizerInteger K π ^ n • (x : E) ∈ A := by
      have hu := A.smul_mem hdmem
