  have hp_dvd_g : gO ∣
      algebraMap (RingOfIntegers K) (RingOfIntegers E) (uniformizerInteger K π) := by
    let T := lubinTateIterate K π (m - 1)
    obtain ⟨H, hH⟩ : Polynomial.X ∣ T :=
