      convert hu using 1
      simp only [Algebra.smul_def]
      rw [← hr, hfac]
      simp only [map_mul, map_pow, Units.val_inv_eq_inv_val, map_inv₀]
      rw [← IsScalarTower.algebraMap_apply (RingOfIntegers K) K E]
      rw [← IsScalarTower.algebraMap_apply (RingOfIntegers K) K E
