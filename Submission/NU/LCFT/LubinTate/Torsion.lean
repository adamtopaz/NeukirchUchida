      rwa [hx]
    · intro y hy
      have hyad : y ∈ Algebra.adjoin (RingOfIntegers K) {gO} := by rw [hring]; trivial
      rw [Algebra.adjoin_singleton_eq_range_aeval (RingOfIntegers K) gO] at hyad
