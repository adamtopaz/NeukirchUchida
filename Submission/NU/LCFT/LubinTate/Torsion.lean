    rcases hx with ⟨p, hpmonic, hproot⟩
    let pK := p.map (algebraMap (RingOfIntegers K) K)
    have hpKmonic' : pK.Monic := hpmonic.map _
    have hpKroot : Polynomial.aeval x pK = 0 := by
      dsimp only [pK]
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      rw [← IsScalarTower.algebraMap_eq (RingOfIntegers K) K E]
      exact hproot
    have hpKcoeff (n : ℕ) : ‖pK.coeff n‖ ≤ 1 := by
      dsimp only [pK]
      rw [Polynomial.coeff_map]
      exact Valued.toNormedField.norm_le_one_iff.mpr (p.coeff n).prop
    have hspec : spectralValue pK ≤ 1 :=
      (spectralValue_le_one_iff hpKmonic').mpr hpKcoeff
    have hxspec : spectralNorm K E x ≤ spectralValue pK := by
      exact norm_root_le_spectralValue (f := spectralAlgNorm K E)
