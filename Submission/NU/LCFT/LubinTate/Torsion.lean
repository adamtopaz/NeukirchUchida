import Submission.NU.LCFT.LubinTate.FormalModule

/-!
# Lubin--Tate division points and finite levels

All levels live in one fixed separable closure.  L02 constructs the whole compatible tower before
L03 equips it with Galois structure; in particular no abelian/Galois extension is assumed in the
level data.
-/

namespace NU.LCFT

noncomputable section

open scoped ValuativeRel

universe u v

variable (K : Type u) (Ksep : Type v)
  [Field K] [Field Ksep] [Algebra K Ksep] [IsSepClosure K Ksep]
  [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- Iteration of the Lubin--Tate polynomial. -/
def lubinTateIterate (π : Uniformizer K) : ℕ → Polynomial (RingOfIntegers K)
  | 0 => Polynomial.X
  | n + 1 => (lubinTatePolynomial K π).comp (lubinTateIterate π n)

/-- The primitive level-`m` division polynomial `Q_m`. -/
def primitiveDivisionPolynomial (π : Uniformizer K) (m : ℕ) :
    Polynomial (RingOfIntegers K) :=
  Polynomial.C (uniformizerInteger K π) +
    (lubinTateIterate K π (m - 1)) ^ (residueCard K - 1)

/-- A point killed at level `m` but not at level `m-1`. -/
def IsPrimitiveLubinTateDivisionPoint (π : Uniformizer K) (m : ℕ) (x : Ksep) : Prop :=
  ((lubinTateIterate K π m).map (algebraMap (RingOfIntegers K) Ksep)).IsRoot x ∧
    ¬ ((lubinTateIterate K π (m - 1)).map
      (algebraMap (RingOfIntegers K) Ksep)).IsRoot x

/-- The complete local-field instance bundle on a finite Lubin--Tate intermediate field. -/
structure LubinTateLocalFieldData (E : IntermediateField K Ksep)
    [FiniteDimensional K E] where
  /-- The valuation on the finite level. -/
  valuativeRel : ValuativeRel E
  /-- Its valuation topology. -/
  topology : TopologicalSpace E
  /-- The level is a nonarchimedean local field for the displayed valuation and topology. -/
  localField :
    letI : ValuativeRel E := valuativeRel
    letI : TopologicalSpace E := topology
    IsNonarchimedeanLocalField E
  /-- The displayed valuation extends the base valuation. -/
  valuativeExtension :
    letI : ValuativeRel E := valuativeRel
    letI : TopologicalSpace E := topology
    letI : IsNonarchimedeanLocalField E := localField
    ValuativeExtension K E
  /-- Scalar multiplication by the base field is continuous. -/
  continuousSMul :
    letI : ValuativeRel E := valuativeRel
    letI : TopologicalSpace E := topology
    ContinuousSMul K E

/-- A finite Lubin--Tate level before Galoisness is proved. -/
structure LubinTateLevel (π : Uniformizer K) (m : ℕ) where
  /-- The intermediate field generated by a primitive division point. -/
  field : IntermediateField K Ksep
  /-- Finiteness over the base field. -/
  finiteDimensional : FiniteDimensional K field
  /-- A chosen primitive division point in the level. -/
  generator : field
  /-- The level is literally the field generated by the displayed division point. -/
  field_eq_adjoin :
    field = IntermediateField.adjoin K {((generator : field) : Ksep)}
  /-- The generator is a root of the primitive division polynomial. -/
  isRoot :
    ((primitiveDivisionPolynomial K π m).map
      (algebraMap (RingOfIntegers K) Ksep)).IsRoot ((generator : field) : Ksep)
  /-- Valuation, topology, local-field, extension, and continuity data on the level. -/
  localFieldData :
    letI : FiniteDimensional K field := finiteDimensional
    LubinTateLocalFieldData K Ksep field
  /-- The nonzero element represented by the division-point generator. -/
  generatorUnit :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    Units field
  /-- The preceding unit is exactly the division point. -/
  generatorUnit_val :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    ((generatorUnit : Units field) : field) = generator
  /-- The division point is a normalized uniformizer of the level. -/
  generator_valuation :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    letI : IsNonarchimedeanLocalField field := localFieldData.localField
    normalizedValuation field generatorUnit = 1
  /-- The division point is topologically nilpotent, so power series can be evaluated at it. -/
  generator_hasEval :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    letI : IsNonarchimedeanLocalField field := localFieldData.localField
    PowerSeries.HasEval (generator : field)
  /-- The integral lift of the division point. -/
  integralGenerator :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    RingOfIntegers field
  /-- The integral lift has the prescribed underlying element. -/
  integralGenerator_val :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    ((integralGenerator : RingOfIntegers field) : field) = generator
  /-- The coefficient embedding `𝒪_K → 𝒪_{K_m}`. -/
  integerAlgebraMap :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    RingOfIntegers K →+* RingOfIntegers field
  /-- The integral coefficient embedding is the restriction of the field algebra map. -/
  integerAlgebraMap_apply :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    ∀ x : RingOfIntegers K,
      (((integerAlgebraMap x : RingOfIntegers field) : field)) =
        algebraMap (RingOfIntegers K) field x
  /-- The literal integral-generation equation `𝒪_{K_m}=𝒪_K[α_m]`. -/
  ringOfIntegers_eq_adjoin :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    letI : Algebra (RingOfIntegers K) (RingOfIntegers field) :=
      integerAlgebraMap.toAlgebra
    Algebra.adjoin (RingOfIntegers K) {integralGenerator} = ⊤
  /-- Equivalently, every integral element has polynomial coordinates in `α_m`. -/
  integral_polynomial_coordinates :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    ∀ x : RingOfIntegers field, ∃ p : Polynomial (RingOfIntegers K),
      p.eval₂ (algebraMap (RingOfIntegers K) field) generator = (x : field)
  /-- Degree `(q-1)q^(m-1)`. -/
  degree :
    letI : FiniteDimensional K field := finiteDimensional
    Module.finrank K field =
      (residueCard K - 1) * residueCard K ^ (m - 1)
  /-- The ramification index is the full field degree. -/
  totallyRamified :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    letI : IsNonarchimedeanLocalField field := localFieldData.localField
    letI : ValuativeExtension K field := localFieldData.valuativeExtension
    ramificationIndex K field = Module.finrank K field
  /-- Equivalently, the residue degree is one. -/
  residueDegree_eq_one :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    letI : IsNonarchimedeanLocalField field := localFieldData.localField
    letI : ValuativeExtension K field := localFieldData.valuativeExtension
    residueDegree K field = 1
  /-- Evaluation at `α_m`, bundled as the actual convergent ring homomorphism. -/
  evaluation : PowerSeries (RingOfIntegers K) →+* field
  /-- The evaluation homomorphism is the convergent coefficientwise sum at `α_m`. -/
  evaluation_apply :
    letI : FiniteDimensional K field := finiteDimensional
    letI : ValuativeRel field := localFieldData.valuativeRel
    letI : TopologicalSpace field := localFieldData.topology
    letI : IsNonarchimedeanLocalField field := localFieldData.localField
    ∀ g, evaluation g = ∑' n : ℕ,
      algebraMap (RingOfIntegers K) field (PowerSeries.coeff n g) * generator ^ n

/-- L02 data for all positive levels, with literal inclusions and compatible generators. -/
structure LubinTateTower (π : Uniformizer K) where
  /-- The level at every positive integer. -/
  level : ∀ (m : ℕ), 1 ≤ m → LubinTateLevel K Ksep π m
  /-- Consecutive levels are contained in one another in the fixed separable closure. -/
  field_le : ∀ (m : ℕ) (hm : 1 ≤ m),
    (level m hm).field ≤ (level (m + 1) (Nat.succ_pos m)).field
  /-- Compatible division points satisfy `f(α_{m+1})=α_m` in the ambient closure. -/
  generator_compatible : ∀ (m : ℕ) (hm : 1 ≤ m),
    ((lubinTatePolynomial K π).map (algebraMap (RingOfIntegers K) Ksep)).eval
        (((level (m + 1) (Nat.succ_pos m)).generator :
          (level (m + 1) (Nat.succ_pos m)).field) : Ksep) =
      (((level m hm).generator : (level m hm).field) : Ksep)

private theorem torsion_one_lt_residueCard : 1 < residueCard K := by
  letI := Fintype.ofFinite (LocalResidueField K)
  change 1 < Nat.card (LocalResidueField K)
  rw [Nat.card_eq_fintype_card]
  exact Fintype.one_lt_card

private theorem torsion_uniformizerInteger_ne_zero (π : Uniformizer K) :
    uniformizerInteger K π ≠ 0 := by
  intro h
  apply π.val.ne_zero
  rw [← (uniformizer_integer_exists K π).choose_spec]
  exact congr_arg (fun x : RingOfIntegers K => (x : K)) h

private theorem torsion_normalizedValuation_inv (x : Units K) :
    normalizedValuation K x⁻¹ = -normalizedValuation K x := by
  simp [normalizedValuation]

private theorem torsion_isUnit_of_normalizedValuation_eq_zero
    (a : RingOfIntegers K) (ha : (a : K) ≠ 0)
    (hval : normalizedValuation K (Units.mk0 (a : K) ha) = 0) : IsUnit a := by
  let x : Units K := Units.mk0 (a : K) ha
  have hxinv : normalizedValuation K x⁻¹ = 0 := by
    rw [torsion_normalizedValuation_inv K, hval, neg_zero]
  obtain ⟨b, hb⟩ := (exists_normalizedValuationHom K).choose_spec.2 x⁻¹ |>.1 hxinv.ge
  let u : Units (RingOfIntegers K) :=
    { val := a
      inv := b
      val_inv := by
        apply Subtype.ext
        change (a : K) * (b : K) = 1
        rw [hb]
        exact mul_inv_cancel₀ ha
      inv_val := by
        apply Subtype.ext
        change (b : K) * (a : K) = 1
        rw [hb]
        exact inv_mul_cancel₀ ha }
  exact ⟨u, rfl⟩

private theorem torsion_uniformizerInteger_irreducible (π : Uniformizer K) :
    Irreducible (uniformizerInteger K π) := by
  let p := uniformizerInteger K π
  have hp : (p : K) = (π.val : K) := (uniformizer_integer_exists K π).choose_spec
  refine irreducible_iff.mpr ⟨?_, ?_⟩
  · intro hunit
    obtain ⟨u, hu⟩ := hunit
    have huval : normalizedValuation K
        (Units.map (algebraMap (RingOfIntegers K) K) u) = 0 := by
      have hnonneg : 0 ≤ normalizedValuation K
          (Units.map (algebraMap (RingOfIntegers K) K) u) :=
        (exists_normalizedValuationHom K).choose_spec.2 _ |>.2 ⟨u, rfl⟩
      have hinvnonneg : 0 ≤ normalizedValuation K
          (Units.map (algebraMap (RingOfIntegers K) K) u)⁻¹ :=
        (exists_normalizedValuationHom K).choose_spec.2 _ |>.2
          ⟨(u⁻¹ : Units (RingOfIntegers K)), rfl⟩
      rw [torsion_normalizedValuation_inv K] at hinvnonneg
      omega
    have heq : Units.map (algebraMap (RingOfIntegers K) K) u = π.val := by
      apply Units.ext
      change (((u : Units (RingOfIntegers K)) : RingOfIntegers K) : K) = (π.val : K)
      rw [hu, hp]
    rw [heq, π.valuation_eq_one] at huval
    omega
  · intro a b hab
    have ha0 : (a : K) ≠ 0 := by
      intro ha
      have : (p : K) = 0 := by
        change ((uniformizerInteger K π : RingOfIntegers K) : K) = 0
        rw [hab]
        simp [ha]
      apply π.val.ne_zero
      rw [← hp]
      exact this
    have hb0 : (b : K) ≠ 0 := by
      intro hb
      have : (p : K) = 0 := by
        change ((uniformizerInteger K π : RingOfIntegers K) : K) = 0
        rw [hab]
        simp [hb]
      apply π.val.ne_zero
      rw [← hp]
      exact this
    let ua : Units K := Units.mk0 (a : K) ha0
    let ub : Units K := Units.mk0 (b : K) hb0
    have hva : 0 ≤ normalizedValuation K ua :=
      (exists_normalizedValuationHom K).choose_spec.2 _ |>.2 ⟨a, rfl⟩
    have hvb : 0 ≤ normalizedValuation K ub :=
      (exists_normalizedValuationHom K).choose_spec.2 _ |>.2 ⟨b, rfl⟩
    have huv : ua * ub = π.val := by
      apply Units.ext
      simpa [ua, ub, ← hp] using congr_arg Subtype.val hab.symm
    have hvsum : normalizedValuation K ua + normalizedValuation K ub = 1 := by
      rw [← normalizedValuation_mul, huv, π.valuation_eq_one]
    rcases (show normalizedValuation K ua = 0 ∨ normalizedValuation K ub = 0 by omega) with
      ha | hb
    · exact Or.inl (torsion_isUnit_of_normalizedValuation_eq_zero K a ha0 ha)
    · exact Or.inr (torsion_isUnit_of_normalizedValuation_eq_zero K b hb0 hb)

private theorem torsion_maximalIdeal_eq_span (π : Uniformizer K) :
    Ideal.span ({uniformizerInteger K π} : Set (RingOfIntegers K)) =
      LocalMaximalIdeal K :=
  (torsion_uniformizerInteger_irreducible K π).maximalIdeal_eq.symm

private theorem torsion_uniformizerInteger_mem_maximalIdeal (π : Uniformizer K) :
    uniformizerInteger K π ∈ LocalMaximalIdeal K := by
  rw [← torsion_maximalIdeal_eq_span K π]
  exact Ideal.mem_span_singleton.mpr (dvd_refl _)

private theorem lubinTatePolynomial_monic_natDegree (π : Uniformizer K) :
    (lubinTatePolynomial K π).Monic ∧
      (lubinTatePolynomial K π).natDegree = residueCard K := by
  have hp := torsion_uniformizerInteger_ne_zero K π
  have hq := torsion_one_lt_residueCard K
  have hm : (lubinTatePolynomial K π).Monic := by
    rw [lubinTatePolynomial]
    apply (Polynomial.monic_X_pow (residueCard K)).add_of_right
    rw [Polynomial.degree_C_mul_X hp, Polynomial.degree_X_pow]
    exact_mod_cast hq
  refine ⟨hm, ?_⟩
  rw [lubinTatePolynomial]
  rw [Polynomial.natDegree_add_eq_right_of_natDegree_lt]
  · rw [Polynomial.natDegree_X_pow]
  · rw [Polynomial.natDegree_C_mul_X _ hp, Polynomial.natDegree_X_pow]
    exact hq

private theorem lubinTateIterate_monic_natDegree (π : Uniformizer K) (n : ℕ) :
    (lubinTateIterate K π n).Monic ∧
      (lubinTateIterate K π n).natDegree = residueCard K ^ n := by
  induction n with
  | zero => simp [lubinTateIterate]
  | succ n ih =>
      have hf := lubinTatePolynomial_monic_natDegree K π
      constructor
      · rw [lubinTateIterate]
        exact hf.1.comp ih.1 (by
          rw [ih.2]
          exact pow_ne_zero _
            (Nat.ne_of_gt (Nat.zero_lt_one.trans (torsion_one_lt_residueCard K))))
      · rw [lubinTateIterate, Polynomial.natDegree_comp, hf.2, ih.2, pow_succ']

private theorem lubinTateIterate_eval_zero (π : Uniformizer K) (n : ℕ) :
    (lubinTateIterate K π n).eval 0 = 0 := by
  induction n with
  | zero => simp [lubinTateIterate]
  | succ n ih =>
      rw [lubinTateIterate, Polynomial.eval_comp, ih, lubinTatePolynomial]
      simp [Nat.ne_of_gt (Nat.zero_lt_one.trans (torsion_one_lt_residueCard K))]

private theorem primitiveDivisionPolynomial_monic_natDegree
    (π : Uniformizer K) (m : ℕ) (_hm : 1 ≤ m) :
    (primitiveDivisionPolynomial K π m).Monic ∧
      (primitiveDivisionPolynomial K π m).natDegree =
        (residueCard K - 1) * residueCard K ^ (m - 1) := by
  let d := (residueCard K - 1) * residueCard K ^ (m - 1)
  have hp := torsion_uniformizerInteger_ne_zero K π
  have hq := torsion_one_lt_residueCard K
  have hi := lubinTateIterate_monic_natDegree K π (m - 1)
  have hpow : ((lubinTateIterate K π (m - 1)) ^ (residueCard K - 1)).Monic :=
    hi.1.pow _
  have hd : 0 < d :=
    mul_pos (Nat.sub_pos_of_lt hq) (pow_pos (Nat.zero_lt_one.trans hq) _)
  have hmonic : (primitiveDivisionPolynomial K π m).Monic := by
    rw [primitiveDivisionPolynomial]
    apply hpow.add_of_right
    rw [Polynomial.degree_C hp,
      Polynomial.degree_eq_natDegree hpow.ne_zero,
      Polynomial.natDegree_pow, hi.2]
    exact_mod_cast hd
  refine ⟨hmonic, ?_⟩
  rw [primitiveDivisionPolynomial,
    Polynomial.natDegree_add_eq_right_of_natDegree_lt]
  · rw [Polynomial.natDegree_pow, hi.2]
  · rw [Polynomial.natDegree_C, Polynomial.natDegree_pow, hi.2]
    exact hd

private theorem primitiveDivisionPolynomial_coeff_zero (π : Uniformizer K) (m : ℕ) :
    (primitiveDivisionPolynomial K π m).coeff 0 = uniformizerInteger K π := by
  rw [Polynomial.coeff_zero_eq_eval_zero, primitiveDivisionPolynomial,
    Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_pow,
    lubinTateIterate_eval_zero K π]
  rw [zero_pow (Nat.sub_ne_zero_of_lt (torsion_one_lt_residueCard K))]
  exact add_zero _

private theorem lubinTateIterate_map_residue (π : Uniformizer K)
    (hp : uniformizerInteger K π ∈ LocalMaximalIdeal K) (n : ℕ) :
    (lubinTateIterate K π n).map (Ideal.Quotient.mk (LocalMaximalIdeal K)) =
      Polynomial.X ^ (residueCard K ^ n) := by
  induction n with
  | zero => simp [lubinTateIterate]
  | succ n ih =>
      rw [lubinTateIterate, Polynomial.map_comp, ih, lubinTatePolynomial]
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
        Ideal.Quotient.eq_zero_iff_mem.mpr hp, Polynomial.C_0, zero_mul, zero_add,
        Polynomial.map_pow]
      rw [Polynomial.X_pow_comp, ← pow_mul, pow_succ', Nat.mul_comm]

private theorem primitiveDivisionPolynomial_map_residue (π : Uniformizer K) (m : ℕ) :
    (primitiveDivisionPolynomial K π m).map
        (Ideal.Quotient.mk (LocalMaximalIdeal K)) =
      Polynomial.X ^ ((residueCard K - 1) * residueCard K ^ (m - 1)) := by
  rw [primitiveDivisionPolynomial, Polynomial.map_add, Polynomial.map_C,
    Ideal.Quotient.eq_zero_iff_mem.mpr
      (torsion_uniformizerInteger_mem_maximalIdeal K π),
    Polynomial.C_0, zero_add, Polynomial.map_pow,
    lubinTateIterate_map_residue K π (torsion_uniformizerInteger_mem_maximalIdeal K π)]
  rw [← pow_mul, Nat.mul_comm]

private theorem primitiveDivisionPolynomial_coeff_mem
    (π : Uniformizer K) (m n : ℕ) (hm : 1 ≤ m)
    (hn : n < (primitiveDivisionPolynomial K π m).natDegree) :
    (primitiveDivisionPolynomial K π m).coeff n ∈ LocalMaximalIdeal K := by
  have hdeg := (primitiveDivisionPolynomial_monic_natDegree K π m hm).2
  have hn' : n < (residueCard K - 1) * residueCard K ^ (m - 1) := hdeg ▸ hn
  have hcoeff := congr_arg (fun P : Polynomial
      (RingOfIntegers K ⧸ LocalMaximalIdeal K) => P.coeff n)
    (primitiveDivisionPolynomial_map_residue K π m)
  rw [Polynomial.coeff_map] at hcoeff
  have hne : n ≠ (residueCard K - 1) * residueCard K ^ (m - 1) := ne_of_lt hn'
  simp only [Polynomial.coeff_X_pow, if_neg hne] at hcoeff
  exact Ideal.Quotient.eq_zero_iff_mem.mp hcoeff

private theorem primitiveDivisionPolynomial_coeff_zero_notMem_sq
    (π : Uniformizer K) (m : ℕ) :
    (primitiveDivisionPolynomial K π m).coeff 0 ∉ LocalMaximalIdeal K ^ 2 := by
  rw [primitiveDivisionPolynomial_coeff_zero K π m,
    ← torsion_maximalIdeal_eq_span K π,
    Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  intro h
  rcases h with ⟨c, hc⟩
  have hp := torsion_uniformizerInteger_ne_zero K π
  have hone : 1 = uniformizerInteger K π * c := by
    apply mul_left_cancel₀ hp
    calc
      uniformizerInteger K π * 1 = uniformizerInteger K π := mul_one _
      _ = uniformizerInteger K π ^ 2 * c := hc
      _ = uniformizerInteger K π * (uniformizerInteger K π * c) := by
        rw [pow_two, mul_assoc]
  apply (torsion_uniformizerInteger_irreducible K π).not_isUnit
  rw [isUnit_iff_exists_inv]
  exact ⟨c, hone.symm⟩

private theorem lubinTateIterate_factor_primitive
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    lubinTateIterate K π m = lubinTateIterate K π (m - 1) *
      primitiveDivisionPolynomial K π m := by
  have hq : 0 < residueCard K :=
    Nat.zero_lt_one.trans (torsion_one_lt_residueCard K)
  conv_lhs => rw [show m = (m - 1) + 1 by omega, lubinTateIterate]
  rw [lubinTatePolynomial, primitiveDivisionPolynomial]
  simp only [Polynomial.add_comp, Polynomial.mul_comp, Polynomial.C_comp,
    Polynomial.X_comp, Polynomial.pow_comp]
  have hpow : lubinTateIterate K π (m - 1) ^ residueCard K =
      lubinTateIterate K π (m - 1) ^ (residueCard K - 1) *
        lubinTateIterate K π (m - 1) := by
    rw [← pow_succ, Nat.sub_add_cancel hq]
  rw [hpow, mul_add]
  ac_rfl

private theorem primitiveDivisionPolynomial_isRoot_iff
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) (x : Ksep) :
    ((primitiveDivisionPolynomial K π m).map
      (algebraMap (RingOfIntegers K) Ksep)).IsRoot x ↔
        IsPrimitiveLubinTateDivisionPoint K Ksep π m x := by
  let φ := algebraMap (RingOfIntegers K) Ksep
  let A := (lubinTateIterate K π (m - 1)).map φ
  let B := (primitiveDivisionPolynomial K π m).map φ
  have hfactor : (lubinTateIterate K π m).map φ = A * B := by
    rw [lubinTateIterate_factor_primitive K π m hm, Polynomial.map_mul]
  have hpφ : φ (uniformizerInteger K π) ≠ 0 := by
    intro h
    apply torsion_uniformizerInteger_ne_zero K π
    have h' : algebraMap K Ksep ((uniformizerInteger K π : RingOfIntegers K) : K) = 0 := by
      change algebraMap (RingOfIntegers K) Ksep (uniformizerInteger K π) = 0 at h
      rw [IsScalarTower.algebraMap_apply (RingOfIntegers K) K Ksep] at h
      exact h
    apply Subtype.ext
    exact (algebraMap K Ksep).injective (by simpa using h')
  constructor
  · intro hB
    refine ⟨?_, ?_⟩
    · rw [hfactor, Polynomial.IsRoot.def, Polynomial.eval_mul]
      rw [show Polynomial.eval x B = 0 from hB]
      exact mul_zero _
    · intro hA
      have hBeval : Polynomial.eval x B = φ (uniformizerInteger K π) := by
        rw [show B = (primitiveDivisionPolynomial K π m).map φ from rfl,
          primitiveDivisionPolynomial, Polynomial.map_add, Polynomial.map_C,
          Polynomial.map_pow, Polynomial.eval_add, Polynomial.eval_C,
          Polynomial.eval_pow]
        rw [show Polynomial.eval x ((lubinTateIterate K π (m - 1)).map φ) = 0 from hA]
        rw [zero_pow (Nat.sub_ne_zero_of_lt (torsion_one_lt_residueCard K)), add_zero]
      have hBzero : Polynomial.eval x B = 0 := hB
      rw [hBeval] at hBzero
      exact hpφ hBzero
  · rintro ⟨hmroot, hnotprev⟩
    rw [show (primitiveDivisionPolynomial K π m).map φ = B from rfl,
      Polynomial.IsRoot.def]
    have hprod : Polynomial.eval x A * Polynomial.eval x B = 0 := by
      rw [← Polynomial.eval_mul, ← hfactor]
      exact hmroot
    exact (mul_eq_zero.mp hprod).resolve_left hnotprev

/--
**L02**, Lemma `lem:lt-eisenstein`: `Q_m` is Eisenstein of the claimed degree and its roots
are exactly the primitive level-`m` division points.
-/
theorem primitiveDivisionPolynomial_eisenstein
    (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m) :
    (primitiveDivisionPolynomial K π m).IsEisensteinAt (LocalMaximalIdeal K) ∧
      (primitiveDivisionPolynomial K π m).natDegree =
        (residueCard K - 1) * residueCard K ^ (m - 1) ∧
      ∀ x : Ksep,
        ((primitiveDivisionPolynomial K π m).map
          (algebraMap (RingOfIntegers K) Ksep)).IsRoot x ↔
            IsPrimitiveLubinTateDivisionPoint K Ksep π m x := by
  have hmd := primitiveDivisionPolynomial_monic_natDegree K π m hm
  refine ⟨hmd.1.isEisensteinAt_of_mem_of_notMem
    (Ideal.IsPrime.ne_top (IsLocalRing.maximalIdeal.isMaximal _).isPrime)
    (fun {n} hn => primitiveDivisionPolynomial_coeff_mem K π m n hm hn)
    (primitiveDivisionPolynomial_coeff_zero_notMem_sq K π m), hmd.2, ?_⟩
  exact primitiveDivisionPolynomial_isRoot_iff K Ksep π m hm

private theorem lubinTateIterate_coeff_zero (π : Uniformizer K) (n : ℕ) :
    (lubinTateIterate K π n).coeff 0 = 0 := by
  rw [Polynomial.coeff_zero_eq_eval_zero, lubinTateIterate_eval_zero K π n]

open scoped NNReal in
set_option maxHeartbeats 1000000 in
private theorem lubinTateLevel_exists_of_root (π : Uniformizer K) (m : ℕ) (hm : 1 ≤ m)
    (α : Ksep)
    (hα : ((primitiveDivisionPolynomial K π m).map
      (algebraMap (RingOfIntegers K) Ksep)).IsRoot α) :
    ∃ L : LubinTateLevel K Ksep π m,
      (((L.generator : L.field) : Ksep)) = α := by
  let P := primitiveDivisionPolynomial K π m
  let E : IntermediateField K Ksep := IntermediateField.adjoin K {α}
  let g : E := ⟨α, IntermediateField.mem_adjoin_simple_self K α⟩
  have hP := primitiveDivisionPolynomial_eisenstein K Ksep π m hm
  have hq : 1 < residueCard K := by
    letI := Fintype.ofFinite (LocalResidueField K)
    change 1 < Nat.card (LocalResidueField K)
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hPmonic : P.Monic := (primitiveDivisionPolynomial_monic_natDegree K π m hm).1
  have hdpos : 0 < P.natDegree := by
    rw [hP.2.1]
    exact mul_pos (Nat.sub_pos_of_lt hq) (pow_pos (Nat.zero_lt_one.trans hq) _)
  have hPirr : Irreducible P := hP.1.irreducible
    (IsLocalRing.maximalIdeal.isMaximal _).isPrime hPmonic.isPrimitive hdpos
  let PK := P.map (algebraMap (RingOfIntegers K) K)
  have hPKmonic : PK.Monic := hPmonic.map _
  have hPKirr : Irreducible PK :=
    hPmonic.irreducible_iff_irreducible_map_fraction_map.mp hPirr
  have hPKroot_sep : PK.map (algebraMap K Ksep) |>.IsRoot α := by
    dsimp only [PK]
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq
      (RingOfIntegers K) K Ksep]
    exact hα
  have hαint : IsIntegral K α := by
    refine ⟨PK, hPKmonic, ?_⟩
    simpa [Polynomial.eval_map] using hPKroot_sep
  letI : FiniteDimensional K E := IntermediateField.adjoin.finiteDimensional hαint
  have hPKroot : Polynomial.aeval g PK = 0 := by
    apply (algebraMap E Ksep).injective
    rw [map_zero, Polynomial.aeval_def, Polynomial.hom_eval₂,
      ← IsScalarTower.algebraMap_eq K E Ksep]
    simpa [g, Polynomial.eval_map] using hPKroot_sep
  have hminK : PK = minpoly K g :=
    minpoly.eq_of_irreducible_of_monic hPKirr hPKroot hPKmonic
  have hminSep : PK = minpoly K α :=
    minpoly.eq_of_irreducible_of_monic hPKirr
      (by simpa [Polynomial.aeval_def, Polynomial.eval_map] using hPKroot_sep) hPKmonic
  have hdegree : Module.finrank K E =
      (residueCard K - 1) * residueCard K ^ (m - 1) := by
    rw [IntermediateField.adjoin.finrank hαint, ← hminSep]
    dsimp only [PK]
    rw [Polynomial.Monic.natDegree_map hPmonic, hP.2.1]
  letI := IsTopologicalAddGroup.rightUniformSpace K
  letI := isUniformAddGroup_of_addCommGroup (G := K)
  letI : (Valued.v (R := K) (Γ₀ := ValuativeRel.ValueGroupWithZero K)).RankOne :=
    { hom' := ValuativeRel.IsRankLeOne.nonempty.some.emb (R := K).comp
        MonoidWithZeroHom.ValueGroup₀.embedding
      strictMono' := ValuativeRel.IsRankLeOne.nonempty.some.strictMono.comp
        MonoidWithZeroHom.ValueGroup₀.embedding_strictMono }
  letI : NontriviallyNormedField K :=
    Valued.toNontriviallyNormedField K (ValuativeRel.ValueGroupWithZero K)
  letI : NontriviallyNormedField E := spectralNorm.nontriviallyNormedField K E
  letI : NormedAlgebra K E := spectralNorm.normedAlgebra K E
  letI : IsUltrametricDist E :=
    IsUltrametricDist.isUltrametricDist_of_isNonarchimedean_norm
      (isNonarchimedean_spectralNorm (K := K) (L := E))
  let vE : Valuation E ℝ≥0 := NormedField.valuation (K := E)
  let vrE : ValuativeRel E := ValuativeRel.ofValuation vE
  let topE : TopologicalSpace E := inferInstance
  letI : ValuativeRel E := vrE
  letI : vE.Compatible := Valuation.Compatible.ofValuation vE
  letI : TopologicalSpace E := topE
  letI : Valued E ℝ≥0 := NormedField.toValued
  have hvt : IsValuativeTopology E := by
    apply IsValuativeTopology.of_mem_nhds_zero_iff_vle vE
    exact fun {s} => Valued.is_topological_valuation s
  letI : IsValuativeTopology E := hvt
  have hlc : LocallyCompactSpace E :=
    LocallyCompactSpace.of_finiteDimensional_of_complete K E
  letI : LocallyCompactSpace E := hlc
  have hnt : ValuativeRel.IsNontrivial E := by
    rw [ValuativeRel.isNontrivial_iff_isNontrivial vE]
