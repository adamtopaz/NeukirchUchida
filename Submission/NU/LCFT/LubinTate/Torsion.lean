    have hxnorm : ‖x‖ ≤ 1 := by
      change spectralNorm K E x ≤ 1
      exact hxspec.trans hspec
    have hxv : vE x ≤ vE 1 := by
      change ‖x‖₊ ≤ ‖(1 : E)‖₊
      exact NNReal.coe_le_coe.mp (by simpa using hxnorm)
    have hxrel : x ≤ᵥ (1 : E) :=
      (Valuation.Compatible.vle_iff_le (v := vE) x 1).mpr hxv
    refine ⟨⟨x, ?_⟩, rfl⟩
    exact (Valuation.Compatible.vle_iff_le
      (v := ValuativeRel.valuation E) x 1).mp hxrel
  have hPg : Polynomial.eval₂ (algebraMap (RingOfIntegers K) E) g P = 0 := by
    have h := hPKroot
    rw [Polynomial.aeval_def] at h
    dsimp only [PK] at h
    rw [Polynomial.eval₂_map,
      ← IsScalarTower.algebraMap_eq (RingOfIntegers K) K E] at h
    exact h
  have hgint : IsIntegral (RingOfIntegers K) g := ⟨P, hPmonic, hPg⟩
  obtain ⟨gO, hgOval⟩ := integer_of_integral g hgint
  have hminO : P = minpoly (RingOfIntegers K) g := by
    apply Polynomial.map_injective (algebraMap (RingOfIntegers K) K)
