import Submission.NU.LCFT.Cohomology.Inhomogeneous

/-!
# Concrete low-degree Tate cohomology

This file exposes the concrete quotients in degrees `0` and `-1`, the Mathlib Tate object in
degree `-2`, and the `H₁(G,ℤ) = Gᵃᵇ` bridge.  All categorical statements remain tied to
Mathlib's `tateCohomology`.
-/

namespace NU.LCFT

noncomputable section

open CategoryTheory

namespace TateLowDegree

variable {G : Type} [Group G] [Fintype G]

/-- The representation norm as an additive homomorphism. -/
def normAddHom (M : Rep ℤ G) : M →+ M where
  toFun := M.norm.hom
  map_zero' := map_zero M.norm.hom
  map_add' := map_add M.norm.hom

/-- The augmentation subgroup generated by elements `g • a - a`. -/
def augmentation (M : Rep ℤ G) : AddSubgroup M :=
  AddSubgroup.closure {z | ∃ (g : G) (a : M), z = M.ρ g a - a}

/-- The norm range, viewed in the invariant subgroup. -/
def normRangeInInvariants (M : Rep ℤ G) : AddSubgroup (Inhomogeneous.invariants0 M) :=
  (normAddHom M).range.comap (Inhomogeneous.invariants0 M).subtype

/-- The concrete quotient `Aᴳ / N_G A`. -/
abbrev H0 (M : Rep ℤ G) :=
  Inhomogeneous.invariants0 M ⧸ normRangeInInvariants M

/-- The kernel of the representation norm. -/
def normKernel (M : Rep ℤ G) : AddSubgroup M :=
  (normAddHom M).ker

/-- The augmentation subgroup, viewed inside the norm kernel. -/
def augmentationInNormKernel (M : Rep ℤ G) : AddSubgroup (normKernel M) :=
  (augmentation M).comap (normKernel M).subtype

/-- The concrete quotient `ker N_G / I_G A`. -/
abbrev HMinusOne (M : Rep ℤ G) :=
  normKernel M ⧸ augmentationInNormKernel M

/--
The degree `-2` Tate object.  Unlike degrees `0` and `-1`, this remains Mathlib's complete
resolution object, since it is used by both connecting maps.
-/
abbrev HMinusTwo (M : Rep ℤ G) := tateCohomology M (-2)

/-- The named comparison from the concrete degree-zero quotient to Mathlib Tate cohomology. -/
noncomputable def comparisonH0Tate (M : Rep ℤ G) :
    H0 M ≃+ tateCohomology M 0 := by
  have hd : (groupCohomology.cochainsIso₀ M).hom ≫ groupCohomology.d₀₁ M =
      ((tateComplex M).sc' ((-1 : ℤ)) 0 1).g ≫
        (groupCohomology.cochainsIso₁ M).hom := by
    exact groupCohomology.comp_d₀₁_eq M
  letI : Module ℤ (LinearMap.ker
      ((tateComplex M).sc' ((-1 : ℤ)) 0 1).g.hom) :=
    (LinearMap.ker ((tateComplex M).sc' ((-1 : ℤ)) 0 1).g.hom).module
  let e : Inhomogeneous.invariants0 M ≃+
      LinearMap.ker ((tateComplex M).sc' ((-1 : ℤ)) 0 1).g.hom :=
    { toFun := fun x => ⟨(groupCohomology.cochainsIso₀ M).inv x, by
          rw [LinearMap.mem_ker]
          apply (ModuleCat.mono_iff_injective
            (groupCohomology.cochainsIso₁ M).hom).1 inferInstance
          calc
            _ = groupCohomology.d₀₁ M
                ((groupCohomology.cochainsIso₀ M).hom
                  ((groupCohomology.cochainsIso₀ M).inv x)) :=
              (ConcreteCategory.congr_hom hd
                ((groupCohomology.cochainsIso₀ M).inv x)).symm
            _ = groupCohomology.d₀₁ M x := by
              rw [(groupCohomology.cochainsIso₀ M).inv_hom_id_apply]
            _ = 0 := by
              ext g
              change M.ρ g x - x = 0
              rw [x.2 g, sub_self]
            _ = (groupCohomology.cochainsIso₁ M).hom 0 := (map_zero _).symm⟩
      invFun := fun x => ⟨(groupCohomology.cochainsIso₀ M).hom x.1, fun g => by
          have hx : ((tateComplex M).sc' ((-1 : ℤ)) 0 1).g x.1 = 0 := by
            simpa only [LinearMap.mem_ker] using x.2
          have hcomp := ConcreteCategory.congr_hom hd x.1
          have hd0 : groupCohomology.d₀₁ M
              ((groupCohomology.cochainsIso₀ M).hom x.1) = 0 := by
            calc
              _ = (ConcreteCategory.hom
                    ((groupCohomology.cochainsIso₀ M).hom ≫
                      groupCohomology.d₀₁ M)) x.1 := rfl
              _ = (ConcreteCategory.hom
                    (((tateComplex M).sc' ((-1 : ℤ)) 0 1).g ≫
                      (groupCohomology.cochainsIso₁ M).hom)) x.1 := hcomp
              _ = (groupCohomology.cochainsIso₁ M).hom
                    (((tateComplex M).sc' ((-1 : ℤ)) 0 1).g x.1) := rfl
              _ = (groupCohomology.cochainsIso₁ M).hom 0 := congr_arg _ hx
              _ = 0 := map_zero _
          have h := congr_fun hd0 g
          change M.ρ g ((groupCohomology.cochainsIso₀ M).hom x.1) -
            (groupCohomology.cochainsIso₀ M).hom x.1 = 0 at h
          exact sub_eq_zero.mp h⟩
      left_inv := fun x => by
        apply Subtype.ext
        exact (groupCohomology.cochainsIso₀ M).inv_hom_id_apply x
      right_inv := fun x => by
        apply Subtype.ext
        exact (groupCohomology.cochainsIso₀ M).hom_inv_id_apply x.1
      map_add' := fun x y => by
        apply Subtype.ext
        exact (groupCohomology.cochainsIso₀ M).inv.hom.toAddMonoidHom.map_add x y }
  let eNeg := (TateCohomology.tateComplex.evalNeg 0).app M ≪≫
    groupHomology.chainsIso₀ M
  have hn : eNeg.hom ≫ M.norm.toModuleCatHom =
      ((tateComplex M).sc' ((-1 : ℤ)) 0 1).f ≫
        (groupCohomology.cochainsIso₀ M).hom := by
    change (groupHomology.chainsIso₀ M).hom ≫ M.norm.toModuleCatHom =
      M.tateNorm ≫ (groupCohomology.cochainsIso₀ M).hom
    simp only [Rep.tateNorm]
    simp
  let N := normRangeInInvariants M
  let P := (LinearMap.range
    ((tateComplex M).sc' ((-1 : ℤ)) 0 1).moduleCatToCycles).toAddSubgroup
  have heN : N ≤ P.comap e.toAddMonoidHom := by
    rintro x ⟨a, ha⟩
    refine ⟨eNeg.inv a, ?_⟩
    apply Subtype.ext
    apply (ModuleCat.mono_iff_injective
      (groupCohomology.cochainsIso₀ M).hom).1 inferInstance
    have hna := ConcreteCategory.congr_hom hn (eNeg.inv a)
    calc
      _ = M.norm.hom (eNeg.hom (eNeg.inv a)) := hna.symm
      _ = M.norm.hom a := by rw [eNeg.inv_hom_id_apply]
      _ = x := ha
      _ = (groupCohomology.cochainsIso₀ M).hom
          ((groupCohomology.cochainsIso₀ M).inv x) :=
        ((groupCohomology.cochainsIso₀ M).inv_hom_id_apply x).symm
  have heP : P ≤ N.comap e.symm.toAddMonoidHom := by
    rintro x ⟨a, ha⟩
    refine ⟨eNeg.hom a, ?_⟩
    have hna := ConcreteCategory.congr_hom hn a
    change M.norm.hom (eNeg.hom a) =
      (groupCohomology.cochainsIso₀ M).hom x.1
    calc
      _ = (ConcreteCategory.hom
            (eNeg.hom ≫ M.norm.toModuleCatHom)) a := rfl
      _ = (ConcreteCategory.hom
            (((tateComplex M).sc' ((-1 : ℤ)) 0 1).f ≫
              (groupCohomology.cochainsIso₀ M).hom)) a := hna
      _ = (groupCohomology.cochainsIso₀ M).hom
            (((tateComplex M).sc' ((-1 : ℤ)) 0 1).f a) := rfl
      _ = (groupCohomology.cochainsIso₀ M).hom x.1 := by
        congr 1
        exact congr_arg Subtype.val ha
  let q := QuotientAddGroup.map N P e.toAddMonoidHom heN
  let qi := QuotientAddGroup.map P N e.symm.toAddMonoidHom heP
  have hqi_q : Function.LeftInverse qi q := by
    intro x
    induction x using QuotientAddGroup.induction_on with
    | H x =>
      dsimp [q, qi]
      exact congr_arg (QuotientAddGroup.mk' N) (e.left_inv x)
  have hq_qi : Function.RightInverse qi q := by
    intro x
    induction x using QuotientAddGroup.induction_on with
    | H x =>
      dsimp [q, qi]
      exact congr_arg (QuotientAddGroup.mk' P) (e.right_inv x)
  let eq := AddEquiv.ofBijective q ⟨hqi_q.injective, hq_qi.surjective⟩
  let eSc := (tateComplex M).isoSc' ((-1 : ℤ)) 0 1 (by simp) (by simp)
  let et : tateCohomology M 0 ≅
      ((tateComplex M).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData.H :=
    (ShortComplex.leftHomologyIso ((tateComplex M).sc 0)).symm ≪≫
      ShortComplex.leftHomologyMapIso' eSc _
        ((tateComplex M).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData
  exact eq.trans et.symm.toLinearEquiv.toAddEquiv

/-- The concrete degree-zero quotient agrees with Mathlib Tate cohomology. -/
theorem H0_equiv_tate (M : Rep ℤ G) :
    Nonempty (H0 M ≃+ tateCohomology M 0) :=
  ⟨comparisonH0Tate M⟩

/-- The concrete degree-minus-one quotient agrees with Mathlib Tate cohomology. -/
theorem HMinusOne_equiv_tate (M : Rep ℤ G) :
    Nonempty (HMinusOne M ≃+ tateCohomology M (-1)) := by
  let e0 := (TateCohomology.tateComplex.evalNeg 0).app M ≪≫
    groupHomology.chainsIso₀ M
  let eOut := (TateCohomology.tateComplex.evalNonneg 0).app M ≪≫
    groupCohomology.cochainsIso₀ M
  have hn : e0.hom ≫ M.norm.toModuleCatHom =
      ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g ≫ eOut.hom := by
    change (groupHomology.chainsIso₀ M).hom ≫ M.norm.toModuleCatHom =
      M.tateNorm ≫ (groupCohomology.cochainsIso₀ M).hom
    simp only [Rep.tateNorm]
    simp
  letI : Module ℤ (LinearMap.ker
      ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g.hom) :=
    (LinearMap.ker ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g.hom).module
  let e : normKernel M ≃+
      LinearMap.ker ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g.hom :=
    { toFun := fun x => ⟨e0.inv x, by
          rw [LinearMap.mem_ker]
          apply (ModuleCat.mono_iff_injective eOut.hom).1 inferInstance
          have hnx := ConcreteCategory.congr_hom hn (e0.inv x)
          calc
            _ = M.norm.hom (e0.hom (e0.inv x)) := hnx.symm
            _ = M.norm.hom x := by rw [e0.inv_hom_id_apply]
            _ = 0 := x.2
            _ = eOut.hom 0 := (map_zero _).symm⟩
      invFun := fun x => ⟨e0.hom x.1, by
          change M.norm.hom (e0.hom x.1) = 0
          have hx : ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g x.1 = 0 := by
            simpa only [LinearMap.mem_ker] using x.2
          have hnx := ConcreteCategory.congr_hom hn x.1
          calc
            _ = (ConcreteCategory.hom (e0.hom ≫ M.norm.toModuleCatHom)) x.1 := rfl
            _ = (ConcreteCategory.hom
                (((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g ≫ eOut.hom)) x.1 := hnx
            _ = eOut.hom (((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).g x.1) := rfl
            _ = eOut.hom 0 := congr_arg _ hx
            _ = 0 := map_zero _⟩
      left_inv := fun x => by
        apply Subtype.ext
        exact e0.inv_hom_id_apply x
      right_inv := fun x => by
        apply Subtype.ext
        exact e0.hom_inv_id_apply x.1
      map_add' := fun x y => by
        apply Subtype.ext
        exact e0.inv.hom.toAddMonoidHom.map_add x y }
  have hAug (x : M) : x ∈ augmentation M ↔
      ∃ c : G →₀ M, groupHomology.d₁₀ M c = x := by
    constructor
    · intro hx
      refine AddSubgroup.closure_induction
        (p := fun x _ => ∃ c : G →₀ M, groupHomology.d₁₀ M c = x) ?_ ?_ ?_ ?_ hx
      · rintro _ ⟨g, a, rfl⟩
        refine ⟨Finsupp.single g⁻¹ a, ?_⟩
        rw [groupHomology.d₁₀_single]
        simp
      · exact ⟨0, map_zero _⟩
      · rintro x y _ _ ⟨cx, hcx⟩ ⟨cy, hcy⟩
        exact ⟨cx + cy, by rw [map_add, hcx, hcy]⟩
      · rintro x _ ⟨cx, hcx⟩
        exact ⟨-cx, by rw [map_neg, hcx]⟩
    · rintro ⟨c, rfl⟩
      induction c using Finsupp.induction with
      | zero => simpa using (augmentation M).zero_mem
      | single_add g a c hg hc ih =>
          rw [map_add]
          apply (augmentation M).add_mem
          · apply AddSubgroup.subset_closure
            exact ⟨g⁻¹, a, by rw [groupHomology.d₁₀_single]⟩
          · exact ih
  let ePrev := (TateCohomology.tateComplex.evalNeg 1).app M ≪≫
    groupHomology.chainsIso₁ M
  have hd : ePrev.hom ≫ groupHomology.d₁₀ M =
      ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).f ≫ e0.hom := by
    change (groupHomology.chainsIso₁ M).hom ≫ groupHomology.d₁₀ M =
      (groupHomology.inhomogeneousChains M).d 1 0 ≫
        (groupHomology.chainsIso₀ M).hom
    exact groupHomology.comp_d₁₀_eq M
  let N := augmentationInNormKernel M
  let P := (LinearMap.range
    ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).moduleCatToCycles).toAddSubgroup
  have heN : N ≤ P.comap e.toAddMonoidHom := by
    intro x hx
    rcases (hAug x.1).1 hx with ⟨a, ha⟩
    refine ⟨ePrev.inv a, ?_⟩
    apply Subtype.ext
    apply (ModuleCat.mono_iff_injective e0.hom).1 inferInstance
    have hda := ConcreteCategory.congr_hom hd (ePrev.inv a)
    calc
      _ = groupHomology.d₁₀ M (ePrev.hom (ePrev.inv a)) := hda.symm
      _ = groupHomology.d₁₀ M a := by rw [ePrev.inv_hom_id_apply]
      _ = x := ha
      _ = e0.hom (e0.inv x) := (e0.inv_hom_id_apply x).symm
  have heP : P ≤ N.comap e.symm.toAddMonoidHom := by
    rintro x ⟨a, ha⟩
    have hda := ConcreteCategory.congr_hom hd a
    have hval : groupHomology.d₁₀ M (ePrev.hom a) = e0.hom x.1 := by
      calc
        _ = (ConcreteCategory.hom (ePrev.hom ≫ groupHomology.d₁₀ M)) a := rfl
        _ = (ConcreteCategory.hom
              (((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).f ≫ e0.hom)) a := hda
        _ = e0.hom (((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).f a) := rfl
        _ = e0.hom x.1 := by
          congr 1
          exact congr_arg Subtype.val ha
    change e0.hom x.1 ∈ augmentation M
    exact (hAug _).2 ⟨ePrev.hom a, hval⟩
  let q := QuotientAddGroup.map N P e.toAddMonoidHom heN
  let qi := QuotientAddGroup.map P N e.symm.toAddMonoidHom heP
  have hqi_q : Function.LeftInverse qi q := by
    intro x
    induction x using QuotientAddGroup.induction_on with
    | H x =>
      dsimp [q, qi]
      exact congr_arg (QuotientAddGroup.mk' N) (e.left_inv x)
  have hq_qi : Function.RightInverse qi q := by
    intro x
    induction x using QuotientAddGroup.induction_on with
    | H x =>
      dsimp [q, qi]
      exact congr_arg (QuotientAddGroup.mk' P) (e.right_inv x)
  let eq := AddEquiv.ofBijective q ⟨hqi_q.injective, hq_qi.surjective⟩
  let eSc := (tateComplex M).isoSc' (-2 : ℤ) (-1 : ℤ) 0 (by simp) (by simp)
  let et : tateCohomology M (-1) ≅
      ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).moduleCatLeftHomologyData.H :=
    (ShortComplex.leftHomologyIso ((tateComplex M).sc (-1))).symm ≪≫
      ShortComplex.leftHomologyMapIso' eSc _
        ((tateComplex M).sc' (-2 : ℤ) (-1 : ℤ) 0).moduleCatLeftHomologyData
  exact ⟨eq.trans et.symm.toLinearEquiv.toAddEquiv⟩

end TateLowDegree

section Hilbert90

variable (K L : Type) [Field K] [Field L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/--
**C03**, Lemma `lem:hilbert90`: Hilbert 90 specialized to the binding representation
`Additive (Units L)` in the concrete normalized model.
-/
theorem hilbert90_mulRep_inhomogeneous :
    Subsingleton (Inhomogeneous.H1 (MulRep K L)) := by
  constructor
  intro x y
  apply (comparisonH1 (MulRep K L)).injective
  exact Subsingleton.elim _ _

/-- **C03**, Lemma `lem:hilbert90`: the same vanishing in Mathlib group cohomology. -/
theorem hilbert90_mulRep_mathlib :
    Subsingleton (groupCohomology.H1 (MulRep K L)) := by
  infer_instance

end Hilbert90

section Induced

variable (G : Type) [Group G]
variable (A : Type) [AddCommGroup A] [Module ℤ A]

/-- The module induced from the trivial subgroup, in Mathlib's representation category. -/
abbrev InducedFromTrivial : Rep ℤ G :=
  Rep.ind (⊥ : Subgroup G).subtype (Rep.trivial ℤ (↥(⊥ : Subgroup G)) A)

end Induced

section InducedAcyclicHelpers

open scoped MonoidAlgebra
open Finsupp TensorProduct Representation

variable {G A : Type} [Group G] [AddCommGroup A]
variable (S : Subgroup G)

private abbrev Q := Quotient (QuotientGroup.leftRel S)
private abbrev B := Q S →₀ A
private abbrev botG : Subgroup G := ⊥
private abbrev botS : Subgroup S := ⊥
private abbrev AG : Rep ℤ (botG (G := G)) := Rep.trivial ℤ _ A
private abbrev BS : Rep ℤ (botS S) := Rep.trivial ℤ _ (B (A := A) S)

private def q (g : G) : Q S := Quotient.mk'' g
private def r (z : Q S) : G := Quotient.out z
private def s (g : G) : S := ⟨(r S (q S g))⁻¹ * g,
  QuotientGroup.leftRel_apply.mp (Quotient.mk_out g)⟩

private lemma r_mul_s (g : G) : r S (q S g) * (s S g : G) = g := by
  simp [s, r]

private lemma q_mul (g : G) (h : S) : q S (g * h) = q S g := by
  apply Quotient.sound
  apply QuotientGroup.leftRel_apply.mpr
  simpa using h⁻¹.2

private lemma q_r (z : Q S) : q S (r S z) = z := Quotient.out_eq z

private lemma s_r (z : Q S) : s S (r S z) = 1 := by
  apply Subtype.ext
  simp [s, q_r]

private lemma s_mul (g : G) (h : S) : s S (g * h) = s S g * h := by
  apply Subtype.ext
  change (r S (q S (g * h)))⁻¹ * (g * h) = ((r S (q S g))⁻¹ * g) * h
  rw [q_mul]
  simp [mul_assoc]

private abbrev N : Rep ℤ S := Rep.res S.subtype (InducedFromTrivial G A)

private def seed : B (A := A) S →ₗ[ℤ] N (A := A) S :=
  (Finsupp.liftAddHom fun z =>
    (Representation.IndV.mk (botG (G := G)).subtype
      (AG (G := G) (A := A)).ρ (r S z)).toAddMonoidHom).toIntLinearMap

private def seedHom : BS (A := A) S ⟶ Rep.res (botS S).subtype (N (A := A) S) :=
  Rep.ofHom ⟨seed (A := A) S, fun x => by
    apply LinearMap.ext
    intro b
    have hx : x = 1 := by
      apply Subtype.ext
      exact (Subgroup.mem_bot (G := S)).mp x.2
    subst x
    change seed (A := A) S b = (N (A := A) S).ρ 1 (seed (A := A) S b)
    rw [map_one]
    rfl⟩

private def forward : Rep.ind (botS S).subtype (BS (A := A) S) ⟶ N (A := A) S :=
  (Rep.indResHomEquiv (botS S).subtype (BS (A := A) S) (N (A := A) S)).symm
    (seedHom (A := A) S)

private def singleLinear (z : Q S) : A →ₗ[ℤ] (BS (A := A) S).V where
  toFun a := Finsupp.single z a
  map_add' x y := by simp
  map_smul' n x := by
    change Finsupp.single z (n • x) = n • Finsupp.single z x
    simp

private def reverseAux : TensorProduct ℤ ℤ[G] A →ₗ[ℤ]
    Rep.ind (botS S).subtype (BS (A := A) S) :=
  TensorProduct.lift <| (Finsupp.linearCombination ℤ fun g : G =>
    Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ (s S g) ∘ₗ
      singleLinear (A := A) S (q S g)) ∘ₗ (MonoidAlgebra.coeffLinearEquiv ℤ).toLinearMap

private def reverseLinear : N (A := A) S →ₗ[ℤ]
    Rep.ind (botS S).subtype (BS (A := A) S) :=
  Representation.Coinvariants.lift _ (reverseAux (A := A) S) fun x => by
    have hx : x = 1 := by
      apply Subtype.ext
      exact (Subgroup.mem_bot (G := G)).mp x.2
    subst x
    change reverseAux (A := A) S ∘ₗ
      (Representation.tprod ((Representation.leftRegular ℤ G).comp (botG (G := G)).subtype)
        (AG (G := G) (A := A)).ρ) 1 = reverseAux (A := A) S
    rw [map_one]
    exact LinearMap.comp_id _

@[simp]
private lemma reverseLinear_mk (g : G) (a : A) :
    reverseLinear (A := A) S
      (Representation.IndV.mk (botG (G := G)).subtype (AG (G := G) (A := A)).ρ g a) =
    Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ (s S g)
      (Finsupp.single (q S g) a) := by
  change reverseAux (A := A) S ((MonoidAlgebra.single g (1 : ℤ) : MonoidAlgebra ℤ G) ⊗ₜ[ℤ] a) = _
  set_option backward.isDefEq.respectTransparency false in
    simp only [reverseAux, TensorProduct.lift.tmul, LinearMap.comp_apply]
    have hcoeff :
        (MonoidAlgebra.coeffLinearEquiv ℤ).toLinearMap
            (MonoidAlgebra.single g 1 : MonoidAlgebra ℤ G) = Finsupp.single g 1 := rfl
    rw [hcoeff, Finsupp.linearCombination_single, one_smul]
    rfl

private def reverse : N (A := A) S ⟶ Rep.ind (botS S).subtype (BS (A := A) S) :=
  Rep.ofHom ⟨reverseLinear (A := A) S, fun h => by
    apply LinearMap.ext
    intro z
    induction z using Representation.Coinvariants.induction_on with
    | h z =>
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy =>
        rw [map_add, map_add, map_add]
        exact congrArg₂ (· + ·) hx hy
      | tmul f a =>
        induction f using Finsupp.induction_linear with
        | zero => simp
        | add x y hx hy => simpa [TensorProduct.add_tmul] using congrArg₂ (· + ·) hx hy
        | single g n =>
          rw [show Finsupp.single g n = n • Finsupp.single g (1 : ℤ) by simp,
            ← TensorProduct.smul_tmul']
          simp only [map_smul]
          congr 1
          change reverseLinear (A := A) S
              ((N (A := A) S).ρ h
                (Representation.IndV.mk (botG (G := G)).subtype
                  (AG (G := G) (A := A)).ρ g a)) =
            (Rep.ind (botS S).subtype (BS (A := A) S)).ρ h
              (reverseLinear (A := A) S
                (Representation.IndV.mk (botG (G := G)).subtype
                  (AG (G := G) (A := A)).ρ g a))
          change reverseLinear (A := A) S
              ((Representation.ind (botG (G := G)).subtype (AG (G := G) (A := A)).ρ)
                (h : G) (Representation.IndV.mk (botG (G := G)).subtype
                  (AG (G := G) (A := A)).ρ g a)) =
            (Representation.ind (botS S).subtype (BS (A := A) S).ρ) h
              (reverseLinear (A := A) S
                (Representation.IndV.mk (botG (G := G)).subtype
                  (AG (G := G) (A := A)).ρ g a))
          rw [Representation.ind_mk, reverseLinear_mk, reverseLinear_mk,
            Representation.ind_mk]
          rw [show (h : G)⁻¹ = (h⁻¹ : S) by rfl, s_mul, q_mul]
    ⟩

@[simp]
private lemma seed_single (z : Q S) (a : A) :
    seed (A := A) S (Finsupp.single z a) =
      Representation.IndV.mk (botG (G := G)).subtype
        (AG (G := G) (A := A)).ρ (r S z) a := by
  simp [seed]

@[simp]
private lemma forward_mk (h : S) (b : B (A := A) S) :
    (forward (A := A) S).hom
      (Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ h b) =
    (N (A := A) S).ρ h⁻¹ ((seedHom (A := A) S).hom b) := by
  simp [forward, Rep.indResHomEquiv]
  rw [Finsupp.sum_single_index]
  · exact one_smul ℤ _
  · exact zero_smul ℤ _

private def resIndIso : N (A := A) S ≅
    Rep.ind (botS S).subtype (BS (A := A) S) := by
  apply Rep.mkIso
  have hright : ∀ z : (Rep.ind (botS S).subtype (BS (A := A) S)).V,
      (reverse (A := A) S).hom ((forward (A := A) S).hom z) = z := by
    intro z
    induction z using Representation.Coinvariants.induction_on with
    | h z =>
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy =>
        rw [map_add, map_add, map_add]
        exact congrArg₂ (· + ·) hx hy
      | tmul f b =>
        induction f using Finsupp.induction_linear with
        | zero => simp
        | add x y hx hy => simpa [TensorProduct.add_tmul] using congrArg₂ (· + ·) hx hy
        | single h n =>
          rw [show Finsupp.single h n = n • Finsupp.single h (1 : ℤ) by simp,
            ← TensorProduct.smul_tmul']
          simp only [map_smul]
          congr 1
          change (reverse (A := A) S).hom
              ((forward (A := A) S).hom
                (Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ h b)) =
            Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ h b
          rw [forward_mk]
          induction b using Finsupp.induction_linear with
          | zero => simp
          | add x y hx hy =>
            calc
              _ = (reverse (A := A) S).hom
                    ((N (A := A) S).ρ h⁻¹ ((seedHom (A := A) S).hom x)) +
                  (reverse (A := A) S).hom
                    ((N (A := A) S).ρ h⁻¹ ((seedHom (A := A) S).hom y)) := by
                      rw [map_add, map_add, map_add]
              _ = Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ h x +
                  Representation.IndV.mk (botS S).subtype (BS (A := A) S).ρ h y :=
                    congrArg₂ (· + ·) hx hy
              _ = _ := (Representation.IndV.mk (botS S).subtype
                (BS (A := A) S).ρ h).map_add x y |>.symm
          | single z a =>
            change (reverse (A := A) S).hom
                ((N (A := A) S).ρ h⁻¹
                  ((seedHom (A := A) S).hom (Finsupp.single z a))) = _
            rw [show (seedHom (A := A) S).hom (Finsupp.single z a) =
              seed (A := A) S (Finsupp.single z a) from rfl, seed_single]
            change reverseLinear (A := A) S
                ((Representation.ind (botG (G := G)).subtype (AG (G := G) (A := A)).ρ)
                  (h⁻¹ : S) (Representation.IndV.mk (botG (G := G)).subtype
                    (AG (G := G) (A := A)).ρ (r S z) a)) = _
            rw [Representation.ind_mk]
            rw [show ((h⁻¹ : S) : G)⁻¹ = (h : G) by simp]
            rw [reverseLinear_mk, q_mul, q_r, s_mul, s_r, one_mul]
  have hleft : ∀ z : (N (A := A) S).V,
      (forward (A := A) S).hom ((reverse (A := A) S).hom z) = z := by
    intro z
    induction z using Representation.Coinvariants.induction_on with
    | h z =>
      induction z using TensorProduct.induction_on with
      | zero => simp
      | add x y hx hy =>
        rw [map_add, map_add, map_add]
        exact congrArg₂ (· + ·) hx hy
      | tmul f a =>
        induction f using Finsupp.induction_linear with
        | zero => simp
        | add x y hx hy => simpa [TensorProduct.add_tmul] using congrArg₂ (· + ·) hx hy
        | single g n =>
          rw [show Finsupp.single g n = n • Finsupp.single g (1 : ℤ) by simp,
            ← TensorProduct.smul_tmul']
          simp only [map_smul]
          congr 1
          change (forward (A := A) S).hom
              (reverseLinear (A := A) S
                (Representation.IndV.mk (botG (G := G)).subtype
                  (AG (G := G) (A := A)).ρ g a)) =
            Representation.IndV.mk (botG (G := G)).subtype
              (AG (G := G) (A := A)).ρ g a
          rw [reverseLinear_mk, forward_mk]
          rw [show (seedHom (A := A) S).hom (Finsupp.single (q S g) a) =
            seed (A := A) S (Finsupp.single (q S g) a) from rfl, seed_single]
          change (Representation.ind (botG (G := G)).subtype (AG (G := G) (A := A)).ρ)
              ((s S g)⁻¹ : S)
              (Representation.IndV.mk (botG (G := G)).subtype
                (AG (G := G) (A := A)).ρ (r S (q S g)) a) = _
          rw [Representation.ind_mk]
          rw [show (((s S g)⁻¹ : S) : G)⁻¹ = (s S g : G) by simp, r_mul_s]
  let e : (N (A := A) S).V ≃ₗ[ℤ]
      (Rep.ind (botS S).subtype (BS (A := A) S)).V :=
    LinearEquiv.ofBijective (reverse (A := A) S).hom.toLinearMap
      ⟨fun x y h => by
          exact (hleft x).symm.trans ((congrArg (fun z =>
            (forward (A := A) S).hom z) h).trans (hleft y)),
        fun y => ⟨(forward (A := A) S).hom y, hright y⟩⟩
  exact Representation.Equiv.mk e (reverse (A := A) S).hom.2

private abbrev C : Rep ℤ S := Rep.coind (botS S).subtype (BS (A := A) S)

private def pointMass (b : B (A := A) S) : C (A := A) S := by
  classical
  exact ⟨fun t => if t = 1 then b else 0, by
    intro x t
    have hx : x = 1 := by
      apply Subtype.ext
      exact (Subgroup.mem_bot (G := S)).mp x.2
    subst x
    simp⟩

private lemma norm_pointMass [Fintype S] (b : B (A := A) S) (t : S) :
    ((C (A := A) S).norm.hom (pointMass (A := A) S b)).1 t = b := by
  classical
  rw [Rep.norm_apply, Representation.norm]
  simp only [LinearMap.sum_apply, Submodule.coe_sum, Finset.sum_apply,
    Representation.coind_apply, LinearMap.restrict_apply, LinearMap.funLeft_apply]
  change (∑ g : S, if t * g = 1 then b else 0) = b
  rw [Finset.sum_eq_single t⁻¹]
  · simp
  · intro g _ hg
    simp only [ite_eq_right_iff]
    intro h
    exact (hg (eq_inv_of_mul_eq_one_right h)).elim
  · simp

private lemma invariant_eq_norm_pointMass [Fintype S]
    (x : Inhomogeneous.invariants0 (C (A := A) S)) :
    (C (A := A) S).norm.hom (pointMass (A := A) S (x.1.1 1)) = x.1 := by
  apply Subtype.ext
  apply funext
  intro t
  rw [norm_pointMass]
  have h := congrArg (fun z : C (A := A) S => z.1 1) (x.2 t)
  simpa only [Representation.coind_apply, LinearMap.restrict_apply,
    LinearMap.funLeft_apply, one_mul] using h.symm

private theorem coindBot_H0_subsingleton [Fintype S] :
    Subsingleton (TateLowDegree.H0 (C (A := A) S)) := by
  constructor
  intro x y
  apply sub_eq_zero.mp
  induction x - y using QuotientAddGroup.induction_on with
  | H z =>
    apply (QuotientAddGroup.eq_zero_iff z).2
    change z ∈ TateLowDegree.normRangeInInvariants (C (A := A) S)
    exact ⟨pointMass (A := A) S (z.1.1 1), invariant_eq_norm_pointMass (A := A) S z⟩

private lemma normKernel_mem_augmentation [Fintype S]
    (x : TateLowDegree.normKernel (C (A := A) S)) :
    x.1 ∈ TateLowDegree.augmentation (C (A := A) S) := by
  classical
  have hsum := congrArg (fun z : C (A := A) S => z.1 1) x.2
  change (((C (A := A) S).norm.hom x.1).1 1) = 0 at hsum
  rw [Rep.norm_apply, Representation.norm] at hsum
  simp only [LinearMap.sum_apply, Submodule.coe_sum, Finset.sum_apply,
    Representation.coind_apply, LinearMap.restrict_apply, LinearMap.funLeft_apply,
    one_mul] at hsum
  change (∑ g : S, x.1.1 g) = 0 at hsum
  have heq : (∑ t : S, ((C (A := A) S).ρ t⁻¹
      (pointMass (A := A) S (x.1.1 t)) - pointMass (A := A) S (x.1.1 t))) = x.1 := by
    apply Subtype.ext
    apply funext
    intro y
    simp only [Submodule.coe_sum, Finset.sum_apply, map_sub,
      Representation.coind_apply, LinearMap.restrict_apply, LinearMap.funLeft_apply]
    change (∑ t : S, ((if y * t⁻¹ = 1 then x.1.1 t else 0) -
      if y = 1 then x.1.1 t else 0)) = x.1.1 y
    rw [Finset.sum_sub_distrib, Finset.sum_eq_single y]
    · by_cases hy : y = 1
      · subst y
        simp [hsum]
      · simp [hy]
    · intro t _ hty
      simp only [ite_eq_right_iff]
      intro h
      exact (hty (inv_injective (eq_inv_of_mul_eq_one_right h))).elim
    · simp
  rw [← heq]
  apply AddSubgroup.sum_mem
  intro t _
  apply AddSubgroup.subset_closure
  exact ⟨t⁻¹, pointMass (A := A) S (x.1.1 t), rfl⟩

private theorem coindBot_HMinusOne_subsingleton [Fintype S] :
    Subsingleton (TateLowDegree.HMinusOne (C (A := A) S)) := by
  constructor
  intro x y
  apply sub_eq_zero.mp
  induction x - y using QuotientAddGroup.induction_on with
  | H z =>
    apply (QuotientAddGroup.eq_zero_iff z).2
    exact normKernel_mem_augmentation (A := A) S z

private theorem coindBot_tateAcyclic [Fintype S] (n : ℤ) :
    Subsingleton (tateCohomology (C (A := A) S) n) := by
  classical
  cases n with
  | ofNat n =>
      cases n with
      | zero =>
          let e := TateLowDegree.comparisonH0Tate (C (A := A) S)
          let h := coindBot_H0_subsingleton (A := A) S
          exact ⟨fun x y => e.symm.injective (h.elim _ _)⟩
      | succ n =>
          let e := (TateCohomology.isoGroupCohomology (n + 1)).app (C (A := A) S) ≪≫
            groupCohomology.coindIso (BS (A := A) S) (n + 1)
          exact ModuleCat.isZero_iff_subsingleton.mp
            ((isZero_groupCohomology_succ_of_subsingleton (BS (A := A) S) n).of_iso e)
  | negSucc n =>
      cases n with
      | zero =>
          let e := (TateLowDegree.HMinusOne_equiv_tate (C (A := A) S)).some
          let h := coindBot_HMinusOne_subsingleton (A := A) S
          exact ⟨fun x y => e.symm.injective (h.elim _ _)⟩
      | succ n =>
          let e := (TateCohomology.isoGroupHomology (-(n + 2 : ℤ)) (n + 1) (by omega)).app
              (Rep.ind (botS S).subtype (BS (A := A) S)) ≪≫
            groupHomology.indIso (botS S) (BS (A := A) S) (n + 1)
          have hz := isZero_groupHomology_succ_of_subsingleton
            (A := BS (A := A) S) n
          have hInd : CategoryTheory.Limits.IsZero
              (tateCohomology (Rep.ind (botS S).subtype (BS (A := A) S)) (-(n + 2 : ℤ))) :=
            hz.of_iso e
          exact ModuleCat.isZero_iff_subsingleton.mp <| hInd.of_iso
            ((tateCohomologyFunctor (-(n + 2 : ℤ))).mapIso
              (Rep.indCoindIso (BS (A := A) S))).symm

end InducedAcyclicHelpers

section Induced

variable (G : Type) [Group G]
variable (A : Type) [AddCommGroup A] [Module ℤ A]

/--
**C04**, Lemma `lem:induced-acyclic`: a module induced from the trivial subgroup has zero Tate
cohomology in every degree; restriction to any subgroup is included in the statement.
-/
theorem inducedFromTrivial_tateAcyclic
    (S : Subgroup G) [Fintype S] (n : ℤ) :
    Subsingleton (tateCohomology (Rep.res S.subtype (InducedFromTrivial G A)) n) := by
  classical
  let hmod : (inferInstance : Module ℤ A) = AddCommGroup.toIntModule A := Subsingleton.elim _ _
  cases hmod
  let e := (tateCohomologyFunctor n).mapIso (resIndIso (A := A) S) ≪≫
    (tateCohomologyFunctor n).mapIso (Rep.indCoindIso (BS (A := A) S))
  let h := coindBot_tateAcyclic (A := A) S n
  exact ⟨fun x y => (ModuleCat.mono_iff_injective e.hom).1 inferInstance (h.elim _ _)⟩

end Induced

section CocyclePushout

variable {G : Type} [Group G]

open CategoryTheory.Limits
open scoped MonoidAlgebra

abbrev barRegular (G : Type) [Group G] : Rep ℤ G := Rep.leftRegular ℤ G

def barAugmentation (G : Type) [Group G] : barRegular G ⟶ Rep.trivial ℤ G ℤ :=
  Rep.leftRegularHom (Rep.trivial ℤ G ℤ) 1

@[simp] lemma barAugmentation_single (g : G) (n : ℤ) :
    (barAugmentation G).hom (MonoidAlgebra.single g n : ℤ[G]) = n := by
  simpa [barAugmentation] using
    (Rep.leftRegularHom_hom_single (A := Rep.trivial ℤ G ℤ) g 1 n)

def barAugmentationSubmodule (G : Type) [Group G] : Submodule ℤ (barRegular G) :=
  LinearMap.ker (barAugmentation G).hom.toLinearMap

lemma barAugmentationSubmodule_stable (g : G) : barAugmentationSubmodule G ≤
    (barAugmentationSubmodule G).comap ((barRegular G).ρ g) := by
  intro x hx
  change (barAugmentation G).hom ((barRegular G).ρ g x) = 0
  rw [Rep.hom_comm_apply]
  change (barAugmentation G).hom x = 0
  exact hx

abbrev barAugmentationIdeal (G : Type) [Group G] : Rep ℤ G :=
  (barRegular G).subrepresentation (barAugmentationSubmodule G) (barAugmentationSubmodule_stable (G := G))

def barAugmentationInclusion (G : Type) [Group G] : barAugmentationIdeal G ⟶ barRegular G :=
  Rep.subtype (barRegular G) (barAugmentationSubmodule G) (barAugmentationSubmodule_stable (G := G))

@[simp] lemma barAugmentationInclusion_apply (x : barAugmentationIdeal G) : (barAugmentationInclusion G).hom x = x.1 := rfl

@[simp] lemma barAugmentation_comp : barAugmentationInclusion G ≫ barAugmentation G = 0 := by
  ext x
  exact x.2

def barAugmentationSequence (G : Type) [Group G] : ShortComplex (Rep ℤ G) :=
  ShortComplex.mk (barAugmentationInclusion G) (barAugmentation G) (barAugmentation_comp (G := G))

private def barAugmentationKernelLift (s : KernelFork (barAugmentation G)) : s.pt ⟶ barAugmentationIdeal G := by
  letI : Module ℤ s.pt := s.pt.hV2
  letI : Module ℤ (barAugmentationSubmodule G) := (barAugmentationSubmodule G).module
  let L : s.pt →ₗ[ℤ] barAugmentationSubmodule G :=
    s.ι.hom.toLinearMap.codRestrict (barAugmentationSubmodule G) fun z => by
      change (barAugmentation G).hom (s.ι.hom z) = 0
      have hcond : s.ι ≫ barAugmentation G = 0 := KernelFork.condition s
      calc
        _ = (s.ι ≫ barAugmentation G).hom z := rfl
        _ = (0 : s.pt ⟶ Rep.trivial ℤ G ℤ).hom z :=
          congrArg (fun q : s.pt ⟶ Rep.trivial ℤ G ℤ => q.hom z) hcond
        _ = 0 := rfl
  exact Rep.ofHom ⟨L, fun g => by
    apply LinearMap.ext
    intro z
    apply Subtype.ext
    exact Rep.hom_comm_apply s.ι g z⟩

private def barAugmentationIncIsKernel : IsLimit (KernelFork.ofι (barAugmentationInclusion G) (barAugmentation_comp (G := G))) :=
  Fork.IsLimit.mk _ (barAugmentationKernelLift (G := G))
    (fun s => by
      letI : Module ℤ s.pt := s.pt.hV2
      apply Rep.hom_ext
      apply Representation.IntertwiningMap.ext
      apply LinearMap.ext
      intro z
      rfl)
    (fun s m hm => by
      letI : Module ℤ s.pt := s.pt.hV2
      apply Rep.hom_ext
      apply Representation.IntertwiningMap.ext
      apply LinearMap.ext
      intro z
      apply Subtype.ext
      exact congrArg (fun q : s.pt ⟶ barRegular G => q.hom z) hm)

lemma barAugmentationSequence_shortExact : (barAugmentationSequence G).ShortExact := by
  apply ShortComplex.ShortExact.mk'
  · exact ShortComplex.exact_of_f_is_kernel _ (barAugmentationIncIsKernel (G := G))
  · exact (Rep.mono_iff_injective _).2 fun x y h => Subtype.ext h
  · apply (Rep.epi_iff_surjective _).2
    intro n
    refine ⟨(MonoidAlgebra.single 1 n : ℤ[G]), ?_⟩
    exact barAugmentation_single 1 n

variable (M : Rep.{0} ℤ G)

private def cocycleTwistRegular (a : G → G → M) (g : G) : barRegular G →+ M :=
  Finsupp.liftAddHom fun h => (smulAddHom ℤ M).flip (a g h)

@[simp] private lemma cocycleTwistRegular_single (a : G → G → M) (g h : G) (n : ℤ) :
    cocycleTwistRegular M a g (MonoidAlgebra.single h n) = n • a g h := by
  rw [cocycleTwistRegular, Finsupp.liftAddHom_apply_single]
  rfl

private lemma cocycleTwistRegular_cocycle (a : G → G → M)
    (ha2 : NU.LCFT.Inhomogeneous.d2 M a = 0) (g h : G) (z : barRegular G) :
    cocycleTwistRegular M a (g * h) z + (barAugmentation G).hom z • a g h =
      M.ρ g (cocycleTwistRegular M a h z) + cocycleTwistRegular M a g ((barRegular G).ρ h z) := by
  induction z using Finsupp.induction with
  | zero => simp
  | single_add t n q htn hn ih =>
      have hsingle :
          cocycleTwistRegular M a (g * h) (Finsupp.single t n) +
              (barAugmentation G).hom (Finsupp.single t n) • a g h =
            M.ρ g (cocycleTwistRegular M a h (Finsupp.single t n)) +
              cocycleTwistRegular M a g ((barRegular G).ρ h (Finsupp.single t n)) := by
        rw [cocycleTwistRegular_single, barAugmentation_single,
          cocycleTwistRegular_single, Representation.ofMulAction_single,
          cocycleTwistRegular_single, map_zsmul, smul_eq_mul]
        have hc := congrFun (congrFun (congrFun ha2 g) h) t
        change M.ρ g (a h t) - a (g * h) t + a g (h * t) - a g h = 0 at hc
        have hn := congrArg (n • ·) hc
        have hn' : n • M.ρ g (a h t) - n • a (g * h) t +
            n • a g (h * t) - n • a g h = 0 := by
          simpa only [smul_zero, smul_sub, smul_add] using hn
        apply sub_eq_zero.mp
        calc
          (n • a (g * h) t + n • a g h) -
              (n • M.ρ g (a h t) + n • a g (h * t)) =
            -(n • M.ρ g (a h t) - n • a (g * h) t +
              n • a g (h * t) - n • a g h) := by abel
          _ = 0 := by rw [hn', neg_zero]
      calc
        _ = (cocycleTwistRegular M a (g * h) (Finsupp.single t n) +
              (barAugmentation G).hom (Finsupp.single t n) • a g h) +
            (cocycleTwistRegular M a (g * h) q +
              (barAugmentation G).hom q • a g h) := by
          rw [map_add, map_add, add_zsmul]
          abel
        _ = (M.ρ g (cocycleTwistRegular M a h (Finsupp.single t n)) +
              cocycleTwistRegular M a g ((barRegular G).ρ h (Finsupp.single t n))) +
            (M.ρ g (cocycleTwistRegular M a h q) +
              cocycleTwistRegular M a g ((barRegular G).ρ h q)) :=
          congrArg₂ (· + ·) hsingle ih
        _ = _ := by
          simp only [map_add]
          abel

private def cocycleTwist (a : G → G → M) (g : G) : barAugmentationIdeal G →+ M :=
  (cocycleTwistRegular M a g).comp (barAugmentationInclusion G).hom.toAddMonoidHom

private lemma cocycleTwist_cocycle (a : G → G → M)
    (ha2 : NU.LCFT.Inhomogeneous.d2 M a = 0) (g h : G) (x : barAugmentationIdeal G) :
    cocycleTwist M a (g * h) x =
      M.ρ g (cocycleTwist M a h x) + cocycleTwist M a g ((barAugmentationIdeal G).ρ h x) := by
  have hz := cocycleTwistRegular_cocycle M a ha2 g h ((barAugmentationInclusion G).hom x)
  have hx : (barAugmentation G).hom ((barAugmentationInclusion G).hom x) = 0 := x.2
  rw [hx, zero_zsmul, add_zero] at hz
  have hbarAugmentationInclusion := Rep.hom_comm_apply (barAugmentationInclusion G) h x
  rw [← hbarAugmentationInclusion] at hz
  exact hz

private lemma cocycleTwist_eq_zero (a : G → G → M) (g : G) (hg : ∀ t, a g t = 0) :
    cocycleTwist M a g = 0 := by
  apply AddMonoidHom.ext
  intro x
  change cocycleTwistRegular M a g ((barAugmentationInclusion G).hom x) = 0
  induction ((barAugmentationInclusion G).hom x) using Finsupp.induction with
  | zero => simp
  | single_add t n q htn hn ih =>
      rw [map_add, ih, add_zero, cocycleTwistRegular_single, hg, smul_zero]

def cocyclePushout (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) : Rep ℤ G := by
  let actAdd (g : G) : (M × barAugmentationIdeal G) →+ (M × barAugmentationIdeal G) :=
    { toFun := fun p => (M.ρ g p.1 + cocycleTwist M a g p.2, (barAugmentationIdeal G).ρ g p.2)
      map_zero' := by simp
      map_add' := fun x y => by
        apply Prod.ext <;> simp only [Prod.fst_add, Prod.snd_add, map_add]
        abel }
  let act (g : G) : (M × barAugmentationIdeal G) →ₗ[ℤ] (M × barAugmentationIdeal G) := (actAdd g).toIntLinearMap
  let ρ : Representation ℤ G (M × barAugmentationIdeal G) :=
    { toFun := act
      map_one' := by
        apply LinearMap.ext
        intro p
        apply Prod.ext
        · change M.ρ 1 p.1 + cocycleTwist M a 1 p.2 = p.1
          have hm := congrArg (fun f => f p.1) (map_one M.ρ)
          change M.ρ 1 p.1 = p.1 at hm
          rw [hm, cocycleTwist_eq_zero M a 1 ha.2.1]
          simp
        · have hI := congrArg (fun f => f p.2) (map_one (barAugmentationIdeal G).ρ)
          change (barAugmentationIdeal G).ρ 1 p.2 = p.2 at hI
          exact hI
      map_mul' := fun g h => by
        apply LinearMap.ext
        intro p
        apply Prod.ext
        · change M.ρ (g * h) p.1 + cocycleTwist M a (g * h) p.2 =
            M.ρ g (M.ρ h p.1 + cocycleTwist M a h p.2) +
              cocycleTwist M a g ((barAugmentationIdeal G).ρ h p.2)
          have hm := congrArg (fun f => f p.1) (map_mul M.ρ g h)
          change M.ρ (g * h) p.1 = M.ρ g (M.ρ h p.1) at hm
          rw [hm, map_add, cocycleTwist_cocycle M a ha.1]
          abel
        · have hI := congrArg (fun f => f p.2) (map_mul (barAugmentationIdeal G).ρ g h)
          change (barAugmentationIdeal G).ρ (g * h) p.2 = (barAugmentationIdeal G).ρ g ((barAugmentationIdeal G).ρ h p.2) at hI
          exact hI }
  exact Rep.of ρ

def cocyclePushoutInclusion (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) : M ⟶ cocyclePushout M a ha := by
  letI : Module ℤ M := M.hV2
  letI : Module ℤ (cocyclePushout M a ha) := (cocyclePushout M a ha).hV2
  let i : M →+ (M × barAugmentationIdeal G) :=
    { toFun := fun m => (m, 0)
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  refine Rep.ofHom ⟨?_, ?_⟩
  · refine {
      toFun := i
      map_add' := i.map_add
      map_smul' := fun n m => map_intCast_smul i ℤ ℤ n m }
  · intro g
    apply LinearMap.ext
    intro m
    apply Prod.ext
    · change M.ρ g m = M.ρ g m + cocycleTwist M a g 0
      simp
    · change (0 : barAugmentationIdeal G) = (barAugmentationIdeal G).ρ g 0
      rw [map_zero]

def cocyclePushoutProjection (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) : cocyclePushout M a ha ⟶ barAugmentationIdeal G := by
  letI : Module ℤ (cocyclePushout M a ha) := (cocyclePushout M a ha).hV2
  letI : Module ℤ (barAugmentationIdeal G) := (barAugmentationIdeal G).hV2
  let p : (M × barAugmentationIdeal G) →+ barAugmentationIdeal G := AddMonoidHom.snd M (barAugmentationIdeal G)
  refine Rep.ofHom ⟨?_, ?_⟩
  · refine {
      toFun := p
      map_add' := p.map_add
      map_smul' := fun n x => map_intCast_smul p ℤ ℤ n x }
  · intro g
    apply LinearMap.ext
    intro x
    rfl

@[simp] private lemma cocyclePushout_comp (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) :
    cocyclePushoutInclusion M a ha ≫ cocyclePushoutProjection M a ha = 0 := by
  letI : Module ℤ M := M.hV2
  apply Rep.hom_ext
  apply Representation.IntertwiningMap.ext
  apply LinearMap.ext
  intro m
  change (0 : barAugmentationIdeal G) = 0
  rfl

def cocyclePushoutSequence (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) : ShortComplex (Rep ℤ G) :=
  ShortComplex.mk (cocyclePushoutInclusion M a ha) (cocyclePushoutProjection M a ha)
    (cocyclePushout_comp M a ha)

private lemma cocyclePushoutFork_snd_zero (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M)
    (s : KernelFork (cocyclePushoutProjection M a ha)) (z : s.pt) :
    (s.ι.hom z).2 = 0 := by
  have hcond : s.ι ≫ cocyclePushoutProjection M a ha = 0 := KernelFork.condition s
  have h := congrArg (fun q : s.pt ⟶ barAugmentationIdeal G => q.hom z) hcond
  exact h

private def cocyclePushoutKernelLift (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M)
    (s : KernelFork (cocyclePushoutProjection M a ha)) : s.pt ⟶ M := by
  letI : Module ℤ s.pt := s.pt.hV2
  letI : Module ℤ M := M.hV2
  let l : s.pt →+ M :=
    (AddMonoidHom.fst M (barAugmentationIdeal G)).comp s.ι.hom.toAddMonoidHom
  refine Rep.ofHom ⟨?_, ?_⟩
  · refine {
      toFun := l
      map_add' := l.map_add
      map_smul' := fun n z => map_intCast_smul l ℤ ℤ n z }
  · intro g
    apply LinearMap.ext
    intro z
    have h := congrArg Prod.fst (Rep.hom_comm_apply s.ι g z)
    change l (s.pt.ρ g z) =
      M.ρ g (s.ι.hom z).1 + cocycleTwist M a g (s.ι.hom z).2 at h
    rw [cocyclePushoutFork_snd_zero M a ha s z, map_zero, add_zero] at h
    exact h

private def cocyclePushoutIncIsKernel (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) :
    IsLimit (KernelFork.ofι (cocyclePushoutInclusion M a ha) (cocyclePushout_comp M a ha)) :=
  Fork.IsLimit.mk _ (cocyclePushoutKernelLift M a ha)
    (fun s => by
      letI : Module ℤ s.pt := s.pt.hV2
      apply Rep.hom_ext
      apply Representation.IntertwiningMap.ext
      apply LinearMap.ext
      intro z
      apply Prod.ext
      · rfl
      · exact (cocyclePushoutFork_snd_zero M a ha s z).symm)
    (fun s m hm => by
      letI : Mono (cocyclePushoutInclusion M a ha) := (Rep.mono_iff_injective _).2 fun x y h =>
        congrArg Prod.fst h
      apply (cancel_mono (cocyclePushoutInclusion M a ha)).1
      change m ≫ Fork.ι (KernelFork.ofι (cocyclePushoutInclusion M a ha)
          (cocyclePushout_comp M a ha)) =
        cocyclePushoutKernelLift M a ha s ≫ Fork.ι (KernelFork.ofι
          (cocyclePushoutInclusion M a ha) (cocyclePushout_comp M a ha))
      rw [hm]
      symm
      letI : Module ℤ s.pt := s.pt.hV2
      apply Rep.hom_ext
      apply Representation.IntertwiningMap.ext
      apply LinearMap.ext
      intro z
      apply Prod.ext
      · rfl
      · exact (cocyclePushoutFork_snd_zero M a ha s z).symm)

lemma cocyclePushoutSequence_shortExact (a : G → G → M)
    (ha : a ∈ NU.LCFT.Inhomogeneous.cocycles2 M) : (cocyclePushoutSequence M a ha).ShortExact := by
  apply ShortComplex.ShortExact.mk'
  · exact ShortComplex.exact_of_f_is_kernel _ (cocyclePushoutIncIsKernel M a ha)
  · apply (Rep.mono_iff_injective _).2
    intro x y h
    exact congrArg Prod.fst h
  · apply (Rep.epi_iff_surjective _).2
    intro x
    exact ⟨(0, x), rfl⟩

/-- The standard augmentation-ideal element `[g] - [1]`. -/
def barAugmentationCocycle (g : G) : barAugmentationIdeal G :=
  ⟨Finsupp.single g 1 - Finsupp.single 1 1, by
    change (barAugmentation G).hom
      (Finsupp.single g 1 - Finsupp.single 1 1) = 0
    rw [map_sub, barAugmentation_single, barAugmentation_single, sub_self]⟩

@[simp]
lemma cocycleTwist_barAugmentationCocycle (a : G → G → M)
    (ha : a ∈ Inhomogeneous.cocycles2 M) (g h : G) :
    cocycleTwist M a g (barAugmentationCocycle h) = a g h := by
  change cocycleTwistRegular M a g
    (Finsupp.single h 1 - Finsupp.single 1 1) = a g h
  rw [map_sub, cocycleTwistRegular_single, cocycleTwistRegular_single,
    one_zsmul, one_zsmul, ha.2.2 g, sub_zero]

@[simp]
lemma barAugmentationCocycle_action (g h : G) :
    (barAugmentationIdeal G).ρ g (barAugmentationCocycle h) =
      barAugmentationCocycle (g * h) - barAugmentationCocycle g := by
  apply Subtype.ext
  change (barRegular G).ρ g
      (Finsupp.single h 1 - Finsupp.single 1 1) =
    (Finsupp.single (g * h) 1 - Finsupp.single 1 1) -
      (Finsupp.single g 1 - Finsupp.single 1 1)
  rw [map_sub, Representation.ofMulAction_single,
    Representation.ofMulAction_single]
  simp [smul_eq_mul]

/-- The defining cocycle becomes a coboundary in its cocycle-pushout module. -/
theorem cocyclePushoutInclusion_kills_class (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M) :
    groupCohomology.map (.id G) (cocyclePushoutInclusion M a ha) 2
      (comparisonH2 M
        (QuotientAddGroup.mk' (Inhomogeneous.coboundaries2 M) ⟨a, ha⟩)) = 0 := by
  let z : groupCohomology.cocycles₂ M := ⟨fun p => a p.1 p.2, by
    rw [groupCohomology.mem_cocycles₂_def]
    intro g h t
    exact congrFun (congrFun (congrFun ha.1 g) h) t⟩
  change groupCohomology.map (.id G) (cocyclePushoutInclusion M a ha) 2
      (groupCohomology.H2π M z) = 0
  rw [groupCohomology.H2π_comp_map_apply]
  apply (groupCohomology.H2π_eq_zero_iff _).2
  refine ⟨fun g => (0, barAugmentationCocycle g), ?_⟩
  ext p
  apply Prod.ext
  · change M.ρ p.1 0 +
        cocycleTwist M a p.1 (barAugmentationCocycle p.2) - 0 + 0 = a p.1 p.2
    rw [map_zero, zero_add, sub_zero, add_zero,
      cocycleTwist_barAugmentationCocycle M a ha]
  · change (barAugmentationIdeal G).ρ p.1 (barAugmentationCocycle p.2) -
        barAugmentationCocycle (p.1 * p.2) + barAugmentationCocycle p.1 = 0
    rw [barAugmentationCocycle_action]
    abel

end CocyclePushout

section Abelianization

variable (G : Type) [Group G] [Fintype G]

/--
**C07**, Theorem `thm:tate-reciprocity`: the constructed degree `-2` Tate/group-homology
comparison followed by Mathlib's bar-resolution `H₁ ≃ Gᵃᵇ` equivalence.
-/
noncomputable def tateMinusTwoComparison :
    TateLowDegree.HMinusTwo (Rep.trivial ℤ G ℤ) ≃+ Additive (Abelianization G) :=
  let e₁ := (TateCohomology.isoGroupHomology (-2) 1
    (by norm_num : (-2 : ℤ) = -(1 + 1))).app (Rep.trivial ℤ G ℤ)
  let e₂ := groupHomology.H1AddEquivOfIsTrivial (Rep.trivial ℤ G ℤ)
  let e₃ := (TensorProduct.rid ℤ (Additive (Abelianization G))).toAddEquiv
  e₁.toLinearEquiv.toAddEquiv.trans (e₂.trans e₃)

/-- Mathlib's degree `-2` Tate cohomology of the trivial integer representation is `Gᵃᵇ`. -/
theorem tateMinusTwo_trivial_equiv_abelianization :
    Nonempty (TateLowDegree.HMinusTwo (Rep.trivial ℤ G ℤ) ≃+
      Additive (Abelianization G)) :=
  ⟨tateMinusTwoComparison G⟩

/--
The actual degree-one bar class `[g]`: first form the finitely supported chain concentrated at
`g`, then pass to `H₁`, and finally use Mathlib's negative Tate/group-homology comparison.
-/
noncomputable def tateBarGenerator (g : G) :
    TateLowDegree.HMinusTwo (Rep.trivial ℤ G ℤ) :=
  let e₁ := (TateCohomology.isoGroupHomology (-2) 1
    (by norm_num : (-2 : ℤ) = -(1 + 1))).app (Rep.trivial ℤ G ℤ)
  e₁.inv (groupHomology.H1π (Rep.trivial ℤ G ℤ)
    ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
      (Finsupp.single g 1)))

/-- The constructed comparison sends the explicit bar class `[g]` to `g` in `Gᵃᵇ`. -/
theorem tateMinusTwoComparison_barGenerator (g : G) :
    tateMinusTwoComparison G (tateBarGenerator G g) =
      Additive.ofMul (Abelianization.of g) := by
  dsimp [tateMinusTwoComparison, tateBarGenerator]
  rw [Iso.inv_hom_id_apply]
  change (TensorProduct.rid ℤ (Additive (Abelianization G)))
    (groupHomology.H1AddEquivOfIsTrivial (Rep.trivial ℤ G ℤ)
      (groupHomology.H1π (Rep.trivial ℤ G ℤ)
        ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
          (Finsupp.single g 1)))) = _
  rw [groupHomology.H1AddEquivOfIsTrivial_single]
  simp


/--
The two standard short exact sequences used to trace a bar class: the augmentation sequence and
the cocycle pushout extension.  The endpoint isomorphisms make the source, intermediate module,
and coefficient target explicit, so `twoConnectingMap` below is literally a composite of two
`TateCohomology.δ` maps rather than an unconstrained homomorphism.
-/
structure BarDimensionShiftData (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M) where
  /-- The augmentation sequence `0 → I_G → ℤ[G] → ℤ → 0`. -/
  augmentationSequence : ShortComplex (Rep ℤ G)
  /-- Exactness of the augmentation sequence. -/
  augmentationExact : augmentationSequence.ShortExact
  /-- The cocycle pushout sequence `0 → M → A(a) → I_G → 0`. -/
  cocycleSequence : ShortComplex (Rep ℤ G)
  /-- Exactness of the cocycle pushout sequence. -/
  cocycleExact : cocycleSequence.ShortExact
  /-- The displayed sequence is the explicit cocycle pushout constructed from `a`. -/
  cocycleSequence_eq_pushout : cocycleSequence = cocyclePushoutSequence M a ha
  /-- Identification of the first sequence's quotient with the trivial integer representation. -/
  sourceIso : Rep.trivial ℤ G ℤ ≅ augmentationSequence.X₃
  /-- Identification of the two copies of the augmentation ideal. -/
  augmentationIdealIso : augmentationSequence.X₁ ≅ cocycleSequence.X₃
  /-- Identification of the second sequence's kernel with `M`. -/
  targetIso : cocycleSequence.X₁ ≅ M
  /-- The extension class carried by the cocycle pushout. -/
  extensionClass : Inhomogeneous.H2 M
  /-- The pushout extension is the class of the specified normalized cocycle. -/
  extensionClass_eq : extensionClass =
    QuotientAddGroup.mk' (Inhomogeneous.coboundaries2 M) ⟨a, ha⟩
  /-- The class and the displayed sequence are jointly pinned to the same cocycle pushout. -/
  extensionClass_eq_cocycleSequence :
    extensionClass =
        QuotientAddGroup.mk' (Inhomogeneous.coboundaries2 M) ⟨a, ha⟩ ∧
      cocycleSequence = cocyclePushoutSequence M a ha

/-- The named standard augmentation and cocycle-pushout dimension-shift data. -/
noncomputable def barDimensionShiftData (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M) : BarDimensionShiftData G M a ha := by
  refine {
    augmentationSequence := barAugmentationSequence G
    augmentationExact := barAugmentationSequence_shortExact (G := G)
    cocycleSequence := cocyclePushoutSequence M a ha
    cocycleExact := cocyclePushoutSequence_shortExact M a ha
    cocycleSequence_eq_pushout := rfl
    sourceIso := Iso.refl _
    augmentationIdealIso := Iso.refl _
    targetIso := Iso.refl _
    extensionClass := QuotientAddGroup.mk' (Inhomogeneous.coboundaries2 M) ⟨a, ha⟩
    extensionClass_eq := rfl
    extensionClass_eq_cocycleSequence := ⟨rfl, rfl⟩ }

/-- The literal composite of the two connecting maps used in Tate--Nakayama dimension shifting. -/
noncomputable def twoConnectingMap {M : Rep ℤ G} {a : Inhomogeneous.C2 M}
    {ha : a ∈ Inhomogeneous.cocycles2 M} (D : BarDimensionShiftData G M a ha) :
    TateLowDegree.HMinusTwo (Rep.trivial ℤ G ℤ) ⟶ tateCohomology M 0 :=
  (tateCohomologyFunctor (-2)).map D.sourceIso.hom ≫
    TateCohomology.δ D.augmentationExact (-2) ≫
    (tateCohomologyFunctor (-1)).map D.augmentationIdealIso.hom ≫
    TateCohomology.δ D.cocycleExact (-1) ≫
    (tateCohomologyFunctor 0).map D.targetIso.hom

/-- The row-sum class in Mathlib's degree-zero Tate object. -/
noncomputable def rowSumTateClass (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (hrow : ∀ g, (∑ x : G, a x g) ∈ Inhomogeneous.invariants0 M) (g : G) :
    tateCohomology M 0 :=
  TateLowDegree.comparisonH0Tate M
    (QuotientAddGroup.mk' (TateLowDegree.normRangeInInvariants M)
      ⟨∑ x : G, a x g, hrow g⟩)

private lemma barAugmentationCocycle_norm (g : G) :
    (barAugmentationIdeal G).norm.hom (barAugmentationCocycle g) = 0 := by
  rw [Rep.norm_apply, Representation.norm]
  simp only [LinearMap.sum_apply]
  change (∑ x : G, (barAugmentationIdeal G).ρ x (barAugmentationCocycle g)) = 0
  calc
    (∑ x : G, (barAugmentationIdeal G).ρ x (barAugmentationCocycle g)) =
        ∑ x : G, (barAugmentationCocycle (x * g) - barAugmentationCocycle x) := by
          apply Finset.sum_congr rfl
          intro x _
          exact barAugmentationCocycle_action x g
    _ = (∑ x : G, barAugmentationCocycle (x * g)) -
        ∑ x : G, barAugmentationCocycle x := by
          rw [Finset.sum_sub_distrib]
    _ = 0 := by
      have h : (∑ x : G, barAugmentationCocycle (x * g)) =
          ∑ x : G, barAugmentationCocycle x := by
        simpa using Equiv.sum_comp (Equiv.mulRight g) barAugmentationCocycle
      rw [h, sub_self]

private noncomputable def tateZeroEquiv (N : Rep ℤ G) :=
  (TateCohomology.tateComplex.evalNonneg 0).app N ≪≫
    groupCohomology.cochainsIso₀ N

private lemma tateZeroEquiv_inv_invariant_cycle (N : Rep ℤ G)
    (x : Inhomogeneous.invariants0 N) :
    (tateComplex N).d 0 1 ((tateZeroEquiv G N).inv x.1) = 0 := by
  apply (ModuleCat.mono_iff_injective
    (groupCohomology.cochainsIso₁ N).hom).1 inferInstance
  have hd : (groupCohomology.cochainsIso₀ N).hom ≫ groupCohomology.d₀₁ N =
      (tateComplex N).d 0 1 ≫ (groupCohomology.cochainsIso₁ N).hom :=
    groupCohomology.comp_d₀₁_eq N
  calc
    _ = groupCohomology.d₀₁ N
        ((groupCohomology.cochainsIso₀ N).hom
          ((groupCohomology.cochainsIso₀ N).inv x.1)) :=
      (ConcreteCategory.congr_hom hd
        ((groupCohomology.cochainsIso₀ N).inv x.1)).symm
    _ = groupCohomology.d₀₁ N x.1 := by
      rw [(groupCohomology.cochainsIso₀ N).inv_hom_id_apply]
    _ = 0 := by
      ext g
      change N.ρ g x.1 - x.1 = 0
      rw [x.2 g, sub_self]
    _ = (groupCohomology.cochainsIso₁ N).hom 0 := (map_zero _).symm

private def tateZeroCycle (N : Rep ℤ G) (x : Inhomogeneous.invariants0 N) :
    (tateComplex N).cycles 0 :=
  (tateComplex N).cyclesMk ((tateZeroEquiv G N).inv x.1) 1 (by simp)
    (tateZeroEquiv_inv_invariant_cycle G N x)

private lemma comparisonH0Tate_mk_eq_homologyπ (N : Rep ℤ G)
    (x : Inhomogeneous.invariants0 N) :
    TateLowDegree.comparisonH0Tate N
      (QuotientAddGroup.mk' (TateLowDegree.normRangeInInvariants N) x) =
      (tateComplex N).homologyπ 0 (tateZeroCycle G N x) := by
  simp only [TateLowDegree.comparisonH0Tate, AddEquiv.trans_apply,
    AddEquiv.coe_toAddMonoidHom, QuotientAddGroup.map_mk',
    AddEquiv.ofBijective_apply, tateZeroCycle, tateZeroEquiv]
  let eSc := (tateComplex N).isoSc' ((-1 : ℤ)) 0 1 (by simp) (by simp)
  let et : tateCohomology N 0 ≅
      ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData.H :=
    (ShortComplex.leftHomologyIso ((tateComplex N).sc 0)).symm ≪≫
      ShortComplex.leftHomologyMapIso' eSc _
        ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData
  change et.inv _ = _
  apply (ModuleCat.mono_iff_injective et.hom).1 inferInstance
  rw [et.inv_hom_id_apply]
  have hcat : (tateComplex N).homologyπ 0 ≫ et.hom =
      ShortComplex.cyclesMap' eSc.hom
          ((tateComplex N).sc 0).leftHomologyData
          ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData ≫
        ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData.π := by
    change ((tateComplex N).sc 0).homologyπ ≫
        (((tateComplex N).sc 0).leftHomologyIso.symm ≪≫
          ShortComplex.leftHomologyMapIso' eSc _
            ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData).hom = _
    simp only [Iso.trans_hom, Iso.symm_hom]
    rw [ShortComplex.homologyπ_comp_leftHomologyIso_inv_assoc]
    exact ShortComplex.leftHomologyπ_naturality' eSc.hom _ _
  symm
  have happ := ConcreteCategory.congr_hom hcat (tateZeroCycle G N x)
  rw [ConcreteCategory.comp_apply] at happ
  refine happ.trans ?_
  change ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData.π
      (ShortComplex.cyclesMap' eSc.hom
        ((tateComplex N).sc 0).leftHomologyData
        ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData
        (tateZeroCycle G N x)) = _
  change QuotientAddGroup.mk' _
      (ShortComplex.cyclesMap' eSc.hom
        ((tateComplex N).sc 0).leftHomologyData
        ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData
        (tateZeroCycle G N x)) = QuotientAddGroup.mk' _ _
  congr 1
  apply (ModuleCat.mono_iff_injective
    ((tateComplex N).sc' ((-1 : ℤ)) 0 1).moduleCatLeftHomologyData.i).1
      inferInstance
  rw [← ConcreteCategory.comp_apply, ShortComplex.cyclesMap'_i]
  change (tateComplex N).iCycles 0 (tateZeroCycle G N x) =
    (tateZeroEquiv G N).inv x.1
  exact (tateComplex N).i_cyclesMk _ _ _ _

private def firstBarLift (g : G) : G →₀ barRegular G :=
  Finsupp.single g (Finsupp.single 1 1) +
    Finsupp.single g⁻¹ (barAugmentationCocycle g⁻¹).1

private lemma firstBarLift_projection (g : G) :
    Finsupp.mapRange.linearMap (barAugmentation G).hom.toLinearMap (firstBarLift G g) =
      Finsupp.single g 1 := by
  rw [firstBarLift, map_add]
  simp only [Finsupp.mapRange.linearMap_apply, Finsupp.mapRange_single]
  change Finsupp.single g ((barAugmentation G).hom (Finsupp.single 1 1)) +
    Finsupp.single g⁻¹ ((barAugmentation G).hom (barAugmentationCocycle g⁻¹).1) = _
  rw [barAugmentation_single]
  have hzero : (barAugmentation G).hom (barAugmentationCocycle g⁻¹).1 = 0 :=
    (barAugmentationCocycle g⁻¹).2
  rw [hzero, Finsupp.single_zero, add_zero]

private lemma firstBarLift_boundary (g : G) :
    groupHomology.d₁₀ (barRegular G) (firstBarLift G g) =
      (barAugmentationInclusion G).hom (-barAugmentationCocycle g) := by
  rw [firstBarLift, map_add, groupHomology.d₁₀_single,
    groupHomology.d₁₀_single, inv_inv]
  have hact := Rep.hom_comm_apply (barAugmentationInclusion G) g
    (barAugmentationCocycle g⁻¹)
  rw [barAugmentationCocycle_action] at hact
  have hact' : (barRegular G).ρ g (barAugmentationCocycle g⁻¹).1 =
      (-barAugmentationCocycle g).1 := by
    simpa [barAugmentationCocycle] using hact
  change (barRegular G).ρ g⁻¹ (Finsupp.single 1 1) -
      Finsupp.single 1 1 +
      ((barRegular G).ρ g (barAugmentationCocycle g⁻¹).1 -
        (barAugmentationCocycle g⁻¹).1) =
    (-barAugmentationCocycle g).1
  rw [hact']
  change (barRegular G).ρ g⁻¹ (Finsupp.single 1 1) -
      Finsupp.single 1 1 +
      ((-barAugmentationCocycle g).1 - (barAugmentationCocycle g⁻¹).1) =
    (-barAugmentationCocycle g).1
  have hreg : (barRegular G).ρ g⁻¹ (Finsupp.single 1 1) =
      (barAugmentationCocycle g⁻¹).1 + Finsupp.single 1 1 := by
    rw [Representation.ofMulAction_single]
    simp [barAugmentationCocycle, smul_eq_mul]
  rw [hreg]
  abel

private def tateMinusTwoBarCycle (g : G) :
    (tateComplex (Rep.trivial ℤ G ℤ)).cycles (-2) :=
  let A := Rep.trivial ℤ G ℤ
  let z : groupHomology.cycles₁ A :=
    (groupHomology.cycles₁IsoOfIsTrivial A).inv (Finsupp.single g 1)
  (tateComplex A).cyclesMk ((groupHomology.chainsIso₁ A).inv z.1) (-1) (by simp) (by
    change (groupHomology.inhomogeneousChains A).d 1 0
      ((groupHomology.chainsIso₁ A).inv z.1) = 0
    rw [groupHomology.eq_d₁₀_comp_inv_apply]
    apply (ModuleCat.mono_iff_injective (groupHomology.chainsIso₀ A).hom).1 inferInstance
    rw [(groupHomology.chainsIso₀ A).inv_hom_id_apply]
    change groupHomology.d₁₀ A z.1 = 0
    exact z.2)

private def negativeBarCycle (g : G) :
    (tateComplex (barAugmentationIdeal G)).cycles (-1) :=
  (tateComplex (barAugmentationIdeal G)).cyclesMk
    ((groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
      (-barAugmentationCocycle g)) 0 (by simp) (by
        change (barAugmentationIdeal G).tateNorm
          ((groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
            (-barAugmentationCocycle g)) = 0
        apply (ModuleCat.mono_iff_injective
          (groupCohomology.cochainsIso₀ (barAugmentationIdeal G)).hom).1 inferInstance
        have hnorm : (barAugmentationIdeal G).norm.hom
            (-barAugmentationCocycle g) = 0 := by
          rw [map_neg, barAugmentationCocycle_norm, neg_zero]
        simpa [Rep.tateNorm] using hnorm)

private lemma tateBarGenerator_eq_homologyπ (g : G) :
    tateBarGenerator G g =
      (tateComplex (Rep.trivial ℤ G ℤ)).homologyπ (-2) (tateMinusTwoBarCycle G g) := by
  let e := (TateCohomology.isoGroupHomology (-2) 1
    (by norm_num : (-2 : ℤ) = -(1 + 1))).app (Rep.trivial ℤ G ℤ)
  apply (ModuleCat.mono_iff_injective e.hom).1 inferInstance
  dsimp [tateBarGenerator]
  rw [e.inv_hom_id_apply]
  let rhi := (tateComplexConnectData (Rep.trivial ℤ G ℤ)).cochainComplex.restrictionHomologyIso
    (ComplexShape.embeddingUpIntLE (-1)) 2 1 0 (by simp) (by simp)
      (i' := (-3 : ℤ)) (j' := (-2 : ℤ)) (k' := (-1 : ℤ))
      (by simp) (by simp) (by simp) (by simp) (by simp)
  let ri := (tateComplexConnectData (Rep.trivial ℤ G ℤ)).restrictionLEIso
  let rci := (tateComplex (Rep.trivial ℤ G ℤ)).restrictionCyclesIso
    (ComplexShape.embeddingUpIntLE (-1)) 1 0 (by simp)
      (j' := (-2 : ℤ)) (k' := (-1 : ℤ)) (by simp) (by simp) (by simp)
  have hcycle :
      (tateComplex (Rep.trivial ℤ G ℤ)).iCycles (-2) (tateMinusTwoBarCycle G g) =
        (groupHomology.chainsIso₁ (Rep.trivial ℤ G ℤ)).inv
          ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
            (Finsupp.single g 1)).1 := by
    simp only [tateMinusTwoBarCycle]
    exact (tateComplex (Rep.trivial ℤ G ℤ)).i_cyclesMk _ _ _ _
  have hstandard :
      (groupHomology.inhomogeneousChains (Rep.trivial ℤ G ℤ)).iCycles 1
          ((groupHomology.isoCycles₁ (Rep.trivial ℤ G ℤ)).inv
            ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
              (Finsupp.single g 1))) =
        (groupHomology.chainsIso₁ (Rep.trivial ℤ G ℤ)).inv
          ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
            (Finsupp.single g 1)).1 := by
    exact ConcreteCategory.congr_hom
      (groupHomology.isoCycles₁_inv_comp_iCycles (Rep.trivial ℤ G ℤ)) _
  have hcycles :
      (HomologicalComplex.cyclesMap ri.hom 1) (rci.inv (tateMinusTwoBarCycle G g)) =
        (groupHomology.isoCycles₁ (Rep.trivial ℤ G ℤ)).inv
          ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
            (Finsupp.single g 1)) := by
    apply (ModuleCat.mono_iff_injective
      ((groupHomology.inhomogeneousChains (Rep.trivial ℤ G ℤ)).iCycles 1)).1 inferInstance
    rw [← ConcreteCategory.comp_apply, HomologicalComplex.cyclesMap_i]
    conv_lhs => rw [← ConcreteCategory.comp_apply]
    rw [HomologicalComplex.restrictionCyclesIso_inv_iCycles_assoc]
    simp only [ConcreteCategory.comp_apply]
    rw [hcycle, hstandard]
    let rx := (tateComplex (Rep.trivial ℤ G ℤ)).restrictionXIso
      (ComplexShape.embeddingUpIntLE (-1))
      (by simp : (ComplexShape.embeddingUpIntLE (-1)).f 1 = (-2 : ℤ))
    have hri : ri.hom.f 1 = rx.hom := rfl
    rw [hri]
    change rx.hom (rx.inv
      ((groupHomology.chainsIso₁ (Rep.trivial ℤ G ℤ)).inv
        ((groupHomology.cycles₁IsoOfIsTrivial (Rep.trivial ℤ G ℤ)).inv
          (Finsupp.single g 1)).1)) = _
    exact rx.hom_inv_id_apply _
  have he : e = rhi.symm ≪≫ HomologicalComplex.homologyMapIso ri 1 := rfl
  rw [he]
  simp only [Iso.trans_hom, Iso.symm_hom]
  change _ = (rhi.inv ≫ (HomologicalComplex.homologyMapIso ri 1).hom)
    ((tateComplex (Rep.trivial ℤ G ℤ)).homologyπ (-2) (tateMinusTwoBarCycle G g))
  conv_rhs => rw [← ConcreteCategory.comp_apply]
  rw [HomologicalComplex.homologyπ_restrictionHomologyIso_inv_assoc]
  rw [HomologicalComplex.homologyMapIso_hom]
  rw [HomologicalComplex.homologyπ_naturality]
  change _ = (groupHomology.inhomogeneousChains (Rep.trivial ℤ G ℤ)).homologyπ 1
    ((HomologicalComplex.cyclesMap ri.hom 1) (rci.inv (tateMinusTwoBarCycle G g)))
  rw [hcycles]
  rfl

private lemma firstConnecting_barGenerator (g : G) :
    TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2)
        (tateBarGenerator G g) =
      (tateComplex (barAugmentationIdeal G)).homologyπ (-1) (negativeBarCycle G g) := by
  rw [tateBarGenerator_eq_homologyπ]
  let A := Rep.trivial ℤ G ℤ
  let z : groupHomology.cycles₁ A :=
    (groupHomology.cycles₁IsoOfIsTrivial A).inv (Finsupp.single g 1)
  let x3 := (groupHomology.chainsIso₁ A).inv z.1
  let x2 := (groupHomology.chainsIso₁ (barRegular G)).inv (firstBarLift G g)
  let x1 := (groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
    (-barAugmentationCocycle g)
  have hx3 : (tateComplex A).d (-2) (-1) x3 = 0 := by
    change (groupHomology.inhomogeneousChains A).d 1 0
      ((groupHomology.chainsIso₁ A).inv z.1) = 0
    rw [groupHomology.eq_d₁₀_comp_inv_apply]
    apply (ModuleCat.mono_iff_injective (groupHomology.chainsIso₀ A).hom).1 inferInstance
    rw [(groupHomology.chainsIso₀ A).inv_hom_id_apply]
    exact z.2
  have hx2 : (tateComplex.map (barAugmentation G)).f (-2) x2 = x3 := by
    change (groupHomology.chainsMap (.id G) (barAugmentation G)).f 1
      ((groupHomology.chainsIso₁ (barRegular G)).inv (firstBarLift G g)) =
        (groupHomology.chainsIso₁ A).inv z.1
    apply (ModuleCat.mono_iff_injective (groupHomology.chainsIso₁ A).hom).1 inferInstance
    rw [← ConcreteCategory.comp_apply, groupHomology.chainsMap_f_1_comp_chainsIso₁]
    rw [ConcreteCategory.comp_apply,
      (groupHomology.chainsIso₁ (barRegular G)).inv_hom_id_apply,
      (groupHomology.chainsIso₁ A).inv_hom_id_apply]
    have hp := (firstBarLift_projection G g).trans
      (groupHomology.cycles₁IsoOfIsTrivial_inv_apply (A := A) _).symm
    simpa [groupHomology.chainsMap₁] using hp
  have hx1 : (tateComplex.map (barAugmentationInclusion G)).f (-1) x1 =
      (tateComplex (barRegular G)).d (-2) (-1) x2 := by
    change (groupHomology.chainsMap (.id G) (barAugmentationInclusion G)).f 0
        ((groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
          (-barAugmentationCocycle g)) =
      (groupHomology.inhomogeneousChains (barRegular G)).d 1 0
        ((groupHomology.chainsIso₁ (barRegular G)).inv (firstBarLift G g))
    apply (ModuleCat.mono_iff_injective
      (groupHomology.chainsIso₀ (barRegular G)).hom).1 inferInstance
    rw [← ConcreteCategory.comp_apply, groupHomology.chainsMap_f_0_comp_chainsIso₀]
    rw [ConcreteCategory.comp_apply,
      (groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv_hom_id_apply]
    rw [← ConcreteCategory.comp_apply, ← groupHomology.comp_d₁₀_eq]
    rw [ConcreteCategory.comp_apply,
      (groupHomology.chainsIso₁ (barRegular G)).inv_hom_id_apply]
    exact (firstBarLift_boundary G g).symm
  let x1' : (forget₂ (ModuleCat ℤ) Ab).obj
      (((barAugmentationSequence G).map (tateComplexFunctor ℤ G)).X₁.X (-1)) := x1
  have hx3' :
      ((barAugmentationSequence G).map (tateComplexFunctor ℤ G)).X₃.d (-2) (-1) x3 = 0 := by
    change (tateComplex A).d (-2) (-1) x3 = 0
    exact hx3
  have hδ := (TateCohomology.map_tateComplexFunctor_shortExact
    (barAugmentationSequence_shortExact (G := G))).δ_apply
      (-2) (-1) (by simp) x3 (by simpa using! hx3')
        x2 (by simpa using! hx2) x1' (by simpa [x1'] using! hx1) 0 (by simp)
  simpa only [x3, x2, x1, x1', tateMinusTwoBarCycle, negativeBarCycle] using! hδ

private def negativeRowInvariant (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (hrow : ∀ g, (∑ x : G, a x g) ∈ Inhomogeneous.invariants0 M) (g : G) :
    Inhomogeneous.invariants0 M :=
  -⟨∑ x : G, a x g, hrow g⟩

@[simp] private lemma cocyclePushout_ρ_apply (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M) (g : G)
    (p : M × barAugmentationIdeal G) :
    (cocyclePushout M a ha).ρ g p =
      (M.ρ g p.1 + cocycleTwist M a g p.2,
        (barAugmentationIdeal G).ρ g p.2) := rfl

@[simp] private lemma cocyclePushoutProjection_apply_pair (M : Rep ℤ G)
    (a : Inhomogeneous.C2 M) (ha : a ∈ Inhomogeneous.cocycles2 M)
    (p : M × barAugmentationIdeal G) :
    (cocyclePushoutProjection M a ha).hom p = p.2 := rfl

@[simp] private lemma cocyclePushoutInclusion_apply_pair (M : Rep ℤ G)
    (a : Inhomogeneous.C2 M) (ha : a ∈ Inhomogeneous.cocycles2 M) (m : M) :
    (cocyclePushoutInclusion M a ha).hom m = (m, 0) := rfl

set_option backward.isDefEq.respectTransparency false in
private lemma cocyclePushout_negativeBar_norm (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M) (g : G) :
    (cocyclePushout M a ha).norm.hom
        ((0, -barAugmentationCocycle g) : cocyclePushout M a ha) =
      (cocyclePushoutInclusion M a ha).hom (-(∑ x : G, a x g)) := by
  rw [Rep.norm_apply, Representation.norm]
  simp only [LinearMap.sum_apply]
  apply Prod.ext
  · rw [Prod.fst_sum]
    simp only [cocyclePushout_ρ_apply, cocyclePushoutInclusion_apply_pair,
      map_zero, zero_add, map_neg, Finset.sum_neg_distrib]
    simp_rw [cocycleTwist_barAugmentationCocycle M a ha]
    rfl
  · rw [Prod.snd_sum]
    simp only [cocyclePushout_ρ_apply, cocyclePushoutInclusion_apply_pair]
    change (∑ x : G, (barAugmentationIdeal G).ρ x
        (-barAugmentationCocycle g)) = 0
    have hn : (barAugmentationIdeal G).norm.hom (-barAugmentationCocycle g) = 0 := by
      rw [map_neg, barAugmentationCocycle_norm, neg_zero]
    rw [Rep.norm_apply, Representation.norm] at hn
    simpa only [LinearMap.sum_apply] using hn

private lemma secondConnecting_negativeBar (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M)
    (hrow : ∀ g, (∑ x : G, a x g) ∈ Inhomogeneous.invariants0 M) (g : G) :
    TateCohomology.δ (cocyclePushoutSequence_shortExact M a ha) (-1)
        ((tateComplex (barAugmentationIdeal G)).homologyπ (-1) (negativeBarCycle G g)) =
      (tateComplex M).homologyπ 0
        (tateZeroCycle G M (negativeRowInvariant G M a hrow g)) := by
  let P := cocyclePushout M a ha
  let v : P := (0, -barAugmentationCocycle g)
  let x3 := (groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
    (-barAugmentationCocycle g)
  let x2 := (groupHomology.chainsIso₀ P).inv v
  let x1 := (tateZeroEquiv G M).inv (negativeRowInvariant G M a hrow g).1
  have hx3 : (tateComplex (barAugmentationIdeal G)).d (-1) 0 x3 = 0 := by
    change (barAugmentationIdeal G).tateNorm
      ((groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
        (-barAugmentationCocycle g)) = 0
    apply (ModuleCat.mono_iff_injective
      (groupCohomology.cochainsIso₀ (barAugmentationIdeal G)).hom).1 inferInstance
    have hn : (barAugmentationIdeal G).norm.hom (-barAugmentationCocycle g) = 0 := by
      rw [map_neg, barAugmentationCocycle_norm, neg_zero]
    simpa [Rep.tateNorm] using hn
  have hx2 : (tateComplex.map (cocyclePushoutProjection M a ha)).f (-1) x2 = x3 := by
    change (groupHomology.chainsMap (.id G) (cocyclePushoutProjection M a ha)).f 0
        ((groupHomology.chainsIso₀ P).inv v) =
      (groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv
        (-barAugmentationCocycle g)
    apply (ModuleCat.mono_iff_injective
      (groupHomology.chainsIso₀ (barAugmentationIdeal G)).hom).1 inferInstance
    rw [← ConcreteCategory.comp_apply, groupHomology.chainsMap_f_0_comp_chainsIso₀]
    rw [ConcreteCategory.comp_apply, (groupHomology.chainsIso₀ P).inv_hom_id_apply,
      (groupHomology.chainsIso₀ (barAugmentationIdeal G)).inv_hom_id_apply]
    change (cocyclePushoutProjection M a ha).hom v = -barAugmentationCocycle g
    rfl
  have hx1 : (tateComplex.map (cocyclePushoutInclusion M a ha)).f 0 x1 =
      (tateComplex P).d (-1) 0 x2 := by
    change (groupCohomology.cochainsMap (.id G) (cocyclePushoutInclusion M a ha)).f 0
        ((tateZeroEquiv G M).inv (negativeRowInvariant G M a hrow g).1) =
      P.tateNorm ((groupHomology.chainsIso₀ P).inv v)
    apply (ModuleCat.mono_iff_injective (groupCohomology.cochainsIso₀ P).hom).1
      inferInstance
    rw [← ConcreteCategory.comp_apply,
      groupCohomology.cochainsMap_f_0_comp_cochainsIso₀]
    rw [ConcreteCategory.comp_apply]
    change (cocyclePushoutInclusion M a ha).hom
        ((groupCohomology.cochainsIso₀ M).hom
          ((groupCohomology.cochainsIso₀ M).inv
            (negativeRowInvariant G M a hrow g).1)) =
      (groupCohomology.cochainsIso₀ P).hom
        (P.tateNorm ((groupHomology.chainsIso₀ P).inv v))
    rw [(groupCohomology.cochainsIso₀ M).inv_hom_id_apply]
    have hn := (cocyclePushout_negativeBar_norm G M a ha g).symm
    simpa [P, v, negativeRowInvariant, Rep.tateNorm] using hn
  let x1' : (forget₂ (ModuleCat ℤ) Ab).obj
      (((cocyclePushoutSequence M a ha).map (tateComplexFunctor ℤ G)).X₁.X 0) := x1
  have hx3' : ((cocyclePushoutSequence M a ha).map
      (tateComplexFunctor ℤ G)).X₃.d (-1) 0 x3 = 0 := by
    change (tateComplex (barAugmentationIdeal G)).d (-1) 0 x3 = 0
    exact hx3
  have hδ := (TateCohomology.map_tateComplexFunctor_shortExact
    (cocyclePushoutSequence_shortExact M a ha)).δ_apply
      (-1) 0 (by simp) x3 (by simpa using! hx3') x2 (by simpa using! hx2)
        x1' (by simpa [x1'] using! hx1) 1 (by simp)
  simpa only [x3, x2, x1, x1', negativeBarCycle, tateZeroCycle] using! hδ

private lemma negativeRow_homologyπ (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (hrow : ∀ g, (∑ x : G, a x g) ∈ Inhomogeneous.invariants0 M) (g : G) :
    (tateComplex M).homologyπ 0
        (tateZeroCycle G M (negativeRowInvariant G M a hrow g)) =
      -rowSumTateClass G M a hrow g := by
  rw [← comparisonH0Tate_mk_eq_homologyπ]
  change TateLowDegree.comparisonH0Tate M
      (QuotientAddGroup.mk' (TateLowDegree.normRangeInInvariants M)
        (-⟨∑ x : G, a x g, hrow g⟩)) =
    -TateLowDegree.comparisonH0Tate M
      (QuotientAddGroup.mk' (TateLowDegree.normRangeInInvariants M)
        ⟨∑ x : G, a x g, hrow g⟩)
  rw [← map_neg]
  rfl

private lemma twoConnectingMap_bar_apply (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M)
    (x : TateLowDegree.HMinusTwo (Rep.trivial ℤ G ℤ)) :
    twoConnectingMap G (barDimensionShiftData G M a ha) x =
      TateCohomology.δ (cocyclePushoutSequence_shortExact M a ha) (-1)
        (TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2) x) := by
  let D := barDimensionShiftData G M a ha
  change (tateCohomologyFunctor 0).map D.targetIso.hom
      (TateCohomology.δ D.cocycleExact (-1)
        ((tateCohomologyFunctor (-1)).map D.augmentationIdealIso.hom
          (TateCohomology.δ D.augmentationExact (-2)
            ((tateCohomologyFunctor (-2)).map D.sourceIso.hom x)))) = _
  have hs : (tateCohomologyFunctor (-2)).map D.sourceIso.hom x = x := by
    dsimp [D, barDimensionShiftData]
    exact CategoryTheory.Functor.map_id_apply
      (tateCohomologyFunctor (-2)) (Rep.trivial ℤ G ℤ) x
  rw [hs]
  have hm : (tateCohomologyFunctor (-1)).map D.augmentationIdealIso.hom
      (TateCohomology.δ D.augmentationExact (-2) x) =
        TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2) x := by
    dsimp [D, barDimensionShiftData]
    exact CategoryTheory.Functor.map_id_apply
      (tateCohomologyFunctor (-1)) (barAugmentationSequence G).X₁
      (TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2) x)
  rw [hm]
  have ht : (tateCohomologyFunctor 0).map D.targetIso.hom
      (TateCohomology.δ D.cocycleExact (-1)
        (TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2) x)) =
      TateCohomology.δ (cocyclePushoutSequence_shortExact M a ha) (-1)
        (TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2) x) := by
    dsimp [D, barDimensionShiftData]
    exact CategoryTheory.Functor.map_id_apply
      (tateCohomologyFunctor 0) (cocyclePushoutSequence M a ha).X₁
      (TateCohomology.δ (cocyclePushoutSequence_shortExact M a ha) (-1)
        (TateCohomology.δ (barAugmentationSequence_shortExact (G := G)) (-2) x))
  exact ht

/--
**C07**, Theorem `thm:tate-reciprocity` (bar generator): tracing the explicit bar chain `[g]`
through the actual connecting maps of the augmentation and cocycle-pushout sequences gives the
negative pinned row-sum class.  Unlike the old existential formulation, neither the source class
nor its image can be manufactured using an arbitrary equivalence.

Sign convention: the honest connecting-map composite produces the NEGATIVE row-sum class; the
finite-reciprocity Frobenius normalization must consume this sign.
-/
theorem tateMinusTwo_barGenerator (M : Rep ℤ G) (a : Inhomogeneous.C2 M)
    (ha : a ∈ Inhomogeneous.cocycles2 M)
    (hrow : ∀ g, (∑ x : G, a x g) ∈ Inhomogeneous.invariants0 M) (g : G) :
    twoConnectingMap G (barDimensionShiftData G M a ha) (tateBarGenerator G g) =
      -rowSumTateClass G M a hrow g := by
  rw [twoConnectingMap_bar_apply G M a ha]
  rw [firstConnecting_barGenerator G g]
  rw [secondConnecting_negativeBar G M a ha hrow g]
  exact negativeRow_homologyπ G M a hrow g

end Abelianization

/--
**C07**, Theorem `thm:tate-reciprocity`: the two connecting maps used in dimension shifting are
natural for a morphism of short exact sequences.  This is the low-degree project-facing form of
`TateCohomology.δ_naturality`.
-/
theorem tateConnecting_naturality
    {G : Type} [Group G] [Fintype G]
    {X Y : ShortComplex (Rep ℤ G)}
    (hX : X.ShortExact) (hY : Y.ShortExact) (F : X ⟶ Y) (n : ℤ) :
    TateCohomology.δ hX n ≫ (tateCohomologyFunctor (n + 1)).map F.τ₁ =
      (tateCohomologyFunctor n).map F.τ₃ ≫ TateCohomology.δ hY n := by
  exact TateCohomology.δ_naturality hX hY F n

end

