import Mathlib

/-!
# §1. T-rigid and T-basic elements (AEJ, journal pp. 450–452)

The paper works with multiplicative subgroups of `Ḟ = F ∖ {0}`.  They are kept
as subsets of `F`, together with `IsMulSubgroup`, so its pointwise set formulas
can be stated literally.
-/

open Pointwise

namespace NU.AEJ

noncomputable section

variable {F : Type*} [Field F]

/-- A multiplicative subgroup of `Ḟ`, represented by its carrier in `F`.
This is the standing convention of AEJ, Definition 1.1, journal p. 450. -/
structure IsMulSubgroup (T : Set F) : Prop where
  one_mem : (1 : F) ∈ T
  mul_mem : ∀ ⦃a b : F⦄, a ∈ T → b ∈ T → a * b ∈ T
  inv_mem : ∀ ⦃a : F⦄, a ∈ T → a⁻¹ ∈ T
  zero_notMem : (0 : F) ∉ T

/-- AEJ, Definition 1.1, journal p. 450: `a` is `T`-rigid when
`T + aT ⊆ T ∪ aT`. -/
def IsRigid (T : Set F) (a : F) : Prop :=
  T + a • T ⊆ T ∪ a • T

/-- AEJ, Definition 1.8, journal p. 452: `a` is `T`-birigid when both `a` and
`-a` are `T`-rigid. -/
def IsBirigid (T : Set F) (a : F) : Prop :=
  IsRigid T a ∧ IsRigid T (-a)

/-- AEJ, Definition 1.8, journal p. 452: the basic part `B_F(T)` consists of
nonzero elements which are not `T`-birigid. -/
def basicPart (T : Set F) : Set F :=
  {a : F | a ≠ 0 ∧ ¬IsBirigid T a}

/-- The carrier in `F` of the unit group of a valuation ring.  This realizes
the notation `U_A` from AEJ, Notation 1.3, journal p. 451. -/
def ValuationSubring.unitCarrier (A : ValuationSubring F) : Set F :=
  (fun u : Fˣ => (u : F)) '' (A.unitGroup : Set Fˣ)

/-- The carrier in `F` of the principal-unit group.  This realizes `U_A¹` from
AEJ, Notation 1.3, journal p. 451. -/
def ValuationSubring.principalUnitCarrier (A : ValuationSubring F) : Set F :=
  (fun u : Fˣ => (u : F)) '' (A.principalUnitGroup : Set Fˣ)

/-- The set `1 + 𝔪_A` in `F`, where `𝔪_A` is represented by `A.nonunits`.
By the Mathlib valuation API this equals the principal-unit carrier.  This is
AEJ, Notation 1.3, journal p. 451. -/
def ValuationSubring.onePlusMaximalIdeal (A : ValuationSubring F) : Set F :=
  ({1} : Set F) + (A.nonunits : Set F)

/-- The residue of a unit, coerced from the residue-field unit group to the
residue field.  This implements the bar notation in AEJ, Notation 1.3,
journal p. 451. -/
def ValuationSubring.residueOfUnit (A : ValuationSubring F) (u : A.unitGroup) :
    IsLocalRing.ResidueField A :=
  A.unitGroupToResidueFieldUnits u

/-- The image `T̄` of `U_A ∩ T` in the residue field, as used in AEJ,
Proposition 1.5, journal p. 451. -/
def ValuationSubring.residueImage (A : ValuationSubring F) (T : Set F) :
    Set (IsLocalRing.ResidueField A) :=
  {r | ∃ u : A.unitGroup, ((u : Fˣ) : F) ∈ T ∧
    ValuationSubring.residueOfUnit A u = r}

/-- AEJ, Definition 1.7, journal p. 452: a valuation ring is `T`-compatible
when `U_A¹ ⊆ T`. -/
def ValuationSubring.IsCompatible (A : ValuationSubring F) (T : Set F) : Prop :=
  ValuationSubring.principalUnitCarrier A ⊆ T

/-- The subgroup of `Fˣ` generated by a set of field elements.  Its carrier in
`F` is the interpretation of `⟨S⟩` used from AEJ, Notation 2.1, journal p. 453. -/
def mulSubgroupClosure (S : Set F) : Subgroup Fˣ :=
  Subgroup.closure {u : Fˣ | (u : F) ∈ S}

/-- The carrier in `F` of `mulSubgroupClosure S`; this is the set-level
interpretation of `⟨S⟩` in AEJ, Notation 2.1, journal p. 453. -/
def mulSubgroupClosureCarrier (S : Set F) : Set F :=
  (fun u : Fˣ => (u : F)) '' (mulSubgroupClosure S : Set Fˣ)

/-- A set-level rendering of `[X : Y] ≤ 2`: `Y ⊆ X` and `X` is covered by at
most two left `Y`-cosets.  This is used for the index assertions in AEJ,
Theorem 2.16, journal p. 458.  It avoids `Subgroup.index = 0` for infinite
index in Mathlib. -/
def HasIndexAtMostTwo (X Y : Set F) : Prop :=
  Y ⊆ X ∧ ∃ a : F, X ⊆ Y ∪ a • Y

/-- A set `S ⊆ F` is the carrier of a valuation ring when a
`ValuationSubring F` has exactly that carrier.  This is the project-wide
interpretation of “`S` is a valuation ring of `F`”, as in AEJ, Theorem 2.10,
journal p. 456. -/
def IsValuationRingCarrier (S : Set F) : Prop :=
  ∃ A : ValuationSubring F, (A : Set F) = S

private theorem one_add_mem_of_valuation_lt (A : ValuationSubring F) (T : Set F)
    (hcompat : ValuationSubring.IsCompatible A T) {x : F}
    (hx : A.valuation x < 1) : 1 + x ∈ T := by
  apply hcompat
  have hne : 1 + x ≠ 0 := by
    intro hzero
    have hv : A.valuation (1 + x) = 1 := A.valuation.map_one_add_of_lt hx
    rw [hzero, A.valuation.map_zero] at hv
    exact zero_ne_one hv
  let u : Fˣ := Units.mk0 (1 + x) hne
  refine ⟨u, ?_, rfl⟩
  change u ∈ A.principalUnitGroup
  rw [A.mem_principalUnitGroup_iff]
  change A.valuation ((1 + x) - 1) < 1
  simpa using hx

private theorem rigid_mul_right (T : Set F) (hT : IsMulSubgroup T)
    {a t : F} (ht : t ∈ T) (h : IsRigid T a) : IsRigid T (a * t) := by
  have ht0 : t ≠ 0 := fun he => hT.zero_notMem (he ▸ ht)
  rintro z ⟨s, hs, y, ⟨u, hu, rfl⟩, rfl⟩
  change s + (a * t) * u ∈ T ∪ (a * t) • T
  have htu := hT.mul_mem ht hu
  have hz := h (Set.add_mem_add hs (Set.smul_mem_smul_set htu))
  change s + a * (t * u) ∈ T ∪ a • T at hz
  rcases hz with hz | ⟨v, hv, hv_eq⟩
  · left
    convert hz using 1 <;> ring
  · right
    refine ⟨t⁻¹ * v, hT.mul_mem (hT.inv_mem ht) hv, ?_⟩
    simp only [smul_eq_mul]
    change a * v = s + a * (t * u) at hv_eq
    calc
      (a * t) * (t⁻¹ * v) = a * v := by field_simp
      _ = s + a * (t * u) := hv_eq
      _ = s + (a * t) * u := by ring

private def negUnit (A : ValuationSubring F) (u : A.unitGroup) : A.unitGroup :=
  ⟨(-1 : Fˣ) * (u : Fˣ), by
    apply A.unitGroup.mul_mem _ u.property
    rw [A.mem_unitGroup_iff]
    simp⟩

private theorem coe_negUnit (A : ValuationSubring F) (u : A.unitGroup) :
    (((negUnit A u : A.unitGroup) : Fˣ) : F) = -((u : Fˣ) : F) := by
  simp [negUnit]

private theorem residue_negUnit (A : ValuationSubring F) (u : A.unitGroup) :
    ValuationSubring.residueOfUnit A (negUnit A u) =
      -ValuationSubring.residueOfUnit A u := by
  change IsLocalRing.residue A (A.unitGroupMulEquiv (negUnit A u) : A) =
    -IsLocalRing.residue A (A.unitGroupMulEquiv u : A)
  rw [← map_neg]
  congr 1
  apply Subtype.ext
  change (((negUnit A u : A.unitGroup) : Fˣ) : F) = -((u : Fˣ) : F)
  exact coe_negUnit A u

private theorem residueImage_isMulSubgroup (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) :
    IsMulSubgroup (ValuationSubring.residueImage A T) := by
  constructor
  · refine ⟨1, ?_, ?_⟩
    · simpa using hT.one_mem
    · simp [ValuationSubring.residueOfUnit]
  · rintro x y ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
    refine ⟨u * v, ?_, ?_⟩
    · simpa using hT.mul_mem hu hv
    · simp [ValuationSubring.residueOfUnit]
  · rintro x ⟨u, hu, rfl⟩
    refine ⟨u⁻¹, ?_, ?_⟩
    · simpa using hT.inv_mem hu
    · simp [ValuationSubring.residueOfUnit]
  · rintro ⟨u, -, hu⟩
    exact Units.ne_zero (A.unitGroupToResidueFieldUnits u) hu

private theorem zero_not_mem_union_smul {K : Type*} [Field K] (S : Set K)
    (hS : IsMulSubgroup S) {a : K} (ha : a ≠ 0) :
    (0 : K) ∉ S ∪ a • S := by
  rintro (hz | ⟨x, hx, hax⟩)
  · exact hS.zero_notMem hz
  · have hx0 : x = 0 := by
      apply (mul_eq_zero.mp ?_).resolve_left ha
      simpa [smul_eq_mul] using hax
    exact hS.zero_notMem (hx0 ▸ hx)

private theorem neg_not_mem_of_rigid {K : Type*} [Field K] (S : Set K)
    (hS : IsMulSubgroup S) {a : K} (ha : a ≠ 0) (hr : IsRigid S a) :
    -a ∉ S := by
  intro hneg
  have hz := hr (Set.add_mem_add hneg (Set.smul_mem_smul_set hS.one_mem))
  apply zero_not_mem_union_smul S hS ha
  convert hz using 1 <;> simp [smul_eq_mul]

private theorem unit_mem_of_residue_eq (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T)
    (u v : A.unitGroup) (hv : ((v : Fˣ) : F) ∈ T)
    (huv : ValuationSubring.residueOfUnit A u =
      ValuationSubring.residueOfUnit A v) :
    ((u : Fˣ) : F) ∈ T := by
  let p : A.unitGroup := u * v⁻¹
  have hpker : p ∈ A.unitGroupToResidueFieldUnits.ker := by
    rw [MonoidHom.mem_ker]
    change A.unitGroupToResidueFieldUnits (u * v⁻¹) = 1
    rw [map_mul, map_inv]
    apply Units.ext
    simp only [Units.val_mul, Units.val_inv_eq_inv_val]
    change ValuationSubring.residueOfUnit A u *
      (ValuationSubring.residueOfUnit A v)⁻¹ = 1
    rw [huv]
    exact mul_inv_cancel₀ (Units.ne_zero (A.unitGroupToResidueFieldUnits v))
  have hpprincipal : (p : Fˣ) ∈ A.principalUnitGroup := by
    have hp : p ∈ A.principalUnitGroup.comap A.unitGroup.subtype := by
      rw [← A.ker_unitGroupToResidueFieldUnits]
      exact hpker
    exact hp
  have hpT : ((p : Fˣ) : F) ∈ T := hcompat ⟨p, hpprincipal, rfl⟩
  have hmul := hT.mul_mem hpT hv
  change (((u * v⁻¹ : A.unitGroup) : Fˣ) : F) * ((v : Fˣ) : F) ∈ T at hmul
  simpa using hmul

private theorem unit_mem_iff_residue_mem (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T)
    (u : A.unitGroup) :
    ((u : Fˣ) : F) ∈ T ↔
      ValuationSubring.residueOfUnit A u ∈ ValuationSubring.residueImage A T := by
  constructor
  · intro hu
    exact ⟨u, hu, rfl⟩
  · rintro ⟨v, hv, huv⟩
    exact unit_mem_of_residue_eq A T hT hcompat u v hv huv.symm

private theorem exists_unitGroup_of_valuation_eq_one (A : ValuationSubring F)
    {x : F} (hx : A.valuation x = 1) :
    ∃ u : A.unitGroup, ((u : Fˣ) : F) = x := by
  have hx0 : x ≠ 0 := by
    intro hzero
    rw [hzero, A.valuation.map_zero] at hx
    exact zero_ne_one hx
  let u0 : Fˣ := Units.mk0 x hx0
  refine ⟨⟨u0, ?_⟩, rfl⟩
  rw [A.mem_unitGroup_iff]
  exact hx

private def unitLinearCombination (A : ValuationSubring F)
    (s a t : A.unitGroup) : A :=
  (A.unitGroupMulEquiv s : A) +
    (A.unitGroupMulEquiv a : A) * (A.unitGroupMulEquiv t : A)

private theorem coe_unitLinearCombination (A : ValuationSubring F)
    (s a t : A.unitGroup) :
    (unitLinearCombination A s a t : F) =
      ((s : Fˣ) : F) + ((a : Fˣ) : F) * ((t : Fˣ) : F) := by
  rfl

private theorem residue_unitLinearCombination (A : ValuationSubring F)
    (s a t : A.unitGroup) :
    IsLocalRing.residue A (unitLinearCombination A s a t) =
      ValuationSubring.residueOfUnit A s +
        ValuationSubring.residueOfUnit A a *
          ValuationSubring.residueOfUnit A t := by
  change IsLocalRing.residue A
      ((A.unitGroupMulEquiv s : A) +
        (A.unitGroupMulEquiv a : A) * (A.unitGroupMulEquiv t : A)) =
    IsLocalRing.residue A (A.unitGroupMulEquiv s : A) +
      IsLocalRing.residue A (A.unitGroupMulEquiv a : A) *
        IsLocalRing.residue A (A.unitGroupMulEquiv t : A)
  rw [map_add, map_mul]

private theorem exists_unitGroup_of_residue_ne_zero (A : ValuationSubring F)
    (x : A) (hx : IsLocalRing.residue A x ≠ 0) :
    ∃ u : A.unitGroup, ((u : Fˣ) : F) = (x : F) ∧
      ValuationSubring.residueOfUnit A u = IsLocalRing.residue A x := by
  have hxunit : IsUnit x := (IsLocalRing.residue_ne_zero_iff_isUnit x).mp hx
  let ux : Aˣ := hxunit.unit
  let u : A.unitGroup := A.unitGroupMulEquiv.symm ux
  refine ⟨u, ?_, ?_⟩
  · rw [A.coe_unitGroupMulEquiv_symm_apply]
    exact congrArg Subtype.val hxunit.unit_spec
  · change IsLocalRing.residue A (A.unitGroupMulEquiv u : A) =
      IsLocalRing.residue A x
    congr 1

private theorem unit_sum_mem_of_residue_rigid (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T)
    (a s t : A.unitGroup) (hs : ((s : Fˣ) : F) ∈ T)
    (ht : ((t : Fˣ) : F) ∈ T)
    (hr : IsRigid (ValuationSubring.residueImage A T)
      (ValuationSubring.residueOfUnit A a)) :
    ((s : Fˣ) : F) + ((a : Fˣ) : F) * ((t : Fˣ) : F) ∈
      T ∪ ((a : Fˣ) : F) • T := by
  have hTbar := residueImage_isMulSubgroup A T hT
  have hsbar := (unit_mem_iff_residue_mem A T hT hcompat s).mp hs
  have htbar := (unit_mem_iff_residue_mem A T hT hcompat t).mp ht
  have hsumbar := hr
    (Set.add_mem_add hsbar (Set.smul_mem_smul_set htbar))
  change ValuationSubring.residueOfUnit A s +
      ValuationSubring.residueOfUnit A a *
        ValuationSubring.residueOfUnit A t ∈
    ValuationSubring.residueImage A T ∪
      ValuationSubring.residueOfUnit A a •
        ValuationSubring.residueImage A T at hsumbar
  have hsumbar0 : ValuationSubring.residueOfUnit A s +
      ValuationSubring.residueOfUnit A a *
        ValuationSubring.residueOfUnit A t ≠ 0 := by
    intro hzero
    apply zero_not_mem_union_smul (ValuationSubring.residueImage A T) hTbar
      (Units.ne_zero (A.unitGroupToResidueFieldUnits a))
    exact hzero ▸ hsumbar
  have hxres0 : IsLocalRing.residue A (unitLinearCombination A s a t) ≠ 0 := by
    rw [residue_unitLinearCombination]
    exact hsumbar0
  obtain ⟨c, hc, hcres⟩ :=
    exists_unitGroup_of_residue_ne_zero A (unitLinearCombination A s a t) hxres0
  rw [coe_unitLinearCombination] at hc
  rcases hsumbar with hsumbar | ⟨r, hrT, hra⟩
  · left
    rw [← hc]
    apply (unit_mem_iff_residue_mem A T hT hcompat c).mpr
    rw [hcres, residue_unitLinearCombination]
    exact hsumbar
  · rcases hrT with ⟨v, hv, hvr⟩
    let d : A.unitGroup := a⁻¹ * c
    have hdres : ValuationSubring.residueOfUnit A d =
        ValuationSubring.residueOfUnit A v := by
      calc
        ValuationSubring.residueOfUnit A d =
            (ValuationSubring.residueOfUnit A a)⁻¹ *
              ValuationSubring.residueOfUnit A c := by
                simp [d, ValuationSubring.residueOfUnit]
        _ = (ValuationSubring.residueOfUnit A a)⁻¹ *
              (ValuationSubring.residueOfUnit A s +
                ValuationSubring.residueOfUnit A a *
                  ValuationSubring.residueOfUnit A t) := by
                    rw [hcres, residue_unitLinearCombination]
        _ = r := by
          rw [← hra]
          change (ValuationSubring.residueOfUnit A a)⁻¹ *
              (ValuationSubring.residueOfUnit A a * r) = r
          have ha0 : ValuationSubring.residueOfUnit A a ≠ 0 :=
            Units.ne_zero (A.unitGroupToResidueFieldUnits a)
          rw [← mul_assoc, inv_mul_cancel₀ ha0, one_mul]
        _ = ValuationSubring.residueOfUnit A v := hvr.symm
    have hdT : ((d : Fˣ) : F) ∈ T :=
      unit_mem_of_residue_eq A T hT hcompat d v hv hdres
    right
    refine ⟨((d : Fˣ) : F), hdT, ?_⟩
    simp only [smul_eq_mul]
    rw [← hc]
    simp [d]

/-- AEJ, Proposition 1.5(1), journal p. 451: under `U_A¹ ⊆ T`, every nonzero
element outside `U_A · T` is `T`-rigid. -/
theorem proposition_1_5_part1 (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T) {a : F}
    (ha : a ≠ 0) (ha_out : a ∉ ValuationSubring.unitCarrier A * T) :
    IsRigid T a := by
  rintro z ⟨s, hs, y, ⟨t, ht, rfl⟩, rfl⟩
  change s + a * t ∈ T ∪ a • T
  have hs_ne : s ≠ 0 := fun h => hT.zero_notMem (h ▸ hs)
  have ht_ne : t ≠ 0 := fun h => hT.zero_notMem (h ▸ ht)
  have hat_ne : a * t ≠ 0 := mul_ne_zero ha ht_ne
  have hval_ne : A.valuation s ≠ A.valuation (a * t) := by
    intro heq
    apply ha_out
    refine ⟨a * t / s, ?_, s * t⁻¹, hT.mul_mem hs (hT.inv_mem ht), ?_⟩
    · let u : Fˣ := Units.mk0 (a * t / s) (div_ne_zero hat_ne hs_ne)
      refine ⟨u, ?_, rfl⟩
      change u ∈ A.unitGroup
      rw [A.mem_unitGroup_iff]
      change A.valuation (a * t / s) = 1
      rw [A.valuation.map_div, heq]
      exact div_self (A.valuation.ne_zero_iff.mpr hat_ne)
    · field_simp
  rcases lt_or_gt_of_ne hval_ne with hlt | hgt
  · right
    refine ⟨t * (1 + s / (a * t)), hT.mul_mem ht ?_, ?_⟩
    · apply one_add_mem_of_valuation_lt A T hcompat
      rw [A.valuation.map_div]
      exact (div_lt_one₀ (a := A.valuation s) (b := A.valuation (a * t))
        (A.valuation.pos_iff.mpr hat_ne)).mpr hlt
    · simp only [smul_eq_mul]
      field_simp
      <;> ring
  · left
    have hm := hT.mul_mem hs
      (one_add_mem_of_valuation_lt A T hcompat (x := (a * t) / s) (by
        rw [A.valuation.map_div]
        exact (div_lt_one₀ (a := A.valuation (a * t)) (b := A.valuation s)
          (A.valuation.pos_iff.mpr hs_ne)).mpr hgt))
    convert hm using 1 <;> field_simp <;> ring

/-- AEJ, Proposition 1.5(2), journal p. 451: a unit is `T`-rigid exactly when
its residue is rigid for the image of `U_A ∩ T` in the residue field. -/
theorem proposition_1_5_part2 (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T)
    (a : A.unitGroup) :
    IsRigid T ((a : Fˣ) : F) ↔
      IsRigid (ValuationSubring.residueImage A T)
        (ValuationSubring.residueOfUnit A a) := by
  have hTbar := residueImage_isMulSubgroup A T hT
  constructor
  · intro haRigid
    have hnega : -((a : Fˣ) : F) ∉ T :=
      neg_not_mem_of_rigid T hT (Units.ne_zero (a : Fˣ)) haRigid
    rintro z ⟨sbar, hsbar, ybar, ⟨tbar, htbar, rfl⟩, rfl⟩
    change sbar + ValuationSubring.residueOfUnit A a * tbar ∈
      ValuationSubring.residueImage A T ∪
        ValuationSubring.residueOfUnit A a •
          ValuationSubring.residueImage A T
    rcases hsbar with ⟨s, hs, rfl⟩
    rcases htbar with ⟨t, ht, rfl⟩
    have hsumbar0 : ValuationSubring.residueOfUnit A s +
        ValuationSubring.residueOfUnit A a *
          ValuationSubring.residueOfUnit A t ≠ 0 := by
      intro hzero
      have hnegbar : -ValuationSubring.residueOfUnit A a ∈
          ValuationSubring.residueImage A T := by
        have hprod := hTbar.mul_mem
          ((unit_mem_iff_residue_mem A T hT hcompat s).mp hs)
          (hTbar.inv_mem ((unit_mem_iff_residue_mem A T hT hcompat t).mp ht))
        have ht0 : ValuationSubring.residueOfUnit A t ≠ 0 :=
          Units.ne_zero (A.unitGroupToResidueFieldUnits t)
        have hst : -(ValuationSubring.residueOfUnit A a *
            ValuationSubring.residueOfUnit A t) =
            ValuationSubring.residueOfUnit A s :=
          (eq_neg_of_add_eq_zero_left hzero).symm
        have heq : -ValuationSubring.residueOfUnit A a =
            ValuationSubring.residueOfUnit A s *
              (ValuationSubring.residueOfUnit A t)⁻¹ := by
          calc
            -ValuationSubring.residueOfUnit A a =
                -(ValuationSubring.residueOfUnit A a *
                  ValuationSubring.residueOfUnit A t) *
                    (ValuationSubring.residueOfUnit A t)⁻¹ := by
                      field_simp
            _ = ValuationSubring.residueOfUnit A s *
                (ValuationSubring.residueOfUnit A t)⁻¹ := by rw [hst]
        rw [heq]
        exact hprod
      have hnegT : (((negUnit A a : A.unitGroup) : Fˣ) : F) ∈ T :=
        (unit_mem_iff_residue_mem A T hT hcompat (negUnit A a)).mpr (by
          rw [residue_negUnit]
          exact hnegbar)
      rw [coe_negUnit] at hnegT
      exact hnega hnegT
    have hxres0 : IsLocalRing.residue A (unitLinearCombination A s a t) ≠ 0 := by
      rw [residue_unitLinearCombination]
      exact hsumbar0
    obtain ⟨c, hc, hcres⟩ :=
      exists_unitGroup_of_residue_ne_zero A (unitLinearCombination A s a t) hxres0
    rw [coe_unitLinearCombination] at hc
    have hcres' : ValuationSubring.residueOfUnit A c =
        ValuationSubring.residueOfUnit A s +
          ValuationSubring.residueOfUnit A a *
            ValuationSubring.residueOfUnit A t := by
      rw [hcres, residue_unitLinearCombination]
    have hsum := haRigid (Set.add_mem_add hs (Set.smul_mem_smul_set ht))
    change ((s : Fˣ) : F) + ((a : Fˣ) : F) * ((t : Fˣ) : F) ∈
      T ∪ ((a : Fˣ) : F) • T at hsum
    rcases hsum with hsum | ⟨q, hq, hqa⟩
    · left
      rw [← hcres']
      apply (unit_mem_iff_residue_mem A T hT hcompat c).mp
      rw [hc]
      exact hsum
    · change ((a : Fˣ) : F) * q =
        ((s : Fˣ) : F) + ((a : Fˣ) : F) * ((t : Fˣ) : F) at hqa
      have hqval : A.valuation q = 1 := by
        have hval : A.valuation (((a : Fˣ) : F) * q) = 1 := by
          rw [hqa, ← hc]
          exact c.property
        rw [A.valuation.map_mul] at hval
        have hava : A.valuation ((a : Fˣ) : F) = 1 := a.property
        rw [hava, one_mul] at hval
        exact hval
      obtain ⟨v, hv⟩ := exists_unitGroup_of_valuation_eq_one A hqval
      right
      refine ⟨ValuationSubring.residueOfUnit A v,
        (unit_mem_iff_residue_mem A T hT hcompat v).mp (by rw [hv]; exact hq), ?_⟩
      simp only [smul_eq_mul]
      have hcv : c = a * v := by
        apply Subtype.ext
        apply Units.ext
        change ((c : Fˣ) : F) = ((a : Fˣ) : F) * ((v : Fˣ) : F)
        rw [hc, hv]
        exact hqa.symm
      calc
        ValuationSubring.residueOfUnit A a *
            ValuationSubring.residueOfUnit A v =
          ValuationSubring.residueOfUnit A (a * v) := by
            simp [ValuationSubring.residueOfUnit]
        _ = ValuationSubring.residueOfUnit A c := by rw [hcv]
        _ = ValuationSubring.residueOfUnit A s +
            ValuationSubring.residueOfUnit A a *
              ValuationSubring.residueOfUnit A t := hcres'
  · intro hresRigid
    rintro z ⟨s, hs, y, ⟨t, ht, rfl⟩, rfl⟩
    change s + ((a : Fˣ) : F) * t ∈ T ∪ ((a : Fˣ) : F) • T
    have hs0 : s ≠ 0 := fun hzero => hT.zero_notMem (hzero ▸ hs)
    have ht0 : t ≠ 0 := fun hzero => hT.zero_notMem (hzero ▸ ht)
    have hat0 : ((a : Fˣ) : F) * t ≠ 0 :=
      mul_ne_zero (Units.ne_zero (a : Fˣ)) ht0
    by_cases heq : A.valuation s = A.valuation (((a : Fˣ) : F) * t)
    · have hava : A.valuation ((a : Fˣ) : F) = 1 := a.property
      have hst : A.valuation s = A.valuation t := by
        calc
          A.valuation s = A.valuation (((a : Fˣ) : F) * t) := heq
          _ = A.valuation ((a : Fˣ) : F) * A.valuation t :=
            A.valuation.map_mul _ _
          _ = A.valuation t := by rw [hava, one_mul]
      have hqval : A.valuation (t / s) = 1 := by
        rw [A.valuation.map_div, hst]
        exact div_self (A.valuation.ne_zero_iff.mpr ht0)
      obtain ⟨q, hq⟩ := exists_unitGroup_of_valuation_eq_one A hqval
      have hqT : ((q : Fˣ) : F) ∈ T := by
        rw [hq]
        simpa [div_eq_mul_inv] using hT.mul_mem ht (hT.inv_mem hs)
      have hnorm := unit_sum_mem_of_residue_rigid A T hT hcompat
        a (1 : A.unitGroup) q (by simpa using hT.one_mem) hqT hresRigid
      change 1 + ((a : Fˣ) : F) * ((q : Fˣ) : F) ∈
        T ∪ ((a : Fˣ) : F) • T at hnorm
      rw [hq] at hnorm
      rcases hnorm with hnorm | ⟨d, hd, hda⟩
      · left
        have hprod := hT.mul_mem hs hnorm
        convert hprod using 1 <;> field_simp <;> ring
      · right
        refine ⟨s * d, hT.mul_mem hs hd, ?_⟩
        simp only [smul_eq_mul] at hda ⊢
        calc
          ((a : Fˣ) : F) * (s * d) = s * (((a : Fˣ) : F) * d) := by ring
          _ = s * (1 + ((a : Fˣ) : F) * (t / s)) := by rw [hda]
          _ = s + ((a : Fˣ) : F) * t := by field_simp
    · rcases lt_or_gt_of_ne heq with hlt | hgt
      · right
        refine ⟨t * (1 + s / (((a : Fˣ) : F) * t)), hT.mul_mem ht ?_, ?_⟩
        · apply one_add_mem_of_valuation_lt A T hcompat
          rw [A.valuation.map_div]
          exact (div_lt_one₀ (a := A.valuation s)
            (b := A.valuation (((a : Fˣ) : F) * t))
            (A.valuation.pos_iff.mpr hat0)).mpr hlt
        · simp only [smul_eq_mul]
          field_simp
          <;> ring
      · left
        have hm := hT.mul_mem hs
          (one_add_mem_of_valuation_lt A T hcompat
            (x := (((a : Fˣ) : F) * t) / s) (by
              rw [A.valuation.map_div]
              exact (div_lt_one₀
                (a := A.valuation (((a : Fˣ) : F) * t))
                (b := A.valuation s) (A.valuation.pos_iff.mpr hs0)).mpr hgt))
        convert hm using 1 <;> field_simp <;> ring

/-- AEJ, Proposition 1.9(1), journal p. 452: for a `T`-compatible valuation,
`B_F(T) ⊆ U_A · T`. -/
theorem proposition_1_9_part1 (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T) :
    basicPart T ⊆ ValuationSubring.unitCarrier A * T := by
  rintro b ⟨hb_ne, hb⟩
  by_contra hb_out
  apply hb
  constructor
  · exact proposition_1_5_part1 A T hT hcompat hb_ne hb_out
  · apply proposition_1_5_part1 A T hT hcompat (neg_ne_zero.mpr hb_ne)
    intro hneg
    rcases hneg with ⟨u, ⟨u', hu', hu'_eq⟩, t, ht, hut⟩
    apply hb_out
    refine ⟨-u, ?_, t, ht, ?_⟩
    · refine ⟨(-1 : Fˣ) * u', ?_, ?_⟩
      · apply A.unitGroup.mul_mem _ hu'
        rw [A.mem_unitGroup_iff]
        simp
      · simpa [hu'_eq]
    · change u * t = -b at hut
      calc
        (-u) * t = -(u * t) := by ring
        _ = b := by rw [hut]; simp

/-- AEJ, Proposition 1.9(2), journal p. 452, in a quotient-free
representative formulation.  The first conjunct says every representative of
a class in `B_F(T)/T` maps to a basic residue class; the second says every
basic residue class is attained.  Together they say that the canonical
isomorphism `U_A·T/T → F̄_Aˣ/T̄` maps `B_F(T)/T` onto
`B_F̄_A(T̄)/T̄`. -/
theorem proposition_1_9_part2 (A : ValuationSubring F) (T : Set F)
    (hT : IsMulSubgroup T) (hcompat : ValuationSubring.IsCompatible A T) :
    (∀ b ∈ basicPart T, ∀ (u : A.unitGroup) (t : F), t ∈ T →
        b = ((u : Fˣ) : F) * t →
          ValuationSubring.residueOfUnit A u ∈
            basicPart (ValuationSubring.residueImage A T)) ∧
    (∀ r ∈ basicPart (ValuationSubring.residueImage A T),
      ∃ u : A.unitGroup, ValuationSubring.residueOfUnit A u = r ∧
        ∃ t ∈ T, ((u : Fˣ) : F) * t ∈ basicPart T) := by
  constructor
  · rintro b ⟨hb0, hb⟩ u t ht rfl
    refine ⟨Units.ne_zero (A.unitGroupToResidueFieldUnits u), ?_⟩
    intro hr
    apply hb
    constructor
    · apply rigid_mul_right T hT ht
      exact (proposition_1_5_part2 A T hT hcompat u).mpr hr.1
    · have hn := rigid_mul_right T hT ht
        ((proposition_1_5_part2 A T hT hcompat (negUnit A u)).mpr (by
          rw [residue_negUnit]
          exact hr.2))
      rw [coe_negUnit] at hn
      convert hn using 1 <;> ring
  · rintro r ⟨hr0, hr⟩
    obtain ⟨u, hu⟩ := A.surjective_unitGroupToResidueFieldUnits (Units.mk0 r hr0)
    have hures : ValuationSubring.residueOfUnit A u = r := by
      change ((A.unitGroupToResidueFieldUnits u :
        (IsLocalRing.ResidueField A)ˣ) : IsLocalRing.ResidueField A) = r
      rw [hu]
      rfl
    refine ⟨u, hures, 1, hT.one_mem, ?_⟩
    simp only [mul_one]
    refine ⟨Units.ne_zero (u : Fˣ), ?_⟩
    rintro ⟨hu_rigid, hnu_rigid⟩
    apply hr
    constructor
    · rw [← hures]
      exact (proposition_1_5_part2 A T hT hcompat u).mp hu_rigid
    · have hneg : IsRigid T (((negUnit A u : A.unitGroup) : Fˣ) : F) := by
        rw [coe_negUnit]
        exact hnu_rigid
      have hres :=
        (proposition_1_5_part2 A T hT hcompat (negUnit A u)).mp hneg
      rw [residue_negUnit, hures] at hres
      exact hres

end

end NU.AEJ
