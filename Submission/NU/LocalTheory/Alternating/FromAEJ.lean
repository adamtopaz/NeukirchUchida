import Submission.NU.LocalTheory.Alternating.ProjectiveBridge

/-!
# Alternating pairs from Arason–Elman–Jacob

This module is the only alternating-pair file that invokes `NU.AEJ.theorem_3_9`.
It exposes the representation bridge from AEJ's subsets of the ambient field
to the multiplicative quotient used by the projective argument, removes the
index-two ambiguity for odd `ℓ`, and then derives the valuation conclusion.
-/

open scoped Pointwise

namespace NU.LocalTheory

noncomputable section

/-- The subgroup of `Fˣ` generated by the AEJ basic part of the common
kernel.  This is the multiplicative-group object underlying AEJ's set-level
carrier below. -/
def aejGeneratedSubgroup {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) : Subgroup Fˣ :=
  NU.AEJ.mulSubgroupClosure
    (NU.AEJ.basicPart (commonKernelCarrier p q))

/-- The AEJ `Set F` carrier of `aejGeneratedSubgroup`. -/
def aejGeneratedCarrier {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) : Set F :=
  NU.AEJ.mulSubgroupClosureCarrier
    (NU.AEJ.basicPart (commonKernelCarrier p q))

/-- The canonical AEJ valuation attached to the common kernel. -/
def aejValuation {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) : ValuationSubring F :=
  NU.AEJ.OF (commonKernelCarrier p q)
    (commonKernelCarrier_isMulSubgroup p q)

/-- The index-at-most-two enlargement `U_F(T)·T` in AEJ Theorem 3.9. -/
def aejEnlargement {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) : Set F :=
  NU.AEJ.UF (commonKernelCarrier p q)
      (commonKernelCarrier_isMulSubgroup p q) *
    commonKernelCarrier p q

/-- Fundamental representation bridge: membership in AEJ's field-valued
common kernel is exactly vanishing of the ordered character value in the
project's multiplicative quotient. -/
theorem mem_commonKernelCarrier_iff_characterPairValue_eq_zero
    {F : Type*} [Field F] {ℓ : ℕ} (p q : MulCharacter F ℓ) (x : Fˣ) :
    (x : F) ∈ commonKernelCarrier p q ↔
      characterPairValue p q x = 0 := by
  constructor
  · rintro ⟨u, hu, hux⟩
    have heq : u = x := by
      apply Units.ext
      exact hux
    subst u
    exact Prod.ext hu.1 hu.2
  · intro hx
    refine ⟨x, ?_, rfl⟩
    exact Prod.ext_iff.mp hx

private theorem character_kills_neg_one_fromAEJ
    {F : Type*} [Field F] {ℓ : ℕ} (hℓodd : Odd ℓ)
    (p : MulCharacter F ℓ) :
    p (Additive.ofMul (-1 : Fˣ)) = 0 := by
  apply (ZMod.add_self_eq_zero_iff_eq_zero hℓodd).mp
  rw [← p.map_add]
  have hneg : Additive.ofMul (-1 : Fˣ) + Additive.ofMul (-1 : Fˣ) = 0 := by
    ext
    simp
  rw [hneg, p.map_zero]

private theorem characterPairValue_mem_nonrigidQuotientImage_of_not_isRigid
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (p q : MulCharacter F ℓ) (a : Fˣ)
    (haT : (a : F) ∉ commonKernelCarrier p q)
    (ha : ¬NU.AEJ.IsRigid (commonKernelCarrier p q) (a : F)) :
    characterPairValue p q a ∈ nonrigidQuotientImage p q := by
  let T := commonKernelCarrier p q
  have hT := commonKernelCarrier_isMulSubgroup p q
  change ¬(T + (a : F) • T ⊆ T ∪ (a : F) • T) at ha
  obtain ⟨z, hz, hzout⟩ := Set.not_subset.mp ha
  rcases hz with ⟨s, hs, y, ⟨t, ht, rfl⟩, rfl⟩
  rcases hs with ⟨su, hsu, rfl⟩
  rcases ht with ⟨tu, htu, rfl⟩
  have hsuT : (su : F) ∈ T := ⟨su, hsu, rfl⟩
  have htuT : (tu : F) ∈ T := ⟨tu, htu, rfl⟩
  let x : Fˣ := a * tu * su⁻¹
  have hxT : (x : F) ∉ T := by
    intro hx
    apply haT
    have hxst := hT.mul_mem (hT.mul_mem hx hsuT) (hT.inv_mem htuT)
    have heq : (x : F) * (su : F) * (tu : F)⁻¹ = (a : F) := by
      dsimp [x]
      simp only [Units.val_inv_eq_inv_val]
      field_simp
    rw [heq] at hxst
    exact hxst
  have hxsum : 1 + (x : F) ∉ T ∪ (x : F) • T := by
    intro hxmem
    apply hzout
    rcases hxmem with hxmem | hxmem
    · apply Set.mem_union_left
      have hm := hT.mul_mem hsuT hxmem
      have heq : (su : F) * (1 + (x : F)) =
          (su : F) + (a : F) * (tu : F) := by
        dsimp [x]
        simp only [Units.val_inv_eq_inv_val]
        field_simp
      rw [heq] at hm
      exact hm
    · apply Set.mem_union_right
      rcases hxmem with ⟨w, hw, hw_eq⟩
      change (x : F) * w = 1 + (x : F) at hw_eq
      refine ⟨(tu : F) * w, hT.mul_mem htuT hw, ?_⟩
      calc
        (a : F) * ((tu : F) * w) = (su : F) * ((x : F) * w) := by
          dsimp [x]
          simp only [Units.val_inv_eq_inv_val]
          field_simp
        _ = (su : F) * (1 + (x : F)) := by rw [hw_eq]
        _ = (su : F) + (a : F) * (tu : F) := by
          dsimp [x]
          simp only [Units.val_inv_eq_inv_val]
          field_simp
  have hvalue : characterPairValue p q x = characterPairValue p q a := by
    apply Prod.ext
    · change p (Additive.ofMul a + Additive.ofMul tu - Additive.ofMul su) =
        p (Additive.ofMul a)
      rw [map_sub, map_add, htu.1, hsu.1]
      simp
    · change q (Additive.ofMul a + Additive.ofMul tu - Additive.ofMul su) =
        q (Additive.ofMul a)
      rw [map_sub, map_add, htu.2, hsu.2]
      simp
  rw [← hvalue]
  apply Submodule.subset_span
  exact ⟨x, ⟨hxT, hxsum⟩, rfl⟩

/-- AEJ-to-projective bridge for generators: the class of every AEJ basic
field element lands in the span generated by the one-sided nonrigid classes
used by `ProjectiveBridge`.  The use of `Units.mk0` is the explicit passage
from AEJ's `Set F` encoding to `Fˣ/Fˣ^ℓ`. -/
theorem aej_basicPart_class_mem_nonrigidQuotientImage
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓodd : Odd ℓ) (p q : MulCharacter F ℓ) {b : F}
    (hb : b ∈ NU.AEJ.basicPart (commonKernelCarrier p q)) :
    characterPairValue p q (Units.mk0 b hb.1) ∈
      nonrigidQuotientImage p q := by
  let u : Fˣ := Units.mk0 b hb.1
  by_cases hbT : b ∈ commonKernelCarrier p q
  · have huT : (u : F) ∈ commonKernelCarrier p q := by
      simpa [u] using hbT
    rw [(mem_commonKernelCarrier_iff_characterPairValue_eq_zero p q u).mp huT]
    exact Submodule.zero_mem _
  have hnonrigid :
      ¬NU.AEJ.IsRigid (commonKernelCarrier p q) b ∨
        ¬NU.AEJ.IsRigid (commonKernelCarrier p q) (-b) :=
    not_and_or.mp hb.2
  rcases hnonrigid with hnonrigid | hnonrigid
  · apply characterPairValue_mem_nonrigidQuotientImage_of_not_isRigid p q u
    · simpa [u] using hbT
    · simpa [u] using hnonrigid
  · let v : Fˣ := (-1 : Fˣ) * u
    have hvalue : characterPairValue p q v = characterPairValue p q u := by
      apply Prod.ext
      · change p (Additive.ofMul (-1 : Fˣ) + Additive.ofMul u) =
          p (Additive.ofMul u)
        rw [map_add, character_kills_neg_one_fromAEJ hℓodd p, zero_add]
      · change q (Additive.ofMul (-1 : Fˣ) + Additive.ofMul u) =
          q (Additive.ofMul u)
        rw [map_add, character_kills_neg_one_fromAEJ hℓodd q, zero_add]
    have hvT : (v : F) ∉ commonKernelCarrier p q := by
      intro hv
      have hvzero :=
        (mem_commonKernelCarrier_iff_characterPairValue_eq_zero p q v).mp hv
      rw [hvalue] at hvzero
      have huT :=
        (mem_commonKernelCarrier_iff_characterPairValue_eq_zero p q u).mpr hvzero
      apply hbT
      simpa [u] using huT
    have hv := characterPairValue_mem_nonrigidQuotientImage_of_not_isRigid
      p q v hvT (by simpa [v, u] using hnonrigid)
    rw [hvalue] at hv
    exact hv

/-- AEJ's basic-part closure contains the original common kernel.  This is
the set-level inclusion needed to compare `⟨B_F(T)⟩/T` with the project's
multiplicative quotient. -/
theorem commonKernelCarrier_subset_aejGeneratedCarrier
    {F : Type*} [Field F] {ℓ : ℕ} (p q : MulCharacter F ℓ) :
    commonKernelCarrier p q ⊆ aejGeneratedCarrier p q := by
  intro x hx
  have hT := commonKernelCarrier_isMulSubgroup p q
  have hx0 : x ≠ 0 := fun hzero => hT.zero_notMem (hzero ▸ hx)
  have hbasic : x ∈ NU.AEJ.basicPart (commonKernelCarrier p q) := by
    refine ⟨hx0, ?_⟩
    rintro ⟨-, hnegRigid⟩
    have hzeroSum : (0 : F) ∈
        commonKernelCarrier p q + (-x) • commonKernelCarrier p q := by
      refine ⟨x, hx, -x, ?_, by simp⟩
      exact ⟨1, hT.one_mem, by simp⟩
    have hzeroUnion := hnegRigid hzeroSum
    rcases hzeroUnion with hzero | hzero
    · exact hT.zero_notMem hzero
    · rcases hzero with ⟨y, hy, hyzero⟩
      change (-x) * y = 0 at hyzero
      have hy0 : y = 0 := (mul_eq_zero.mp hyzero).resolve_left (neg_ne_zero.mpr hx0)
      exact hT.zero_notMem (hy0 ▸ hy)
  refine ⟨Units.mk0 x hx0, ?_, rfl⟩
  apply Subgroup.subset_closure
  exact hbasic

/-- Every `ℓ`-th power lies in the AEJ generated carrier.  Together with the
previous lemma this makes the exponent-`ℓ` quotient used to eliminate AEJ's
index-two enlargement explicit. -/
theorem pow_mem_aejGeneratedCarrier
    {F : Type*} [Field F] {ℓ : ℕ} (p q : MulCharacter F ℓ) (x : Fˣ) :
    (x : F) ^ ℓ ∈ aejGeneratedCarrier p q := by
  apply commonKernelCarrier_subset_aejGeneratedCarrier p q
  refine ⟨x ^ ℓ, ?_, by simp⟩
  constructor
  · change p (ℓ • Additive.ofMul x) = 0
    rw [map_nsmul]
    simp
  · change q (ℓ • Additive.ofMul x) = 0
    rw [map_nsmul]
    simp

/-- The generated carrier really is an AEJ multiplicative subgroup. -/
theorem aejGeneratedCarrier_isMulSubgroup
    {F : Type*} [Field F] {ℓ : ℕ} (p q : MulCharacter F ℓ) :
    NU.AEJ.IsMulSubgroup (aejGeneratedCarrier p q) := by
  change NU.AEJ.IsMulSubgroup
    ((fun u : Fˣ => (u : F)) '' (aejGeneratedSubgroup p q : Set Fˣ))
  constructor
  · exact ⟨1, Subgroup.one_mem _, by simp⟩
  · rintro x y ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
    exact ⟨u * v, Subgroup.mul_mem _ hu hv, by simp⟩
  · rintro x ⟨u, hu, rfl⟩
    exact ⟨u⁻¹, Subgroup.inv_mem _ hu, by simp⟩
  · rintro ⟨u, -, hzero⟩
    exact Units.ne_zero u hzero

private theorem unitCarrier_isMulSubgroup_fromAEJ
    {F : Type*} [Field F] (A : ValuationSubring F) :
    NU.AEJ.IsMulSubgroup (NU.AEJ.ValuationSubring.unitCarrier A) := by
  constructor
  · exact ⟨1, Subgroup.one_mem _, by simp⟩
  · rintro x y ⟨u, hu, rfl⟩ ⟨v, hv, rfl⟩
    exact ⟨u * v, Subgroup.mul_mem _ hu hv, by simp⟩
  · rintro x ⟨u, hu, rfl⟩
    exact ⟨u⁻¹, Subgroup.inv_mem _ hu, by simp⟩
  · rintro ⟨u, -, hzero⟩
    exact Units.ne_zero u hzero

private theorem set_mul_isMulSubgroup_fromAEJ
    {F : Type*} [Field F] (G K : Set F)
    (hG : NU.AEJ.IsMulSubgroup G) (hK : NU.AEJ.IsMulSubgroup K) :
    NU.AEJ.IsMulSubgroup (G * K) := by
  constructor
  · exact ⟨1, hG.one_mem, 1, hK.one_mem, by simp⟩
  · rintro x y ⟨g, hg, k, hk, rfl⟩ ⟨g', hg', k', hk', rfl⟩
    exact ⟨g * g', hG.mul_mem hg hg', k * k', hK.mul_mem hk hk', by ring⟩
  · rintro x ⟨g, hg, k, hk, rfl⟩
    exact ⟨g⁻¹, hG.inv_mem hg, k⁻¹, hK.inv_mem hk, by simp [mul_comm]⟩
  · rintro ⟨g, hg, k, hk, hzero⟩
    exact mul_ne_zero (fun hg0 => hG.zero_notMem (hg0 ▸ hg))
      (fun hk0 => hK.zero_notMem (hk0 ▸ hk)) hzero

/-- The AEJ enlargement is a multiplicative subgroup in the same set-level
encoding. -/
theorem aejEnlargement_isMulSubgroup
    {F : Type*} [Field F] {ℓ : ℕ} (p q : MulCharacter F ℓ) :
    NU.AEJ.IsMulSubgroup (aejEnlargement p q) := by
  apply set_mul_isMulSubgroup_fromAEJ
  · exact unitCarrier_isMulSubgroup_fromAEJ (aejValuation p q)
  · exact commonKernelCarrier_isMulSubgroup p q

/-- Characters in `⟨p,q⟩` that annihilate AEJ's generated subgroup. -/
def aejPairAnnihilator {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) :
    Submodule (ZMod ℓ) (pairSpan (k := ZMod ℓ) p q) :=
  (annihilator ℓ (aejGeneratedSubgroup p q)).comap
    (pairSpan (k := ZMod ℓ) p q).subtype

private def pairCoefficientMap {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) :
    (ZMod ℓ × ZMod ℓ) →ₗ[ZMod ℓ] (pairSpan (k := ZMod ℓ) p q) := by
  let f : (ZMod ℓ × ZMod ℓ) →ₗ[ZMod ℓ] MulCharacter F ℓ :=
    (LinearMap.toSpanSingleton (ZMod ℓ) (MulCharacter F ℓ) p).coprod
      (LinearMap.toSpanSingleton (ZMod ℓ) (MulCharacter F ℓ) q)
  exact f.codRestrict (pairSpan p q) (by
    rintro ⟨a, b⟩
    change a • p + b • q ∈ pairSpan p q
    exact Submodule.add_mem _
      (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))
      (Submodule.smul_mem _ _ (Submodule.subset_span (by simp))))

@[simp]
private theorem pairCoefficientMap_apply {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) (c : ZMod ℓ × ZMod ℓ) :
    ((pairCoefficientMap p q c : pairSpan p q) : MulCharacter F ℓ) =
      c.1 • p + c.2 • q := by
  rfl

private theorem pairCoefficientMap_surjective
    {F : Type*} [Field F] {ℓ : ℕ} (p q : MulCharacter F ℓ) :
    Function.Surjective (pairCoefficientMap p q) := by
  let f : (ZMod ℓ × ZMod ℓ) →ₗ[ZMod ℓ] MulCharacter F ℓ :=
    (LinearMap.toSpanSingleton (ZMod ℓ) (MulCharacter F ℓ) p).coprod
      (LinearMap.toSpanSingleton (ZMod ℓ) (MulCharacter F ℓ) q)
  have hrange : LinearMap.range f = pairSpan p q := by
    rw [LinearMap.range_coprod, LinearMap.range_toSpanSingleton,
      LinearMap.range_toSpanSingleton, ← Submodule.span_union]
    congr 1
  rintro ⟨w, hw⟩
  have hwrange : w ∈ LinearMap.range f := by
    rw [hrange]
    exact hw
  rcases hwrange with ⟨c, hc⟩
  refine ⟨c, ?_⟩
  apply Subtype.ext
  change f c = w
  exact hc

private def coefficientPairing {k : Type*} [Field k]
    (E : Submodule k (k × k)) :
    (k × k) →ₗ[k] Module.Dual k E :=
  LinearMap.mk₂ k (fun c z => c.1 * z.1.1 + c.2 * z.1.2)
    (by intros; simp; ring)
    (by intros; simp; ring)
    (by intros; simp; ring)
    (by intros; simp; ring)

@[simp]
private theorem coefficientPairing_apply {k : Type*} [Field k]
    (E : Submodule k (k × k)) (c : k × k) (z : E) :
    coefficientPairing E c z = c.1 * z.1.1 + c.2 * z.1.2 :=
  rfl

/-- Linear-algebra representation bridge: the codimension of the
annihilator of AEJ's generated carrier is controlled by the rank of the
one-sided-nonrigid quotient image bounded in `ProjectiveBridge`. -/
theorem finrank_aejPairAnnihilator_quotient_le_nonrigidQuotientImage
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓodd : Odd ℓ) (p q : MulCharacter F ℓ) :
    Module.finrank (ZMod ℓ)
        ((pairSpan (k := ZMod ℓ) p q) ⧸ aejPairAnnihilator p q) ≤
      Module.finrank (ZMod ℓ) (nonrigidQuotientImage p q) := by
  let W := pairSpan (k := ZMod ℓ) p q
  let E := nonrigidQuotientImage p q
  let C := pairCoefficientMap p q
  have hC : LinearMap.range C = ⊤ :=
    LinearMap.range_eq_top.mpr (pairCoefficientMap_surjective p q)
  obtain ⟨s, hs⟩ := C.exists_rightInverse_of_surjective hC
  let Φ : W →ₗ[ZMod ℓ] Module.Dual (ZMod ℓ) E :=
    (coefficientPairing E).comp s
  have hs_apply (w : W) : C (s w) = w := by
    have hw := LinearMap.congr_fun hs w
    simpa using hw
  have hw_coefficients (w : W) :
      (w : MulCharacter F ℓ) =
        (s w).1 • p + (s w).2 • q := by
    have hw := congrArg Subtype.val (hs_apply w)
    simpa [C] using hw.symm
  have hker : LinearMap.ker Φ = aejPairAnnihilator p q := by
    ext w
    constructor
    · intro hw
      rw [LinearMap.mem_ker] at hw
      change ∀ x : Fˣ, x ∈ aejGeneratedSubgroup p q →
        (w : MulCharacter F ℓ) (Additive.ofMul x) = 0
      intro x hx
      refine Subgroup.closure_induction
        (p := fun x _ =>
          (w : MulCharacter F ℓ) (Additive.ofMul x) = 0) ?_ ?_ ?_ ?_ hx
      · intro u hu
        have huE : characterPairValue p q u ∈ E := by
          simpa only [show Units.mk0 (u : F) hu.1 = u by
            apply Units.ext
            rfl] using
            (aej_basicPart_class_mem_nonrigidQuotientImage hℓodd p q hu)
        let z : E := ⟨characterPairValue p q u, huE⟩
        have hzfun := congrArg (fun f : Module.Dual (ZMod ℓ) E => f z) hw
        have hz : (s w).1 * p (Additive.ofMul u) +
            (s w).2 * q (Additive.ofMul u) = 0 := by
          simpa [Φ, z, E, characterPairValue] using hzfun
        rw [hw_coefficients]
        exact hz
      · simp
      · intro x y hx hy hxzero hyzero
        change (w : MulCharacter F ℓ)
          (Additive.ofMul x + Additive.ofMul y) = 0
        rw [map_add, hxzero, hyzero, add_zero]
      · intro x hx hxzero
        change (w : MulCharacter F ℓ) (-Additive.ofMul x) = 0
        rw [map_neg, hxzero, neg_zero]
    · intro hw
      rw [LinearMap.mem_ker]
      apply LinearMap.ext
      intro z
      change (s w).1 * z.1.1 + (s w).2 * z.1.2 = 0
      have hzero_on_E : ∀ v : ZMod ℓ × ZMod ℓ, v ∈ E →
          (s w).1 * v.1 + (s w).2 * v.2 = 0 := by
        intro v hv
        change v ∈ Submodule.span (ZMod ℓ)
          {z | ∃ x : Fˣ,
            IsTNonrigid (commonKernelCarrier p q) x ∧
              z = characterPairValue p q x} at hv
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
        · intro v hv
          rcases hv with ⟨x, hx, rfl⟩
          have hbasic : (x : F) ∈
              NU.AEJ.basicPart (commonKernelCarrier p q) := by
            refine ⟨Units.ne_zero x, ?_⟩
            rintro ⟨hxrigid, -⟩
            apply hx.2
            apply hxrigid
            refine ⟨1, (commonKernelCarrier_isMulSubgroup p q).one_mem,
              (x : F), ?_, by simp⟩
            exact ⟨1, (commonKernelCarrier_isMulSubgroup p q).one_mem, by simp⟩
          have hwx : (w : MulCharacter F ℓ) (Additive.ofMul x) = 0 :=
            hw x (Subgroup.subset_closure hbasic)
          rw [hw_coefficients] at hwx
          exact hwx
        · simp
        · intro x y hx hy hxzero hyzero
          simp only [Prod.fst_add, Prod.snd_add]
          linear_combination hxzero + hyzero
        · intro a x hx hxzero
          simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul]
          linear_combination a * hxzero
      exact hzero_on_E z z.2
  calc
    Module.finrank (ZMod ℓ) (W ⧸ aejPairAnnihilator p q) =
        Module.finrank (ZMod ℓ) (W ⧸ LinearMap.ker Φ) := by rw [hker]
    _ = Module.finrank (ZMod ℓ) (LinearMap.range Φ) :=
      Φ.quotKerEquivRange.finrank_eq
    _ ≤ Module.finrank (ZMod ℓ) (Module.Dual (ZMod ℓ) E) :=
      Submodule.finrank_le _
    _ = Module.finrank (ZMod ℓ) E := Subspace.dual_finrank_eq

/-- If all valuation units lie in the AEJ carrier, its annihilator lies in
the unit annihilator.  Hence the preceding quotient rank bounds the relative
codimension used in `SatisfiesValuationConclusion`. -/
theorem relativeCodim_localI_le_aejPairAnnihilator
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (A : ValuationSubring F) (p q : MulCharacter F ℓ)
    (hunit : NU.AEJ.ValuationSubring.unitCarrier A ⊆
      aejGeneratedCarrier p q) :
    relativeCodim (pairSpan (k := ZMod ℓ) p q) (localI ℓ A) ≤
      Module.finrank (ZMod ℓ)
        ((pairSpan (k := ZMod ℓ) p q) ⧸ aejPairAnnihilator p q) := by
  let W := pairSpan (k := ZMod ℓ) p q
  let N : Submodule (ZMod ℓ) W := aejPairAnnihilator p q
  let M : Submodule (ZMod ℓ) W := Submodule.comap W.subtype (localI ℓ A)
  change Module.finrank (ZMod ℓ) (W ⧸ M) ≤
    Module.finrank (ZMod ℓ) (W ⧸ N)
  have hNM : N ≤ M := by
    intro r hr
    change ∀ u : Fˣ, u ∈ A.unitGroup →
      (r : MulCharacter F ℓ) (Additive.ofMul u) = 0
    intro u hu
    apply hr
    have hugen := hunit ⟨u, hu, rfl⟩
    rcases hugen with ⟨v, hv, hvu⟩
    change v ∈ aejGeneratedSubgroup p q at hv
    have heq : v = u := by
      apply Units.ext
      exact hvu
    rw [heq] at hv
    exact hv
  letI : Module.Finite (ZMod ℓ) W :=
    Module.Finite.span_of_finite (ZMod ℓ) (by simp)
  have hdim : Module.finrank (ZMod ℓ) N ≤ Module.finrank (ZMod ℓ) M :=
    Submodule.finrank_mono hNM
  have hsumN := N.finrank_quotient_add_finrank
  have hsumM := M.finrank_quotient_add_finrank
  omega

/-- Translation of principal-unit compatibility from AEJ's `Set F`
interface to containment of the project's character plane in `localD`. -/
theorem pairSpan_le_localD_of_principalUnitCarrier_subset
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (A : ValuationSubring F) (p q : MulCharacter F ℓ)
    (hprincipal : NU.AEJ.ValuationSubring.principalUnitCarrier A ⊆
      commonKernelCarrier p q) :
    pairSpan (k := ZMod ℓ) p q ≤ localD ℓ A := by
  have hpD : p ∈ localD ℓ A := by
    intro u hu
    have huT := hprincipal ⟨u, hu, rfl⟩
    have hzero :=
      (mem_commonKernelCarrier_iff_characterPairValue_eq_zero p q u).mp huT
    exact (Prod.ext_iff.mp hzero).1
  have hqD : q ∈ localD ℓ A := by
    intro u hu
    have huT := hprincipal ⟨u, hu, rfl⟩
    have hzero :=
      (mem_commonKernelCarrier_iff_characterPairValue_eq_zero p q u).mp huT
    exact (Prod.ext_iff.mp hzero).2
  rw [pairSpan, Submodule.span_le]
  intro r hr
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with hp | hq
  · change r ∈ localD ℓ A
    rw [hp]
    exact hpD
  · change r ∈ localD ℓ A
    rw [hq]
    exact hqD

/-- Blueprint (3.11), obtained directly from `NU.AEJ.theorem_3_9` for the
common kernel.  The four conjuncts are respectively `H ⊆ H̃`, index at most
two, principal-unit compatibility, and `U_v ⊆ H̃`. -/
theorem aej_output_for_commonKernel {F : Type*} [Field F] {ℓ : ℕ}
    (p q : MulCharacter F ℓ) :
    aejGeneratedCarrier p q ⊆ aejEnlargement p q ∧
      NU.AEJ.HasIndexAtMostTwo (aejEnlargement p q)
        (aejGeneratedCarrier p q) ∧
      NU.AEJ.ValuationSubring.principalUnitCarrier (aejValuation p q) ⊆
        commonKernelCarrier p q ∧
      NU.AEJ.ValuationSubring.unitCarrier (aejValuation p q) ⊆
        aejEnlargement p q := by
  let T := commonKernelCarrier p q
  have hT := commonKernelCarrier_isMulSubgroup p q
  have h39 := NU.AEJ.theorem_3_9 T hT
  refine ⟨?_, ?_, ?_, ?_⟩
  · simpa [aejGeneratedCarrier, aejEnlargement, T] using h39.1
  · simpa [aejGeneratedCarrier, aejEnlargement, T] using h39.2.1
  · change NU.AEJ.ValuationSubring.IsCompatible (aejValuation p q) T
    simpa [aejValuation, T] using NU.AEJ.OF_isCompatible T hT
  · intro x hx
    change x ∈ NU.AEJ.UF T hT * T
    refine ⟨x, ?_, 1, hT.one_mem, mul_one x⟩
    simpa [NU.AEJ.UF, aejValuation, T] using hx

/-- Odd-primary index-two elimination used after AEJ.  The last hypothesis
says that the quotient `H̃/H` has exponent dividing the odd prime `ℓ`; hence
a quotient of cardinality at most two must be trivial. -/
theorem eq_of_hasIndexAtMostTwo_of_oddExponent {F : Type*} [Field F]
    {ℓ : ℕ} [Fact ℓ.Prime] (hℓodd : Odd ℓ) (H Htilde : Set F)
    (hH : NU.AEJ.IsMulSubgroup H)
    (hHtilde : NU.AEJ.IsMulSubgroup Htilde)
    (hindex : NU.AEJ.HasIndexAtMostTwo Htilde H)
    (hexponent : ∀ x ∈ Htilde, x ^ ℓ ∈ H) :
    Htilde = H := by
  rcases hindex with ⟨hsub, a, hcover⟩
  apply Set.Subset.antisymm ?_ hsub
  intro x hx
  by_cases hxH : x ∈ H
  · exact hxH
  have hx0 : x ≠ 0 := fun hzero => hHtilde.zero_notMem (hzero ▸ hx)
  have hxcoset : x ∈ a • H := (hcover hx).resolve_left hxH
  have hxinv : x⁻¹ ∈ Htilde := hHtilde.inv_mem hx
  have hxinv_notH : x⁻¹ ∉ H := by
    intro hinv
    apply hxH
    simpa using hH.inv_mem hinv
  have hxinv_coset : x⁻¹ ∈ a • H :=
    (hcover hxinv).resolve_left hxinv_notH
  rw [Set.mem_smul_set] at hxcoset hxinv_coset
  rcases hxcoset with ⟨h, hh, hah⟩
  rcases hxinv_coset with ⟨k, hk, hak⟩
  change a * h = x at hah
  change a * k = x⁻¹ at hak
  have hh0 : h ≠ 0 := fun hzero => hH.zero_notMem (hzero ▸ hh)
  have hk0 : k ≠ 0 := fun hzero => hH.zero_notMem (hzero ▸ hk)
  have ha0 : a ≠ 0 := by
    intro ha
    apply hx0
    rw [← hah, ha, zero_mul]
  have hx_first : x = a * h := hah.symm
  have hx_second : x = a⁻¹ * k⁻¹ := by
    calc
      x = (x⁻¹)⁻¹ := by simp
      _ = (a * k)⁻¹ := by rw [hak]
      _ = a⁻¹ * k⁻¹ := by simp [mul_comm]
  have hx2eq : x ^ 2 = h * k⁻¹ := by
    rw [pow_two]
    calc
      x * x = (a * h) * (a⁻¹ * k⁻¹) :=
        congrArg₂ (fun y z : F => y * z) hx_first hx_second
      _ = h * k⁻¹ := by
        field_simp
  have hx2H : x ^ 2 ∈ H := by
    rw [hx2eq]
    exact hH.mul_mem hh (hH.inv_mem hk)
  have hpow_mem {y : F} (hy : y ∈ H) : ∀ n : ℕ, y ^ n ∈ H := by
    intro n
    induction n with
    | zero => simpa using hH.one_mem
    | succ n ih => simpa [pow_succ] using hH.mul_mem ih hy
  obtain ⟨m, hm⟩ := hℓodd
  have hxpow := hexponent x hx
  rw [hm] at hxpow
  have hx2mpow : (x ^ 2) ^ m ∈ H := hpow_mem hx2H m
  have hprod := hH.mul_mem hxpow (hH.inv_mem hx2mpow)
  have hpowe : x ^ (2 * m + 1) = (x ^ 2) ^ m * x := by
    rw [pow_add, pow_mul, pow_one]
  rw [hpowe] at hprod
  simpa [mul_assoc, mul_comm, mul_left_comm, hx0] using hprod

/-- For the common kernel, AEJ's index-two enlargement is exactly its
basic-part generated carrier at an odd prime.  This theorem explicitly
combines Theorem 3.9 with the power bridge above. -/
theorem aejEnlargement_eq_generatedCarrier
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓodd : Odd ℓ) (p q : MulCharacter F ℓ) :
    aejEnlargement p q = aejGeneratedCarrier p q := by
  apply eq_of_hasIndexAtMostTwo_of_oddExponent hℓodd
    (aejGeneratedCarrier p q) (aejEnlargement p q)
    (aejGeneratedCarrier_isMulSubgroup p q)
    (aejEnlargement_isMulSubgroup p q)
    (aej_output_for_commonKernel p q).2.1
  intro x hx
  have hx0 : x ≠ 0 := by
    intro hzero
    exact (aejEnlargement_isMulSubgroup p q).zero_notMem (hzero ▸ hx)
  simpa using pow_mem_aejGeneratedCarrier p q (Units.mk0 x hx0)

/-- The projective rank bound, now passed through all explicit AEJ
representation bridges, gives the unit-annihilator codimension statement. -/
theorem codim_unitAnnihilator_le_one_of_projectiveBridge
    {F : Type*} [Field F] {ℓ : ℕ} [Fact ℓ.Prime]
    (hℓodd : Odd ℓ) (p q : MulCharacter F ℓ)
    (halt : AlternatingPair ℓ p q) :
    relativeCodim (pairSpan (k := ZMod ℓ) p q)
      (localI ℓ (aejValuation p q)) ≤ 1 := by
  have houtput := aej_output_for_commonKernel p q
  have heq := aejEnlargement_eq_generatedCarrier hℓodd p q
  have hunit : NU.AEJ.ValuationSubring.unitCarrier (aejValuation p q) ⊆
      aejGeneratedCarrier p q := by
    intro x hx
    rw [← heq]
    exact houtput.2.2.2 hx
  exact (relativeCodim_localI_le_aejPairAnnihilator
      (aejValuation p q) p q hunit).trans
    ((finrank_aejPairAnnihilator_quotient_le_nonrigidQuotientImage
      hℓodd p q).trans
        (finrank_nonrigidQuotient_le_one hℓodd p q halt))

/-- Blueprint Theorem 3.2 (`thm:alternating`), forward direction.  The proof
is visibly the composition of the direct `NU.AEJ.theorem_3_9` output above,
the set/quotient bridge, and the projective rank bound. -/
theorem exists_valuation_of_alternatingPair {F : Type*} [Field F]
    {ℓ : ℕ} [Fact ℓ.Prime] (hℓodd : Odd ℓ)
    (p q : MulCharacter F ℓ) (halt : AlternatingPair ℓ p q) :
    ∃ A : ValuationSubring F, SatisfiesValuationConclusion ℓ A p q := by
  refine ⟨aejValuation p q, ?_,
    codim_unitAnnihilator_le_one_of_projectiveBridge hℓodd p q halt⟩
  exact pairSpan_le_localD_of_principalUnitCarrier_subset
    (aejValuation p q) p q (aej_output_for_commonKernel p q).2.2.1

/-- Blueprint Theorem 3.2 (`thm:alternating`), in the complete interface
used by Kummer theory: `ℓ` is odd prime, the field has characteristic
not `ℓ`, a primitive `ℓ`-th root is supplied, and the pair is independent. -/
theorem alternatingPair_iff_exists_valuation {F : Type*} [Field F]
    {ℓ : ℕ} [Fact ℓ.Prime] (hℓodd : Odd ℓ)
    (hchar : ringChar F ≠ ℓ) (ζ : F) (hζ : IsPrimitiveRoot ζ ℓ)
    (p q : MulCharacter F ℓ)
    (hind : PairIndependent (k := ZMod ℓ) p q) :
    AlternatingPair ℓ p q ↔
      ∃ A : ValuationSubring F, SatisfiesValuationConclusion ℓ A p q := by
  constructor
  · exact exists_valuation_of_alternatingPair hℓodd p q
  · rintro ⟨A, hA⟩
    exact alternatingPair_of_valuation hℓodd A p q hA

end

